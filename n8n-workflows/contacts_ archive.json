    {
      "parameters": {
        "jsCode": "// Goes in \"Build Archive Query\" — keeps your existing owner/admin permission\n// check intact, and adds the archived_by / archived_at / archive_reason\n// columns (requires the ALTER TABLE migration to have been run already).\nconst requester = $input.first().json;\nconst { contactId, reason } = $('Parse Token').first().json;\n\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\n\nconst sqlQuery = `\n  UPDATE contacts\n  SET is_archived = true,\n      archived_by = $1,\n      archived_at = now(),\n      archive_reason = $2\n  WHERE id = $3 AND ($4 = 'admin' OR owner_id = $1)\n  RETURNING id, is_archived, TRIM(CONCAT(first_name, ' ', last_name)) AS full_name;\n`;\nconst queryParams = [requester.id, reason, contactId, requester.role];\n\nreturn [{ json: { sqlQuery, queryParams } }];\n"
      },
