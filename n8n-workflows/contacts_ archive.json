    {
      "parameters": {
        "jsCode": "// RESTORES the actual token-parsing logic that got overwritten — this needs\n// to go back in the \"Parse Token\" node specifically (not \"Build Archive\n// Query\", where my earlier message's snippet was meant to go instead).\nconst headers = $input.first().json.headers || {};\nconst authHeader = headers['authorization'] || headers['Authorization'] || '';\nconst token = authHeader.replace('Bearer ', '').trim();\n\nconst match = token.match(/^token_(\\d+)_(\\d+)$/);\nif (!match) throw new Error('Invalid or missing session token.');\n\nconst requesterId = parseInt(match[1], 10);\n\nconst body = $input.first().json.body || {};\nconst contactId = parseInt(body.contact_id, 10);\nconst reason = (body.reason || '').trim() || null;\n\nif (!Number.isInteger(contactId)) {\n  throw new Error('\"contact_id\" must be an integer.');\n}\n\nreturn [{ json: { requesterId, contactId, reason } }];\n"
      },
      "id": "11394397-6b39-441b-97b5-38bf4b365141",
      "name": "Parse Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name, role, active FROM users WHERE id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $json.requesterId ] }}"
        }
      },
      "id": "ed4f922b-323a-4135-a504-bde3163fc3bf",
      "name": "Look Up Requester",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        448,
        0
      ],
