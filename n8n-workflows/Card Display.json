        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nconst body = $('Webhook: save-card-display').first().json.body || {};\nconst SIZES = ['small', 'medium', 'large', 'xlarge'];\nconst bool = (v, d) => (v === true || v === 'true' ? true : v === false || v === 'false' ? false : d);\nconst settings = {\n  text_size: SIZES.includes(body.text_size) ? body.text_size : 'small',\n  bold_title: bool(body.bold_title, false),\n  show_time: bool(body.show_time, true),\n  show_contact: bool(body.show_contact, true),\n  show_price: bool(body.show_price, true),\n  show_staff: bool(body.show_staff, true),\n  show_commission: bool(body.show_commission, true),\n};\nreturn [{ json: { userId: requester.id, settings: JSON.stringify(settings) } }];"
