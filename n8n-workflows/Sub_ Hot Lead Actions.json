{
  "name": "Sub: Hot Lead Actions",
  "nodes": [
    {
      "parameters": { "inputSource": "passthrough" },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "id": "hla-trigger",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM contacts WHERE id = $1;",
        "options": { "queryReplacement": "={{ [ $json.contact_id ] }}" }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [220, 0],
      "id": "hla-fetch-contact",
      "name": "Fetch Contact",
      "credentials": { "postgres": { "id": "OJlr1rmibAS2w3rj", "name": "myRag" } }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO tags (name) VALUES ('Hot Lead') ON CONFLICT (name) DO UPDATE SET name = EXCLUDED.name RETURNING id, name;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [440, -140],
      "id": "hla-resolve-tag",
      "name": "Resolve Tag: Hot Lead",
      "credentials": { "postgres": { "id": "OJlr1rmibAS2w3rj", "name": "myRag" } }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO taggables (tag_id, entity_type, entity_id) VALUES ($1, 'contact', $2) ON CONFLICT (tag_id, entity_type, entity_id) DO NOTHING;",
        "options": { "queryReplacement": "={{ [ $json.id, $('Fetch Contact').item.json.id ] }}" }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [660, -140],
      "id": "hla-insert-taggable",
      "name": "Insert Taggable: Hot Lead",
      "credentials": { "postgres": { "id": "OJlr1rmibAS2w3rj", "name": "myRag" } }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE contacts SET owner_id = (\n  SELECT u.id FROM users u\n  LEFT JOIN contacts c2 ON c2.owner_id = u.id AND c2.is_archived = false\n  WHERE u.role = 'user' AND u.active = true\n  GROUP BY u.id\n  ORDER BY COUNT(c2.id) ASC, u.id ASC\n  LIMIT 1\n), updated_at = now()\nWHERE id = $1\nRETURNING owner_id;",
        "options": { "queryReplacement": "={{ [ $('Fetch Contact').item.json.id ] }}" }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [440, 0],
      "id": "hla-assign-owner",
      "name": "Assign Owner (Round Robin)",
      "notes": "Least-loaded among active role='user' reps — self-balancing, no cursor table needed.",
      "notesInFlow": true,
      "credentials": { "postgres": { "id": "OJlr1rmibAS2w3rj", "name": "myRag" } }
    },
    {
      "parameters": {
        "jsCode": "const NOTIFIER_USER_ID = 1; // automation creator (gil bey, admin) — this is a bespoke workflow, not a generic hook target\nconst ownerId = $input.item.json.owner_id;\nconst dmKey = [NOTIFIER_USER_ID, ownerId].sort((a, b) => a - b).join('-');\nreturn [{ json: { notifierUserId: NOTIFIER_USER_ID, ownerId, dmKey } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0],
      "id": "hla-build-dm-key",
      "name": "Build DM Key"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO conversations (type, dm_key, created_by) VALUES ('dm', $1, $2) ON CONFLICT (dm_key) WHERE type = 'dm' DO NOTHING;",
        "options": { "queryReplacement": "={{ [ $json.dmKey, $json.notifierUserId ] }}" }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [880, 0],
      "id": "hla-create-dm",
      "name": "Create DM If Missing",
      "credentials": { "postgres": { "id": "OJlr1rmibAS2w3rj", "name": "myRag" } }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id FROM conversations WHERE type = 'dm' AND dm_key = $1;",
        "options": { "queryReplacement": "={{ [ $('Build DM Key').item.json.dmKey ] }}" }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1100, 0],
      "id": "hla-get-dm-id",
      "name": "Get DM Id",
      "credentials": { "postgres": { "id": "OJlr1rmibAS2w3rj", "name": "myRag" } }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO conversation_members (conversation_id, user_id) VALUES ($1, $2), ($1, $3) ON CONFLICT DO NOTHING;",
        "options": { "queryReplacement": "={{ [ $json.id, $('Build DM Key').item.json.notifierUserId, $('Build DM Key').item.json.ownerId ] }}" }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1320, 0],
      "id": "hla-ensure-members",
      "name": "Ensure DM Members",
      "credentials": { "postgres": { "id": "OJlr1rmibAS2w3rj", "name": "myRag" } }
    },
    {
      "parameters": {
        "jsCode": "const row = $('Fetch Contact').item.json;\nconst name = [row.first_name, row.last_name].filter(Boolean).join(' ') || 'A lead';\nreturn [{ json: { text: `🔥 ${name} just replied and looks hot — assigned to you. Follow up ASAP: ${row.email || row.phone || ''}` } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 0],
      "id": "hla-prepare-dm-text",
      "name": "Prepare DM Text"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO messages (conversation_id, sender_id, body) VALUES ($1, $2, $3);",
        "options": { "queryReplacement": "={{ [ $('Get DM Id').item.json.id, $('Build DM Key').item.json.notifierUserId, $json.text ] }}" }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1760, 0],
      "id": "hla-insert-message",
      "name": "Insert DM Message",
      "credentials": { "postgres": { "id": "OJlr1rmibAS2w3rj", "name": "myRag" } }
    },
    {
      "parameters": {
        "jsCode": "function toTitleCase(s) { return (s || '').toString().toLowerCase().split(' ').map((w) => (w ? w[0].toUpperCase() + w.slice(1) : w)).join(' '); }\nconst row = $('Fetch Contact').item.json;\nconst firstName = toTitleCase(row.first_name) || 'there';\nconst bookingLink = 'https://calendar.app.google/D134zV41DUVuZrxw6';\nconst subject = `Let's book your inspection, ${firstName}!`;\nconst htmlBody = `Hi ${firstName},<br><br>Thanks for getting back to us! Let's get an inspection on the calendar — pick whatever time works best for you here:<br><br><a href=\"${bookingLink}\">${bookingLink}</a><br><br>Talk soon,<br>The Team`;\nreturn [{ json: { to: row.email, subject, htmlBody } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, -280],
      "id": "hla-prepare-email",
      "name": "Prepare Booking Email"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.htmlBody }}",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [1100, -280],
      "id": "hla-send-email",
      "name": "Send Booking Email",
      "credentials": { "gmailOAuth2": { "id": "VKDbMYV2U0WoSc16", "name": "n8n072826" } },
      "onError": "continueRegularOutput"
    }
  ],
  "pinData": {},
  "connections": {
    "When Executed by Another Workflow": { "main": [[{ "node": "Fetch Contact", "type": "main", "index": 0 }]] },
    "Fetch Contact": {
      "main": [
        [
          { "node": "Resolve Tag: Hot Lead", "type": "main", "index": 0 },
          { "node": "Assign Owner (Round Robin)", "type": "main", "index": 0 },
          { "node": "Prepare Booking Email", "type": "main", "index": 0 }
        ]
      ]
    },
    "Resolve Tag: Hot Lead": { "main": [[{ "node": "Insert Taggable: Hot Lead", "type": "main", "index": 0 }]] },
    "Assign Owner (Round Robin)": { "main": [[{ "node": "Build DM Key", "type": "main", "index": 0 }]] },
    "Build DM Key": { "main": [[{ "node": "Create DM If Missing", "type": "main", "index": 0 }]] },
    "Create DM If Missing": { "main": [[{ "node": "Get DM Id", "type": "main", "index": 0 }]] },
    "Get DM Id": { "main": [[{ "node": "Ensure DM Members", "type": "main", "index": 0 }]] },
    "Ensure DM Members": { "main": [[{ "node": "Prepare DM Text", "type": "main", "index": 0 }]] },
    "Prepare DM Text": { "main": [[{ "node": "Insert DM Message", "type": "main", "index": 0 }]] },
    "Prepare Booking Email": { "main": [[{ "node": "Send Booking Email", "type": "main", "index": 0 }]] }
  },
  "active": true,
  "settings": { "executionOrder": "v1" }
}
