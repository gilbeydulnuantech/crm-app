    {
      "parameters": {
        "jsCode": "// Only touch activity_resources if the caller explicitly sent a\n// resource_ids field \u2014 an update that doesn't mention resources shouldn't\n// wipe out the ones already linked.\nconst updated = $json; // { id }\nconst body = $('Webhook: update-event').first().json.body || {};\nconst activityId = parseInt(updated.id, 10);\n\nif (!Number.isInteger(activityId) || !Object.prototype.hasOwnProperty.call(body, 'resource_ids')) {\n  return [{ json: { ...updated, sqlQuery: 'SELECT 1;' } }];\n}\n\nconst resourceIds = (body.resource_ids || [])\n  .map((x) => parseInt(x, 10))\n  .filter((x) => Number.isInteger(x));\n\nconst insertClause = resourceIds.length > 0\n  ? ` INSERT INTO activity_resources (activity_id, resource_id) VALUES ${resourceIds.map((rid) => `(${activityId}, ${rid})`).join(', ')} ON CONFLICT DO NOTHING;`\n  : '';\n\nconst sqlQuery = `DELETE FROM activity_resources WHERE activity_id = ${activityId};${insertClause}`;\n\nreturn [{ json: { ...updated, sqlQuery } }];"
      },
