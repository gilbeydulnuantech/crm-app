        "query": "ALTER TABLE activities ADD COLUMN IF NOT EXISTS end_at TIMESTAMPTZ;\nALTER TABLE activities ADD COLUMN IF NOT EXISTS location VARCHAR(255);\nALTER TABLE activities ADD COLUMN IF NOT EXISTS is_all_day BOOLEAN DEFAULT false;",
