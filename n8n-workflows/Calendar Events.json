    {
      "parameters": {
        "jsCode": "// activity_resources rows are cheap to fully rebuild rather than diff \u2014\n// this is a create, so there's nothing to diff against yet.\nconst inserted = $json; // { id, subject, due_at, created_at }\nconst activityId = parseInt(inserted.id, 10);\nconst resourceIds = ($('Webhook: add-event').first().json.body.resource_ids || [])\n  .map((x) => parseInt(x, 10))\n  .filter((x) => Number.isInteger(x));\n\nconst sqlQuery = resourceIds.length > 0\n  ? `INSERT INTO activity_resources (activity_id, resource_id) VALUES ${resourceIds.map((rid) => `(${activityId}, ${rid})`).join(', ')} ON CONFLICT DO NOTHING;`\n  : 'SELECT 1;';\n\nreturn [{ json: { ...inserted, sqlQuery } }];"
      },
