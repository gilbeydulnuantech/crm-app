    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH resolved AS (\n  SELECT COALESCE(a.contact_id, o.contact_id) AS contact_id,\n         COALESCE(c.account_id, o.account_id) AS account_id\n  FROM activities a\n  LEFT JOIN opportunities o ON o.id = a.opportunity_id\n  LEFT JOIN contacts c ON c.id = COALESCE(a.contact_id, o.contact_id)\n  WHERE a.id = $1\n)\nINSERT INTO entity_activity_log (entity_type, entity_id, category, subtype, summary, detail, actor_id, actor_name)\nSELECT 'contact', r.contact_id, 'system_audit', 'created', COALESCE((SELECT name FROM users WHERE id = $3), 'Someone') || ' created event \"' || $2 || '\"', NULL::jsonb, $3, (SELECT name FROM users WHERE id = $3)\nFROM resolved r WHERE r.contact_id IS NOT NULL\nUNION ALL\nSELECT 'company', r.account_id, 'system_audit', 'created', COALESCE((SELECT name FROM users WHERE id = $3), 'Someone') || ' created event \"' || $2 || '\"', NULL::jsonb, $3, (SELECT name FROM users WHERE id = $3)\nFROM resolved r WHERE r.account_id IS NOT NULL;",
        "options": {
          "queryReplacement": "={{ [ $json.id, $json.subject, $('Webhook: add-event').first().json.body.requester_id || $('Webhook: add-event').first().json.body.user_id || null ] }}"
        }
