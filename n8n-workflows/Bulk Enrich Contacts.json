      "parameters": {
        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\n\nconst body = $('Webhook: bulk-enrich-contacts').first().json.body || {};\nconst ids = Array.isArray(body.contact_ids) ? body.contact_ids.map((n) => parseInt(n, 10)).filter(Number.isInteger) : [];\nif (ids.length === 0) throw new Error('contact_ids must be a non-empty array.');\nif (ids.length > 25) throw new Error('Enrich at most 25 contacts at once.');\n\nconst authHeader = $('Parse Token').first().json.authHeader;\nreturn [{ json: { contactIds: ids, authHeader, queued: ids.length } }];"
      },
