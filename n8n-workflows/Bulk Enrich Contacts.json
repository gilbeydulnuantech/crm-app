    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\n\nconst body = $('Webhook: bulk-enrich-contacts').first().json.body || {};\nif (!Array.isArray(body.contact_ids)) throw new Error('\"contact_ids\" must be an array of contact ids.');\n// Only whole positive numbers; duplicates are collapsed so one contact is never enriched (and billed) twice.\nconst ids = [...new Set(body.contact_ids.filter((n) => (typeof n === 'number' || (typeof n === 'string' && /^\\d+$/.test(n.trim()))) && Number.isInteger(Number(n)) && Number(n) > 0).map(Number))];\nif (ids.length === 0) throw new Error('\"contact_ids\" must contain at least one valid contact id.');\nif (ids.length > 25) throw new Error('Enrich at most 25 contacts at once.');\n\nreturn [{ json: { contactIds: ids, authHeader: requester.authHeader, queued: ids.length } }];"
      },
