        "jsCode": "const r = $input.first().json;\nif (!r.valid) throw new Error('Invalid session.');\n// The caller's own Authorization header is passed on to each per-contact enrich call, so every contact is\n// still permission-checked as that user.\nconst headers = $('Webhook: bulk-enrich-contacts').first().json.headers || {};\nconst authHeader = headers['authorization'] || headers['Authorization'] || '';\nreturn [{ json: { id: r.userId, role: r.role, name: r.user?.name, active: r.active, authHeader } }];"
