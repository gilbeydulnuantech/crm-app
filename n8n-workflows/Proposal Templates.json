    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO proposal_templates (id, title, content_html, email_subject, email_body, linked_contract_template_id, created_by, created_at, updated_at)\nVALUES (COALESCE($1, nextval(pg_get_serial_sequence('proposal_templates', 'id'))), $2, $3, $4, $5, $6, $7, now(), now())\nON CONFLICT (id) DO UPDATE SET\n  title = EXCLUDED.title,\n  content_html = EXCLUDED.content_html,\n  email_subject = EXCLUDED.email_subject,\n  email_body = EXCLUDED.email_body,\n  linked_contract_template_id = EXCLUDED.linked_contract_template_id,\n  updated_at = now()\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.id, $json.title, $json.contentHtml, $json.emailSubject, $json.emailBody, $json.linkedContractTemplateId, $json.requesterId ] }}"
        }
      },
