    {
      "parameters": {
        "jsCode": "const existing = $input.item.json;\nconst requester = $('Look Up Requester (Save)').first().json;\nconst body = $('Webhook - Save Proposal Template').first().json.body || {};\n\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\n\nconst id = body.id ? parseInt(body.id, 10) : null;\nif (id && existing.created_by != null && requester.role !== 'admin' && existing.created_by !== requester.id) {\n  throw new Error('Only an admin or the template\\'s creator can edit it.');\n}\n\nconst title = (body.title || '').toString().trim();\nconst contentHtml = (body.content_html || '').toString();\nconst emailSubject = (body.email_subject || '').toString().trim() || 'Your proposal is ready';\nconst emailBody = (body.email_body || '').toString().trim() || 'Hi {{first_name}}, please review your proposal here: {{proposal_link}}';\nconst linkedContractTemplateId = body.linked_contract_template_id ? parseInt(body.linked_contract_template_id, 10) : null;\n\nif (!title) throw new Error('\"title\" is required.');\nif (!contentHtml.trim()) throw new Error('Proposal content is required.');\n\nreturn [{ json: { id, title, contentHtml, emailSubject, emailBody, linkedContractTemplateId, requesterId: requester.id } }];"
      },
      "id": "ptpl0011-1111-4a5a-9b1a-proptemp0011",
