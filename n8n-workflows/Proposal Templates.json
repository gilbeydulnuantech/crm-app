    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT pt.created_by\nFROM (SELECT $1::int AS tid) dummy\nLEFT JOIN proposal_templates pt ON pt.id = dummy.tid;",
        "options": {
          "queryReplacement": "={{ [ $('Webhook - Save Proposal Template').first().json.body.id || null ] }}"
        }
      },
      "id": "ptpl0010-1010-4a5a-9b1a-proptemp0010",
