    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT pt.id, pt.title, pt.content_html, pt.email_subject, pt.email_body, pt.linked_contract_template_id, ct.title AS linked_contract_template_title, pt.created_by, u.name AS created_by_name, pt.created_at, pt.updated_at\nFROM proposal_templates pt\nLEFT JOIN users u ON u.id = pt.created_by\nLEFT JOIN contract_templates ct ON ct.id = pt.linked_contract_template_id\nORDER BY pt.title ASC;",
        "options": {}
