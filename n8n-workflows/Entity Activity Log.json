    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nif (requester.role !== 'admin') throw new Error('Admin access required.');\n\nconst query = $('Webhook: get-global-audit-log').first().json.query || {};\n\nconst actorId = query.actor_id ? parseInt(query.actor_id, 10) : null;\nconst entityType = ['contact', 'company'].includes(query.entity_type) ? query.entity_type : null;\nconst dateFrom = query.date_from || null;\nconst dateTo = query.date_to || null;\nconst page = Math.max(1, parseInt(query.page, 10) || 1);\nconst pageSize = 50;\nconst offset = (page - 1) * pageSize;\n\nreturn [{ json: { actorId, entityType, dateFrom, dateTo, limit: pageSize, offset } }];"
      },
      "id": "a1b2c3d4-0023-4a5a-9b1a-eal000000023",
      "name": "Validate Admin & Filters",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1712,
        1200
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, entity_type, entity_id,\n  CASE WHEN entity_type = 'contact' THEN (SELECT TRIM(CONCAT(first_name, ' ', last_name)) FROM contacts WHERE id = entity_id)\n       WHEN entity_type = 'company' THEN (SELECT name FROM companies WHERE id = entity_id) END AS entity_name,\n  category, subtype, summary, detail, actor_id, actor_name, created_at\nFROM entity_activity_log\nWHERE category = 'system_audit'\n  AND ($1::int IS NULL OR actor_id = $1)\n  AND ($2::text IS NULL OR entity_type = $2)\n  AND ($3::timestamptz IS NULL OR created_at >= $3::timestamptz)\n  AND ($4::timestamptz IS NULL OR created_at <= $4::timestamptz)\nORDER BY created_at DESC, id DESC\nLIMIT $5 OFFSET $6;",
        "options": {
          "queryReplacement": "={{ [ $json.actorId, $json.entityType, $json.dateFrom, $json.dateTo, $json.limit, $json.offset ] }}"
        }
      },
