      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name, role, active FROM users WHERE id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $json.requesterId ] }}"
        }
      },
      "id": "a1b2c3d4-0008-4a5a-9b1a-eal000000008",
