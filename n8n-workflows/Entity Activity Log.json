    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r.valid) throw new Error('Invalid session.');\nconst requesterId = r.userId;\n\nconst body = $('Webhook: add-entity-activity').first().json.body || {};\n\nconst entityType = (body.entity_type || '').toString().trim();\nconst entityId = parseInt(body.entity_id, 10);\nconst category = (body.category || '').toString().trim();\nconst subtype = body.subtype ? body.subtype.toString().trim() : null;\nconst summary = (body.summary || '').toString().trim();\n\nif (!['contact', 'company'].includes(entityType)) {\n  throw new Error('\"entity_type\" must be \"contact\" or \"company\".');\n}\nif (!Number.isInteger(entityId)) {\n  throw new Error('\"entity_id\" must be an integer.');\n}\n// Only 'call' is accepted from this public endpoint today (manual call\n// logging from the Call button) \u2014 'meeting'/'system_audit' rows are written\n// internally by other workflows (contacts-update, Users: Assignment) so a\n// client can't fabricate an audit trail entry.\nif (category !== 'call') {\n  throw new Error('\"category\" must be \"call\".');\n}\nif (!summary) {\n  throw new Error('\"summary\" is required.');\n}\n\nconst detail = body.detail && typeof body.detail === 'object' ? JSON.stringify(body.detail) : null;\n\nreturn [{\n  json: { requesterId, entityType, entityId, category, subtype: subtype || 'manual', summary, detail }\n}];"
      },
      "id": "a1b2c3d4-0007-4a5a-9b1a-eal000000007",
