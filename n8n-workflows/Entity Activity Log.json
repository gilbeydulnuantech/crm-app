    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\n\nconst p = $('Parse Token & Payload').first().json;\nreturn [{\n  json: {\n    entityType: p.entityType,\n    entityId: p.entityId,\n    category: p.category,\n    subtype: p.subtype,\n    summary: p.summary,\n    detail: p.detail,\n    actorId: requester.id,\n    actorName: requester.name || 'Unknown',\n  }\n}];"
      },
      "id": "a1b2c3d4-0009-4a5a-9b1a-eal000000009",
      "name": "Build Insert Payload",
      "type": "n8n-nodes-base.code",
