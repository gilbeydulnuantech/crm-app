    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO entity_activity_log (entity_type, entity_id, category, subtype, summary, detail, actor_id, actor_name) VALUES ($1, $2, $3, $4, $5, $6::jsonb, $7, $8) RETURNING id, created_at;",
        "options": {
          "queryReplacement": "={{ [ $json.entityType, $json.entityId, $json.category, $json.subtype, $json.summary, $json.detail, $json.actorId, $json.actorName ] }}"
