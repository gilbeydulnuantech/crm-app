    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, entity_type, entity_id, category, subtype, summary, detail, actor_id, actor_name, created_at FROM entity_activity_log WHERE entity_type = $1 AND entity_id = $2 UNION ALL SELECT -a.id AS id, 'contact'::varchar(20) AS entity_type, a.contact_id AS entity_id, 'meeting'::varchar(20) AS category, (CASE WHEN a.location ~* 'zoom|meet\\.google|teams\\.microsoft|http' THEN 'video_call' ELSE 'physical' END)::varchar(30) AS subtype, COALESCE(a.subject, 'Meeting')::text AS summary, jsonb_build_object('location', a.location, 'due_at', a.due_at, 'end_at', a.end_at, 'is_all_day', a.is_all_day) AS detail, a.user_id AS actor_id, u.name::text AS actor_name, a.created_at FROM activities a LEFT JOIN users u ON u.id = a.user_id WHERE $1 = 'contact' AND a.contact_id = $2 AND a.type = 'meeting' ORDER BY created_at DESC, id DESC;",
        "options": {
          "queryReplacement": "={{ [ $('Webhook: get-entity-activity').first().json.query.entity_type, Number($('Webhook: get-entity-activity').first().json.query.entity_id) ] }}"
        }
