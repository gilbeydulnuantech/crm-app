    {
      "id": "np-fill",
      "name": "Fill Nurture Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        320
      ],
      "parameters": {
        "jsCode": "\nfunction toTitleCase(s) { return (s || '').toString().toLowerCase().split(' ').map((w) => (w ? w[0].toUpperCase() + w.slice(1) : w)).join(' '); }\nfunction fill(template, row) {\n  let base = '';\n  try { base = $env.FRONTEND_BASE_URL || ''; } catch (e) { base = ''; }\n  return (template || '')\n    .replace(/{{\\s*contact\\.first_name\\s*}}/gi, toTitleCase(row.first_name) || 'there')\n    .replace(/{{\\s*email\\s*}}/gi, row.email || '')\n    .replace(/{{\\s*unsubscribe_link\\s*}}/gi, base + '/unsubscribe/' + row.unsubscribe_token)\n    .replace(/{{(?!\\s*company_name\\s*}})[^{}]*}}/gi, '');\n}\n\nconst tmpl = $input.item.json;\nconst row = $('Determine Next Step').item.json;\nreturn [{ json: { to: row.email, subject: fill(tmpl.subject, row), htmlBody: fill(tmpl.body, row).replace(/\\n/g, '<br>') } }];"
      }
    },
    {
      "id": "np-send",
      "name": "Send Nurture Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1740,
        320
      ],
      "parameters": {
        "sendTo": "={{ $('Fill Nurture Email').item.json.to }}",
        "subject": "={{ ($('Fill Nurture Email').item.json.subject).replace(/\\{\\{\\s*company_name\\s*\\}\\}/gi, $('Get Company Name: Nurture Email').item.json.company_name) }}",
        "emailType": "html",
        "message": "={{ (($('Fill Nurture Email').item.json.htmlBody).replace(/The Team/g, $('Get Company Name: Nurture Email').item.json.company_name + ' Team')).replace(/\\{\\{\\s*company_name\\s*\\}\\}/gi, $('Get Company Name: Nurture Email').item.json.company_name) }}",
        "options": {
          "senderName": "={{ $('Get Company Name: Nurture Email').item.json.company_name }}"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "YE9RFYruaRVVZ6H4",
          "name": "CRMapp"
        }
      },
      "onError": "continueRegularOutput"
    },
