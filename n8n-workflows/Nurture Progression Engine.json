      "id": "np-find-due",
      "name": "Find Due Sends",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        420,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT es.id AS send_id, es.contact_id, es.workflow_step, es.sent_at, c.first_name, c.last_name, c.email, c.phone, c.owner_id, c.unsubscribe_token, c.dnc_sms, EXISTS (SELECT 1 FROM taggables tg JOIN tags t ON t.id = tg.tag_id WHERE tg.entity_type = 'contact' AND tg.entity_id = c.id AND t.name = 'Engaged Lead') AS already_engaged FROM email_sends es JOIN contacts c ON c.id = es.contact_id WHERE es.workflow_id = 'new_lead' AND es.reply_status = 'waiting' AND es.sent_at <= now() - interval '24 hours' AND c.is_archived = false;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "id": "np-next-step",
      "name": "Determine Next Step",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ],
      "parameters": {
        "jsCode": "const NEXT = { thank_you: { step: 'nurture_1', templateId: 15 }, nurture_1: { step: 'nurture_2', templateId: 16 }, nurture_2: { step: 'nurture_3', templateId: 17 }, nurture_3: null };\nconst row = $input.item.json;\nconst next = NEXT[row.workflow_step] || null;\nreturn [{ json: { ...row, nextStep: next ? next.step : null, nextTemplateId: next ? next.templateId : null } }];"
      }
    },
