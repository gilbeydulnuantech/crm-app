        1440,
        2720
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.id, t.name\nFROM tags t\nJOIN taggables tg ON tg.tag_id = t.id\nWHERE tg.entity_type = $1 AND tg.entity_id = $2\nORDER BY t.name ASC;",
        "options": {
          "queryReplacement": "={{ [ $json.entity_type, $json.entity_id ] }}"
        }
      },
