        1440,
        2192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO tags (name)\nVALUES ($1)\nON CONFLICT (name) DO UPDATE SET name = EXCLUDED.name\nRETURNING id, name;",
        "options": {
          "queryReplacement": "={{ [ $json.name ] }}"
        }
      },
