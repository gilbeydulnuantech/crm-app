    {
      "parameters": {
        "jsCode": "const query = $input.first().json.query ?? {};\nconst entityType = (query.entity_type || '').trim();\nconst entityId = parseInt(query.entity_id, 10);\n\nconst allowedTypes = ['contact', 'deal', 'company'];\n\nif (!allowedTypes.includes(entityType)) {\n  throw new Error(`\"entity_type\" query param must be one of: ${allowedTypes.join(', ')}`);\n}\nif (!Number.isInteger(entityId)) {\n  throw new Error('\"entity_id\" query param must be an integer.');\n}\n\nreturn [{ json: { entity_type: entityType, entity_id: entityId } }];"
      },
      "id": "07471d15-90a9-4cdb-94fe-1282131387a3",
      "name": "Validate Query Params",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
