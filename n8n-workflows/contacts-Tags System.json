    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst tagId = parseInt(body.tag_id, 10);\nconst entityType = (body.entity_type || '').trim();\nconst entityId = parseInt(body.entity_id, 10);\n\nconst allowedTypes = ['contact', 'deal', 'company'];\n\nif (!Number.isInteger(tagId)) {\n  throw new Error('\"tag_id\" must be an integer.');\n}\nif (!allowedTypes.includes(entityType)) {\n  throw new Error(`\"entity_type\" must be one of: ${allowedTypes.join(', ')}`);\n}\nif (!Number.isInteger(entityId)) {\n  throw new Error('\"entity_id\" must be an integer.');\n}\n\nreturn [{ json: { tag_id: tagId, entity_type: entityType, entity_id: entityId } }];"
      },
