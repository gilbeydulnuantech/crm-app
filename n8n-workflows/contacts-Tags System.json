    },
    {
      "parameters": {
        "jsCode": "const headers = $input.first().json.headers || {};\nconst authHeader = headers['authorization'] || headers['Authorization'] || '';\nconst token = authHeader.replace('Bearer ', '').trim();\n\nconst match = token.match(/^token_(\\d+)_(\\d+)$/);\nif (!match) throw new Error('Invalid or missing session token.');\n\nconst requesterId = parseInt(match[1], 10);\n\nconst query = $input.first().json.query ?? {};\nconst tagName = (query.tag_name || '').trim();\nif (!tagName) throw new Error('\"tag_name\" query param is required.');\n\nreturn [{ json: { requesterId, tagName } }];"
      },
      "id": "6343f21f-cbf8-4a2a-bc69-c4bb843ab3ad",
      "name": "Parse Token & Tag Name",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        2912
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, role, active FROM users WHERE id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $json.requesterId ] }}"
        }
      },
      "id": "b748f6a4-8007-4b6c-ac79-ffa9dad9bd41",
      "name": "Look Up Requester",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1664,
        2912
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nconst { tagName } = $('Parse Token & Tag Name').first().json;\n\n// If requester is empty object (from alwaysOutputData) or inactive\nif (!requester.id || !requester.active) throw new Error('Invalid session or user not found.');\n\nconst sqlQuery = `\n  SELECT c.*\n  FROM contacts c\n  JOIN taggables tg ON tg.entity_type = 'contact' AND tg.entity_id = c.id\n  JOIN tags t ON t.id = tg.tag_id\n  WHERE t.name = $1\n    AND ($2 = 'admin' OR c.owner_id = $3)\n    AND c.is_archived = false\n  ORDER BY c.id;\n`;\nconst queryParams = [tagName, requester.role, requester.id];\n\nreturn [{ json: { sqlQuery, queryParams } }];"
      },
      "id": "b3047689-c054-4b75-a684-57facec77084",
      "name": "Build Query",
      "type": "n8n-nodes-base.code",
