            "index": 0
          }
        ]
      ]
    },
    "If: Contact Found": {
      "main": [
        [
          {
            "node": "Postgres: Ensure email_logs Column (Reply)",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Postgres: Ensure email_logs Column (Reply)": {
      "main": [
        [
          {
            "node": "Postgres: Append Received Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
