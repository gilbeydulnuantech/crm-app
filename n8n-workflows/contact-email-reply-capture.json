{
  "name": "Contact Email - Reply Capture (SCAFFOLD, needs IMAP credential)",
  "nodes": [
    {
      "parameters": {
        "mailbox": "INBOX",
        "postProcessAction": "read",
        "options": {}
      },
      "id": "trigger-email-reply",
      "name": "Email Trigger (IMAP): Contact Replies",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [
        0,
        900
      ],
      "credentials": {
        "imap": {
          "id": "REPLACE_WITH_YOUR_IMAP_CREDENTIAL_ID",
          "name": "Contact Inbox (IMAP)"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Finds the contact whose email matches the reply's From address.\nSELECT id FROM contacts WHERE lower(email) = lower($1) LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$json.from?.value?.[0]?.address || $json.from?.text || ''] }}"
        }
      },
      "id": "pg-find-contact-by-email",
      "name": "Postgres: Find Contact By Email",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        900
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres CRM DB"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-contact-found",
      "name": "If: Contact Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        900
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Appends the reply as an unread log entry - matches the color-change-on-\n-- open behavior in ContactDetailModal.tsx (is_read: false -> highlighted).\nUPDATE contacts\nSET email_logs = COALESCE(email_logs, '[]'::jsonb) || jsonb_build_object(\n  'id', gen_random_uuid()::text,\n  'type', 'received',\n  'subject', $1::text,\n  'message', $2::text,\n  'sent_at', now(),\n  'is_read', false\n)\nWHERE id = $3\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [$('Email Trigger (IMAP): Contact Replies').item.json.subject || 'No Subject', $('Email Trigger (IMAP): Contact Replies').item.json.text || $('Email Trigger (IMAP): Contact Replies').item.json.textHtml || '', $('Postgres: Find Contact By Email').item.json.id] }}"
        }
      },
      "id": "pg-append-received-log",
      "name": "Postgres: Append Received Log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        770,
        900
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres CRM DB"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "ALTER TABLE contacts ADD COLUMN IF NOT EXISTS email_logs jsonb DEFAULT '[]'::jsonb;",
        "options": {}
      },
      "id": "pg-ensure-email-logs-reply",
      "name": "Postgres: Ensure email_logs Column (Reply)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        550,
        900
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres CRM DB"
        }
      }
    }
  ],
  "connections": {
    "Email Trigger (IMAP): Contact Replies": {
      "main": [
        [
          {
            "node": "Postgres: Find Contact By Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres: Find Contact By Email": {
      "main": [
        [
          {
