    {
      "parameters": { "httpMethod": "GET", "path": "get-report-team", "responseMode": "responseNode", "options": {} },
      "id": "wh-team", "name": "Webhook: get-report-team", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 880]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT u.id AS user_id, u.name, COALESCE(od.cnt,0) AS open_deals, COALESCE(wd.cnt,0) AS won_deals, COALESCE(wd.revenue,0) AS revenue, COALESCE(tc.cnt,0) AS tasks_completed, COALESCE(co.cnt,0) AS contacts_owned FROM users u LEFT JOIN (SELECT assigned_user, COUNT(*) AS cnt FROM opportunities WHERE status='Open' GROUP BY assigned_user) od ON od.assigned_user = u.id LEFT JOIN (SELECT assigned_user, COUNT(*) AS cnt, SUM(deal_value) AS revenue FROM opportunities WHERE status='Won' AND closed_at >= now() - ($1||' days')::interval GROUP BY assigned_user) wd ON wd.assigned_user = u.id LEFT JOIN (SELECT user_id, COUNT(*) AS cnt FROM activities WHERE type='task' AND is_completed=true AND completed_at >= now() - ($1||' days')::interval GROUP BY user_id) tc ON tc.user_id = u.id LEFT JOIN (SELECT owner_id, COUNT(*) AS cnt FROM contacts WHERE is_archived=false GROUP BY owner_id) co ON co.owner_id = u.id WHERE u.active = true ORDER BY u.name;",
        "options": { "queryReplacement": "={{ [$json.query.days || '30'] }}" }
      },
      "id": "pg-team", "name": "Postgres: Team Report", "type": "n8n-nodes-base.postgres", "typeVersion": 2.5, "position": [220, 880],
      "credentials": { "postgres": { "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID", "name": "Postgres CRM DB" } }
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": { "responseHeaders": { "entries": [
          { "name": "Access-Control-Allow-Origin", "value": "*" },
          { "name": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
          { "name": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, ngrok-skip-browser-warning" }
        ] } }
      },
      "id": "resp-team", "name": "Respond: get-report-team", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [440, 880],
      "notes": "IMPORTANT: this endpoint returns every rep's revenue/deal data with no role check. The React UI hides the Team tab from non-admins, but the webhook itself will answer anyone who calls it directly. Same server-side-enforcement gap flagged throughout this README."
    },

