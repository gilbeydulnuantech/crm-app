{
  "name": "Reports CRUD",
  "nodes": [
    {
      "parameters": { "httpMethod": "GET", "path": "get-report-overview", "responseMode": "responseNode", "options": {} },
      "id": "wh-overview", "name": "Webhook: get-report-overview", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT json_build_object('total_contacts', (SELECT COUNT(*) FROM contacts WHERE is_archived = false), 'total_companies', (SELECT COUNT(*) FROM companies WHERE is_archived = false), 'open_deals', (SELECT COUNT(*) FROM opportunities WHERE status = 'Open'), 'won_this_month', (SELECT COUNT(*) FROM opportunities WHERE status = 'Won' AND date_trunc('month', closed_at) = date_trunc('month', now())), 'total_revenue', (SELECT COALESCE(SUM(deal_value), 0) FROM opportunities WHERE status = 'Won'), 'revenue_trend', (SELECT COALESCE(json_agg(json_build_object('snapshot_date', snapshot_date, 'value', value) ORDER BY snapshot_date), '[]'::json) FROM report_snapshots WHERE metric = 'total_revenue' AND scope = 'company' AND snapshot_date >= (now() - ($1 || ' days')::interval))) AS result;",
        "options": { "queryReplacement": "={{ [$json.query.days || '30'] }}" }
      },
      "id": "pg-overview", "name": "Postgres: Overview Aggregate", "type": "n8n-nodes-base.postgres", "typeVersion": 2.5, "position": [220, 0],
      "credentials": { "postgres": { "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID", "name": "Postgres CRM DB" } }
    },
    {
      "parameters": {
        "respondWith": "json", "responseBody": "={{ $json.result }}",
        "options": { "responseHeaders": { "entries": [
          { "name": "Access-Control-Allow-Origin", "value": "*" },
          { "name": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
          { "name": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, ngrok-skip-browser-warning" }
        ] } }
      },
      "id": "resp-overview", "name": "Respond: get-report-overview", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [440, 0]
    },

    {
      "parameters": { "httpMethod": "GET", "path": "get-report-sales", "responseMode": "responseNode", "options": {} },
      "id": "wh-sales", "name": "Webhook: get-report-sales", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 220]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT json_build_object('won_count', (SELECT COUNT(*) FROM opportunities WHERE status='Won' AND closed_at >= now() - ($1||' days')::interval), 'lost_count', (SELECT COUNT(*) FROM opportunities WHERE status='Lost' AND closed_at >= now() - ($1||' days')::interval), 'win_rate', (SELECT CASE WHEN (won+lost) = 0 THEN 0 ELSE (won::numeric / (won+lost) * 100) END FROM (SELECT COUNT(*) FILTER (WHERE status='Won') AS won, COUNT(*) FILTER (WHERE status='Lost') AS lost FROM opportunities WHERE closed_at >= now() - ($1||' days')::interval) t), 'won_value', (SELECT COALESCE(SUM(deal_value),0) FROM opportunities WHERE status='Won' AND closed_at >= now() - ($1||' days')::interval), 'lost_value', (SELECT COALESCE(SUM(deal_value),0) FROM opportunities WHERE status='Lost' AND closed_at >= now() - ($1||' days')::interval), 'revenue_by_rep', (SELECT COALESCE(json_agg(json_build_object('user_id', u.id, 'name', u.name, 'revenue', s.revenue) ORDER BY s.revenue DESC), '[]'::json) FROM (SELECT assigned_user, COALESCE(SUM(deal_value),0) AS revenue FROM opportunities WHERE status='Won' AND closed_at >= now() - ($1||' days')::interval GROUP BY assigned_user) s JOIN users u ON u.id = s.assigned_user)) AS result;",
        "options": { "queryReplacement": "={{ [$json.query.days || '30'] }}" }
      },
      "id": "pg-sales", "name": "Postgres: Sales Aggregate", "type": "n8n-nodes-base.postgres", "typeVersion": 2.5, "position": [220, 220],
      "credentials": { "postgres": { "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID", "name": "Postgres CRM DB" } }
    },
    {
      "parameters": {
        "respondWith": "json", "responseBody": "={{ $json.result }}",
        "options": { "responseHeaders": { "entries": [
          { "name": "Access-Control-Allow-Origin", "value": "*" },
          { "name": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
          { "name": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, ngrok-skip-browser-warning" }
        ] } }
      },
      "id": "resp-sales", "name": "Respond: get-report-sales", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [440, 220]
    },

    {
      "parameters": { "httpMethod": "GET", "path": "get-report-pipeline", "responseMode": "responseNode", "options": {} },
      "id": "wh-pipeline", "name": "Webhook: get-report-pipeline", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 440]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT json_build_object('by_stage', (SELECT COALESCE(json_agg(json_build_object('stage_id', st.id, 'stage_name', st.name, 'count', COALESCE(o.cnt,0), 'value', COALESCE(o.val,0)) ORDER BY st.display_order), '[]'::json) FROM stages st LEFT JOIN (SELECT stage_id, COUNT(*) AS cnt, SUM(deal_value) AS val FROM opportunities WHERE status='Open' GROUP BY stage_id) o ON o.stage_id = st.id), 'avg_deal_value', (SELECT COALESCE(AVG(deal_value),0) FROM opportunities WHERE status='Open'), 'avg_days_to_close', (SELECT AVG(EXTRACT(EPOCH FROM (closed_at - created_at))/86400) FROM opportunities WHERE status='Won')) AS result;",
        "options": {}
      },
      "id": "pg-pipeline", "name": "Postgres: Pipeline Aggregate", "type": "n8n-nodes-base.postgres", "typeVersion": 2.5, "position": [220, 440],
      "credentials": { "postgres": { "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID", "name": "Postgres CRM DB" } }
    },
    {
      "parameters": {
        "respondWith": "json", "responseBody": "={{ $json.result }}",
        "options": { "responseHeaders": { "entries": [
          { "name": "Access-Control-Allow-Origin", "value": "*" },
          { "name": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
          { "name": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, ngrok-skip-browser-warning" }
        ] } }
      },
      "id": "resp-pipeline", "name": "Respond: get-report-pipeline", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [440, 440]
    },

    {
      "parameters": { "httpMethod": "GET", "path": "get-report-contacts", "responseMode": "responseNode", "options": {} },
      "id": "wh-contacts", "name": "Webhook: get-report-contacts", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 660]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT json_build_object('total', (SELECT COUNT(*) FROM contacts WHERE is_archived=false), 'new_trend', (SELECT COALESCE(json_agg(json_build_object('snapshot_date', snapshot_date, 'value', value) ORDER BY snapshot_date), '[]'::json) FROM report_snapshots WHERE metric='new_contacts' AND scope='company' AND snapshot_date >= (now() - ($1||' days')::interval)), 'by_status', (SELECT COALESCE(json_agg(json_build_object('lead_status', lead_status, 'count', cnt)), '[]'::json) FROM (SELECT lead_status, COUNT(*) AS cnt FROM contacts WHERE is_archived=false GROUP BY lead_status) s), 'by_source', (SELECT COALESCE(json_agg(json_build_object('lead_source', lead_source, 'count', cnt)), '[]'::json) FROM (SELECT lead_source, COUNT(*) AS cnt FROM contacts WHERE is_archived=false GROUP BY lead_source) s)) AS result;",
        "options": { "queryReplacement": "={{ [$json.query.days || '30'] }}" }
      },
      "id": "pg-contacts", "name": "Postgres: Contacts Aggregate", "type": "n8n-nodes-base.postgres", "typeVersion": 2.5, "position": [220, 660],
      "credentials": { "postgres": { "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID", "name": "Postgres CRM DB" } }
