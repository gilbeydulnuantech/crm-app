    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT json_build_object('company', (SELECT json_build_object('id', co.id, 'name', co.name) FROM contacts c JOIN companies co ON co.id = c.account_id WHERE c.id = $1), 'deal', (SELECT json_build_object('id', o.id, 'name', o.name, 'deal_value', o.deal_value, 'stage_name', st.name) FROM opportunities o JOIN stages st ON st.id = o.stage_id WHERE o.contact_id = $1 AND o.status = 'Open' ORDER BY o.created_at DESC LIMIT 1), 'task', (SELECT json_build_object('id', a.id, 'subject', a.subject, 'due_at', a.due_at) FROM activities a WHERE a.contact_id = $1 AND a.type = 'task' AND a.is_completed = false ORDER BY a.due_at ASC NULLS LAST LIMIT 1), 'event', (SELECT json_build_object('id', a.id, 'subject', a.subject, 'due_at', a.due_at) FROM activities a WHERE a.contact_id = $1 AND a.type != 'task' AND a.due_at >= now() ORDER BY a.due_at ASC LIMIT 1)) AS result;",
        "options": {
          "queryReplacement": "={{ [$json.query.contact_id] }}"
        }
      },
      "id": "121e281a-6e89-48ab-9e97-2eec2dc9b25c",
