    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT m.id, m.conversation_id, m.sender_id, u.name AS sender_name, u.color AS sender_color,\n  m.body, m.attachment_url, m.attachment_name, m.created_at, m.edited_at\nFROM messages m\nJOIN users u ON u.id = m.sender_id\nWHERE m.conversation_id = $1\n  AND EXISTS (\n    SELECT 1 FROM conversations c\n    WHERE c.id = $1 AND (\n      c.type = 'channel'\n      OR EXISTS (SELECT 1 FROM conversation_members cm WHERE cm.conversation_id = c.id AND cm.user_id = $2)\n    )\n  )\nORDER BY m.created_at ASC;",
