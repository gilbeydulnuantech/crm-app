{
  "name": "Image Proxy",
  "pinData": {},
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Almaty"
  },
  "versionId": "9f1a1c00-0000-4a5a-9b1a-imageproxy001",
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "id": "imgproxy0001workflow",
  "tags": [],
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "image-proxy",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "imgproxy-0001-webhook",
      "name": "Webhook - Image Proxy",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        400,
        300
      ],
      "notes": "Public, read-only image relay \u2014 used by the frontend (html2canvas) to fetch cross-origin images (e.g. Google Drive logos) server-to-server, since Drive never sends CORS headers on any of its own URLs."
    },
    {
      "parameters": {
        "jsCode": "const url = ($input.item.json.query && $input.item.json.query.url) || '';\nif (!url || !/^https?:\\/\\//i.test(url)) throw new Error('A valid url query parameter is required.');\nreturn [{ json: { url } }];"
      },
      "id": "imgproxy-0002-validate",
      "name": "Validate URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          },
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        }
      },
      "id": "imgproxy-0003-fetch",
      "name": "Fetch Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        840,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const bin = $input.item.binary && $input.item.binary.data;\nif (!bin) throw new Error('No image data received.');\n// binaryDataMode is 'filesystem' \u2014 bin.data is a file reference, not the\n// base64 payload itself, so it must be dereferenced via this helper rather\n// than read directly off the item.\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst base64 = buffer.toString('base64');\nreturn [{ json: { success: true, dataUri: `data:${bin.mimeType};base64,${base64}` } }];"
      },
      "id": "imgproxy-0006-encode",
      "name": "Encode As Data URI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
                "name": "Cache-Control",
                "value": "public, max-age=3600"
              }
            ]
          }
        }
      },
      "id": "imgproxy-0004-respond",
      "name": "Respond - Image",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1280,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, error: 'Failed to fetch image.' } }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "imgproxy-0005-error",
      "name": "Respond - Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1060,
        400
      ]
    }
  ],
  "connections": {
    "Webhook - Image Proxy": {
      "main": [
        [
          {
            "node": "Validate URL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate URL": {
      "main": [
        [
          {
            "node": "Fetch Image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Image": {
      "main": [
        [
          {
            "node": "Encode As Data URI",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond - Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Encode As Data URI": {
      "main": [
        [
          {
            "node": "Respond - Image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
