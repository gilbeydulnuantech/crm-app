  "name": "Enrich Contact From Website",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "enrich-contact",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "http://localhost:5173"
        }
      },
      "id": "ecw-webhook-1",
      "name": "Webhook: enrich-contact",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "ecw-enrich-contact-0001"
    },
    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nconst body = $('Webhook: enrich-contact').first().json.body || {};\nconst raw = body.contact_id;\nconst contactId = (typeof raw === 'number' || (typeof raw === 'string' && /^\\d+$/.test(raw.trim()))) ? Number(raw) : NaN;\nif (!Number.isInteger(contactId) || contactId <= 0) throw new Error('\"contact_id\" is required.');\nreturn [{ json: { contactId } }];"
      },
      "id": "ecw-validate",
      "name": "Validate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id AS contact_id, c.first_name, c.last_name, c.email, c.phone, co.id AS company_id, co.name AS company_name, co.website FROM contacts c LEFT JOIN companies co ON co.id = c.account_id WHERE c.id = $1 AND c.is_archived = false AND ($2 = 'admin' OR c.owner_id = $3) LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $json.contactId, $('Validate Session').first().json.role, $('Validate Session').first().json.id ] }}"
        }
      },
      "id": "ecw-lookup-contact",
      "name": "Look Up Contact & Website",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        0
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nif (!row || !row.contact_id) throw new Error('Contact not found, or you do not have access to it.');\nif (!row.company_id) throw new Error('This contact is not linked to a company, so there is no website to enrich from.');\nif (!row.website) throw new Error('This company has no website on file, nothing to enrich from.');\nreturn [{ json: row }];"
      },
      "id": "ecw-require-website",
      "name": "Require Website",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT pgp_sym_decrypt(api_key_encrypted, $1) AS api_key FROM integrations WHERE provider = 'apify' AND is_active = true AND api_key_encrypted IS NOT NULL LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $env.INTEGRATIONS_ENCRYPTION_KEY ] }}"
        }
      },
      "id": "ecw-lookup-apify-key",
      "name": "Look Up Apify Key",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1320,
        0
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const key = $input.first().json.api_key;\nif (!key) throw new Error('Apify is not connected \u2014 add an API key in Settings > Integrations.');\nconst ctx = $('Require Website').first().json;\nreturn [{ json: { ...ctx, apifyKey: key } }];"
      },
      "id": "ecw-merge-key",
      "name": "Require Apify Key",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.apify.com/v2/acts/vdrmota~contact-info-scraper/run-sync-get-dataset-items?token={{ $json.apifyKey }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ startUrls: [{ url: $json.website }], maxDepth: 1, maxRequestsPerCrawl: 8 }) }}",
        "options": {
          "timeout": 240000
        }
      },
      "id": "ecw-apify-call",
      "name": "Scrape Website for Contact Info",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Require Apify Key').first().json;\nconst result = $input.first().json || {};\nconst emails = Array.isArray(result.emails) ? result.emails : [];\nconst phones = ([]).concat(result.phones || [], result.phonesUncertain || []);\n\nlet domain = '';\ntry { domain = new URL(ctx.website).hostname.replace(/^www\\./, ''); } catch {}\n\nconst GENERIC_LOCALPARTS = new Set(['info', 'support', 'contact', 'sales', 'hello', 'admin', 'office', 'help', 'team', 'service', 'noreply', 'no-reply', 'privacy', 'legal', 'careers', 'jobs']);\n\nfunction titleCase(s) {\n  return s.replace(/[-_]/g, ' ').split(' ').filter(Boolean).map((w) => w[0].toUpperCase() + w.slice(1).toLowerCase()).join(' ');\n}\n\n// Prefer an email on the company's own domain whose local part looks like a\n// real person (firstname.lastname / firstname_lastname), over generic\n// mailbox names \u2014 those are far more useful as an actual point of contact.\nconst sameDomainEmails = emails.filter((e) => e.toLowerCase().endsWith('@' + domain));\n// Only emails on the business's own domain are trusted. Falling back to any email on the scraped pages put another\n// company's address on the contact (the scraper also follows links off-site), and automations then email that company.\nconst candidates = sameDomainEmails;\n\nlet bestEmail = null;\nlet guessedFirstName = null;\nlet guessedLastName = null;\nfor (const e of candidates) {\n  const localPart = e.split('@')[0].toLowerCase();\n  if (GENERIC_LOCALPARTS.has(localPart)) continue;\n  const m = localPart.match(/^([a-z]+)[._-]([a-z]+)$/);\n  bestEmail = e;\n  if (m) {\n    guessedFirstName = titleCase(m[1]);\n    guessedLastName = titleCase(m[2]);\n  }\n  break;\n}\nif (!bestEmail && candidates.length) bestEmail = candidates[0];\n\nconst bestPhone = phones.length ? phones[0] : null;\n\nreturn [{\n  json: {\n    contactId: ctx.contact_id,\n    companyName: ctx.company_name,\n    currentFirstName: ctx.first_name,\n    currentEmail: ctx.email,\n    currentPhone: ctx.phone,\n    foundEmail: bestEmail,\n    foundPhone: bestPhone,\n    guessedFirstName,\n    guessedLastName,\n  },\n}];"
      },
      "id": "ecw-pick-best",
      "name": "Pick Best Contact Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE contacts c SET\n  email = COALESCE(NULLIF(c.email, ''), $1),\n  phone = COALESCE(NULLIF(c.phone, ''), $2),\n  first_name = CASE WHEN $3::text IS NOT NULL AND lower(c.first_name) = lower($6::text) THEN $3 ELSE c.first_name END,\n  last_name = CASE WHEN $4::text IS NOT NULL AND lower(c.first_name) = lower($6::text) THEN $4 ELSE c.last_name END,\n  updated_at = now()\nWHERE c.id = $5\nRETURNING c.id, c.first_name, c.last_name, c.email, c.phone;",
        "options": {
          "queryReplacement": "={{ [ $json.foundEmail, $json.foundPhone, $json.guessedFirstName, $json.guessedLastName, $json.contactId, $json.companyName ] }}"
        }
      },
      "id": "ecw-update-contact",
      "name": "Update Contact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2200,
        0
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const updated = $input.first().json;\nconst found = $('Pick Best Contact Info').first().json;\nreturn [{\n  json: {\n    success: true,\n    // true only when the scraped value was actually saved (existing email/phone are never overwritten)\n    found_email: !!found.foundEmail && !found.currentEmail && updated.email === found.foundEmail,\n    found_phone: !!found.foundPhone && !found.currentPhone && updated.phone === found.foundPhone,\n    renamed: found.currentFirstName !== updated.first_name,\n    contact: updated,\n  },\n}];"
      },
