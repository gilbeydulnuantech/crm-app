{
  "name": "Deal Stage Tag Sync Engine",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "deal-stage-tag-sync",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "dsts-0001-webhook",
      "name": "Webhook: deal-stage-tag-sync",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "b3d7f1a2-6c4e-4a9b-9e2d-7f1c3a5b8d6e",
      "position": [
        0,
        0
      ],
      "onError": "continueErrorOutput",
      "notes": "Internal, system-to-system endpoint (no session-token auth), meant to be called right after a deal's stage_id is updated (e.g. from the move-opportunity-stage webhook). Payload: { opportunity_id, stage_name, contact_id }. Only reacts to one specific stage \u2014 'inspection done' \u2014 by tagging the linked contact 'Hot Lead'; every other stage is a no-op. No longer syncs a tag per pipeline stage."
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst opportunityId = parseInt(body.opportunity_id, 10);\nif (!Number.isInteger(opportunityId)) throw new Error('\"opportunity_id\" is required and must be an integer.');\nconst stageName = (body.stage_name || '').toString().trim();\nif (!stageName) throw new Error('\"stage_name\" is required.');\n// Optional: a deal with no linked contact sends this as null/absent \u2014\n// the tag-apply step below no-ops safely when it's missing.\nconst contactIdRaw = body.contact_id;\nconst contactId = (contactIdRaw === undefined || contactIdRaw === null || contactIdRaw === '')\n  ? null\n  : parseInt(contactIdRaw, 10);\n\nreturn [{ json: { opportunityId, stageName, contactId: Number.isInteger(contactId) ? contactId : null } }];"
      },
      "id": "dsts-0002-parse",
      "name": "Parse & Validate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "dsts-cond-inspection-done",
              "leftValue": "={{ $json.stageName }}",
              "rightValue": "inspection done",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "dsts-0012-is-inspection-done",
      "name": "Is Inspection Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        0
      ],
      "notes": "The only stage this engine reacts to. Matches the real pipeline stage name ('inspection done', case-insensitive) \u2014 if that stage gets renamed later, update the rightValue here to match. Every other stage_name just falls through to a no-op success response."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO tags (name)\nSELECT 'Hot Lead' WHERE NOT EXISTS (SELECT 1 FROM tags WHERE lower(name) = lower('Hot Lead'))\nON CONFLICT (name) DO NOTHING;",
        "options": {}
      },
      "id": "dsts-0013-ensure-active",
      "name": "Ensure Hot Lead Tag Exists",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        672,
        -112
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO taggables (tag_id, entity_type, entity_id)\nSELECT t.id, 'contact', $1::int\nFROM tags t\nWHERE lower(t.name) = lower('Hot Lead') AND $1::int IS NOT NULL\nON CONFLICT (tag_id, entity_type, entity_id) DO NOTHING;",
        "options": {
          "queryReplacement": "={{ [ $('Parse & Validate Payload').item.json.contactId ] }}"
        }
      },
      "id": "dsts-0014-apply-active",
      "name": "Apply Hot Lead Tag To Contact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        896,
        -112
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      },
      "notes": "Fires once the deal reaches 'inspection done' \u2014 tags the linked contact 'Hot Lead'. No-ops safely if contactId is null."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true } }}",
        "options": {}
      },
      "id": "dsts-0010-respond-ok",
      "name": "Respond - Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1120,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, error: (typeof $json.error === \"string\" ? $json.error : $json.error?.message) || $json.message || \"Request failed.\" } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "dsts-0011-respond-error",
      "name": "Respond - Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        448,
        336
      ]
    }
  ],
