      ],
      "webhookId": "ddf-draft-followup-0001"
    },
    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nconst body = $('Webhook: draft-deal-followup').first().json.body || {};\nconst dealId = parseInt(body.deal_id, 10);\nif (!Number.isInteger(dealId)) throw new Error('deal_id is required.');\nreturn [{ json: { dealId } }];"
      },
      "id": "ddf-validate",
      "name": "Validate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT o.id, o.name AS deal_name, o.deal_value, o.win_score, o.win_score_reason,\n  c.first_name, c.last_name, co.name AS company_name,\n  (SELECT p.status FROM proposals p WHERE p.opportunity_id = o.id ORDER BY p.created_at DESC LIMIT 1) AS proposal_status,\n  (SELECT p.title FROM proposals p WHERE p.opportunity_id = o.id ORDER BY p.created_at DESC LIMIT 1) AS proposal_title\nFROM opportunities o\nLEFT JOIN contacts c ON c.id = o.contact_id\nLEFT JOIN companies co ON co.id = o.account_id\nWHERE o.id = $1\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $json.dealId ] }}"
        }
      },
      "id": "ddf-lookup-deal",
      "name": "Look Up Deal Context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        0
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nif (!d || !d.id) throw new Error('Deal not found.');\n\nconst contactName = [d.first_name, d.last_name].filter(Boolean).join(' ') || 'the client';\nconst dealValue = d.deal_value != null ? `$${Number(d.deal_value).toLocaleString()}` : 'this job';\nconst company = d.company_name ? ` at ${d.company_name}` : '';\nconst proposalLine = d.proposal_status\n  ? `Their proposal ('${d.proposal_title || d.deal_name}') currently has status: ${d.proposal_status}.`\n  : 'No proposal has been sent to them yet.';\nconst situation = d.win_score_reason || 'No specific signal yet \u2014 this is an early-stage deal.';\n\nconst prompt = `You are a friendly, professional sales rep at a home services company. Write a short follow-up message (3-4 sentences max) to ${contactName}${company} about their \"${d.deal_name}\" deal (${dealValue}).\n\nCurrent situation: ${situation}\n${proposalLine}\n\nRules: casual and low-pressure tone, no subject line, no \"Dear ...\" greeting, no sign-off/signature, just the message body itself, plain text only.`;\n\nreturn [{ json: { prompt } }];"
      },
      "id": "ddf-build-prompt",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "onError": "continueErrorOutput"
    },
