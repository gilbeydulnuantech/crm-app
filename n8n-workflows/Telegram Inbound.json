    {
      "parameters": {
        "jsCode": "const r = $('Link Contact').first().json;\nconst chatId = $('Parse Update').first().json.chatId;\nconst ok = !!(r && r.id);\nreturn [{ json: { chatId, text: ok ? `Thanks${r.first_name ? ', ' + r.first_name : ''}! You're connected, and we'll send you updates here. Reply STOP at any time to unsubscribe.` : \"Sorry, that link isn't valid or has expired. Please ask us for a new one.\" } }];"
      },
