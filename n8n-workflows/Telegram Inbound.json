    {
      "parameters": {
        "jsCode": "const u = $input.first().json;\nconst m = u.message || {};\nconst chat = m.chat || {};\nconst text = (m.text || '').toString().trim();\nconst chatId = chat.id != null ? String(chat.id) : null;\nconst fromName = [m.from && m.from.first_name, m.from && m.from.last_name].filter(Boolean).join(' ') || 'Unknown';\n\nlet action = 'ignore';\nlet token = null;\n// Bots can be added to groups; only handle one-to-one chats.\nif (chatId && chat.type === 'private') {\n  const start = /^\\/start(?:@\\w+)?(?:\\s+(\\S+))?$/i.exec(text);\n  if (start && start[1]) { action = 'link'; token = start[1]; }\n  else if (start) { action = 'help'; }\n  else if (/^\\/?(stop|unsubscribe)$/i.test(text)) { action = 'optout'; }\n  else if (text) { action = 'message'; }\n}\nreturn [{ json: { action, chatId, token, text, fromName } }];"
      },
      "id": "f4ce0e3b-f694-4fa8-a43a-af08cab411cc",
      "name": "Parse Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
