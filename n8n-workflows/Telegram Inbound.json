    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO entity_activity_log (entity_type, entity_id, category, subtype, summary, detail, actor_name)\nSELECT 'contact', $1::int, 'telegram', 'linked', 'Contact linked their Telegram', jsonb_build_object('chat_id', $2::text), 'Telegram'\nWHERE $1::int IS NOT NULL\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.id, $('Parse Update').first().json.chatId ] }}"
        }
