        "operation": "executeQuery",
        "query": "UPDATE contacts SET telegram_chat_id = $1::bigint, telegram_linked_at = now(), dnc_telegram = false, updated_at = now()\nWHERE telegram_link_token = $2 AND is_archived = false\nRETURNING id, first_name;",
        "options": {
          "queryReplacement": "={{ [ $json.chatId, $json.token ] }}"
        }
      },
