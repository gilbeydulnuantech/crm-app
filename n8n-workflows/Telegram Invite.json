    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r || !r.id) return [{ json: { success: false, error: 'Contact not found, or you do not have access to it.' } }];\nconst username = (r.bot_username || '').toString().trim().replace(/^@/, '');\nconst configured = !!username;\nreturn [{ json: {\n  success: true,\n  configured,\n  linked: r.linked === true,\n  linked_at: r.telegram_linked_at || null,\n  opted_out: r.dnc_telegram === true,\n  invite_url: configured && r.telegram_link_token ? `https://t.me/${username}?start=${r.telegram_link_token}` : null,\n} }];"
      },
