    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r.valid || !r.active) throw new Error('Invalid session.');\nconst contactId = parseInt($('Webhook: get-telegram-invite').first().json.query.contact_id, 10);\nif (!Number.isInteger(contactId)) throw new Error('\"contact_id\" is required.');\nreturn [{ json: { contactId, userId: r.userId, role: r.role } }];"
      },
      "id": "52076851-7142-4dfd-90b3-26a15c64478a",
      "name": "Validate Session: get-telegram-invite",
