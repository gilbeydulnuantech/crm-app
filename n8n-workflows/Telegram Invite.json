      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id, c.telegram_link_token, (c.telegram_chat_id IS NOT NULL) AS linked, c.telegram_linked_at, c.dnc_telegram,\n  (SELECT config->>'bot_username' FROM integrations WHERE provider = 'telegram' AND is_active = true LIMIT 1) AS bot_username\nFROM contacts c\nWHERE c.id = $1 AND c.is_archived = false AND ($2 = 'admin' OR c.owner_id = $3);",
        "options": {
          "queryReplacement": "={{ [ $json.contactId, $json.role, $json.userId ] }}"
        }
      },
