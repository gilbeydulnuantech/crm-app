      "name": "Webhook - Track Email Open",
      "webhookId": "email-open-tracking-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Public, unauthenticated by design \u2014 this is hit directly by an email\n// client loading an <img> tag, which can't send auth headers. id/contact_id\n// are internal correlation values (not real secrets); worst case of someone\n// guessing one is a fake 'opened' event on a purely informational metric.\nconst q = $('Webhook - Track Email Open').first().json.query || {};\nconst id = (q.id || '').toString().trim();\nconst contactId = parseInt(q.contact_id, 10);\nreturn [{ json: { id, contactId: Number.isInteger(contactId) ? contactId : null, valid: Boolean(id) && Number.isInteger(contactId) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "email-open-parse-params",
      "name": "Parse Params"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE contacts\nSET email_logs = (\n  SELECT COALESCE(jsonb_agg(\n    CASE WHEN elem->>'id' = $1 AND elem->>'opened_at' IS NULL\n      THEN elem || jsonb_build_object('opened_at', NOW())\n      ELSE elem\n    END\n  ), '[]'::jsonb)\n  FROM jsonb_array_elements(COALESCE(email_logs, '[]'::jsonb)) AS elem\n)\nWHERE id = $2 AND $3 = true;",
        "options": {
          "queryReplacement": "={{ [ $json.id, $json.contactId, $json.valid ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        0
      ],
      "id": "email-open-mark",
      "name": "Mark Email Opened",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// The smallest valid transparent 1x1 GIF, hardcoded \u2014 this endpoint's\n// only job is to always return an image, whether or not the update above\n// actually matched anything (e.g. a stale/invalid id), so a broken pixel\n// never shows up as a broken-image icon in the recipient's email client.\nconst base64 = 'R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==';\nreturn [{ json: {}, binary: { data: { data: base64, mimeType: 'image/gif', fileName: 'pixel.gif' } } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
