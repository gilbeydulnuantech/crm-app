    {
      "parameters": {
        "jsCode": "const user = $input.first().json;\n\nif (!user.id || !user.active) {\n  throw new Error('Invalid session.');\n}\n\n// Reuses this same get-contacts webhook for both the active list and the\n// Archived tab:\n//   GET /webhook/get-contacts?archived=false   (All Contacts / My Contacts)\n//   GET /webhook/get-contacts?archived=true    (Archived tab)\nconst webhookQuery = $('Webhook').first().json.query || {};\nconst showArchived = String(webhookQuery.archived || '').toLowerCase() === 'true';\n\n// archived_by_name is only meaningful (and only joined) for the archived\n// view — harmless left join either way, just always null when not archived.\n// tags is embedded via json_agg so the Contacts table can render them\n// without an extra get-entity-tags round trip per row (taggables/tags\n// schema matches contacts-Tags System.json).\nconst sqlQuery = `\n  SELECT c.*, co.name AS company_name, u.name AS owner_name,\n         ab.name AS archived_by_name,\n         (SELECT COALESCE(json_agg(json_build_object('id', t.id, 'name', t.name)), '[]'::json)\n          FROM taggables tg JOIN tags t ON t.id = tg.tag_id\n          WHERE tg.entity_type = 'contact' AND tg.entity_id = c.id) AS tags\n  FROM contacts c\n  LEFT JOIN companies co ON co.id = c.account_id\n  LEFT JOIN users u ON u.id = c.owner_id\n  LEFT JOIN users ab ON ab.id = c.archived_by\n  WHERE c.is_archived = $1\n  ORDER BY c.id;\n`;\n\nreturn [{ json: { sqlQuery, queryParams: [showArchived] } }];\n"
      },
