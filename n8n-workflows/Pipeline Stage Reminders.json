      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2080,
        704
      ],
      "notes": "Full-replace edit pattern, same as nurture sequence steps: every save clears and re-inserts all steps rather than diffing.",
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
