      "parameters": {
        "operation": "executeQuery",
        "query": "WITH deleted AS (\n  DELETE FROM pipeline_stage_reminder_steps WHERE rule_id = $1 RETURNING id\n)\nSELECT $1 AS rule_id;",
        "options": {
          "queryReplacement": "={{ [ $json.id ] }}"
        }
      },
      "id": "psr1f0012-1212-4a5a-9b1a-pstrem0000012",
