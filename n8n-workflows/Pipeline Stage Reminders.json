    {
      "parameters": {
        "jsCode": "const ruleId = $('Upsert Rule').first().json.id;\nconst steps = $('Validate Admin & Payload (Save)').first().json.steps;\nreturn steps.map((s) => ({ json: { ruleId, ...s } }));"
