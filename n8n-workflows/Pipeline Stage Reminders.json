    {
      "parameters": {
        "httpMethod": "POST",
        "path": "save-stage-reminder",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "psr1f0007-7777-4a5a-9b1a-pstrem0000007",
      "name": "Webhook - Save Stage Reminder",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        960,
        704
      ],
      "onError": "continueErrorOutput",
      "webhookId": "cfd6434f-b2d2-4826-8611-6a1f0cd7dabc"
    },
    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nconst body = $('Webhook - Save Stage Reminder').first().json.body || {};\n\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nif (requester.role !== 'admin') throw new Error('Admin access required.');\n\nconst id = body.id ? parseInt(body.id, 10) : null;\nconst name = (body.name || '').toString().trim();\nconst stageId = parseInt(body.stage_id, 10);\nconst steps = Array.isArray(body.steps) ? body.steps : [];\n\nif (!name) throw new Error('\"name\" is required.');\nif (!Number.isInteger(stageId)) throw new Error('\"stage_id\" is required.');\nif (steps.length === 0) throw new Error('At least one reminder step is required.');\n\nconst cleanSteps = steps.map((s, i) => {\n  const offsetHours = parseInt(s.offset_hours, 10);\n  const subject = (s.email_subject || '').toString().trim();\n  const emailBody = (s.email_body || '').toString();\n  if (!Number.isInteger(offsetHours)) throw new Error(`Step ${i + 1}: \"offset_hours\" must be an integer (positive = before appointment, negative = after).`);\n  if (!subject) throw new Error(`Step ${i + 1}: subject is required.`);\n  if (!emailBody.trim()) throw new Error(`Step ${i + 1}: email body is required.`);\n  return { offsetHours, subject, emailBody };\n});\n\nconst onCompleteAdvanceStageId = body.on_complete_advance_stage_id ? parseInt(body.on_complete_advance_stage_id, 10) : null;\nconst onCompleteEmailSubject = (body.on_complete_email_subject || '').toString().trim() || null;\nconst onCompleteEmailBody = (body.on_complete_email_body || '').toString().trim() || null;\nif (onCompleteAdvanceStageId !== null && !Number.isInteger(onCompleteAdvanceStageId)) throw new Error('\"on_complete_advance_stage_id\" must be an integer.');\nif ((onCompleteEmailSubject && !onCompleteEmailBody) || (!onCompleteEmailSubject && onCompleteEmailBody)) throw new Error('The \"after inspection\" email needs both a subject and a body.');\n\nreturn [{ json: { id, name, stageId, steps: cleanSteps, onCompleteAdvanceStageId, onCompleteEmailSubject, onCompleteEmailBody, requesterId: requester.id } }];"
      },
      "id": "psr1f0010-1010-4a5a-9b1a-pstrem0000010",
      "name": "Validate Admin & Payload (Save)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1632,
        704
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO pipeline_stage_reminders (id, name, stage_id, on_complete_advance_stage_id, on_complete_email_subject, on_complete_email_body, is_active, created_by, created_at, updated_at)\nVALUES (COALESCE($1, nextval(pg_get_serial_sequence('pipeline_stage_reminders', 'id'))), $2, $3, $4, $5, $6, true, $7, now(), now())\nON CONFLICT (id) DO UPDATE SET\n  name = EXCLUDED.name,\n  stage_id = EXCLUDED.stage_id,\n  on_complete_advance_stage_id = EXCLUDED.on_complete_advance_stage_id,\n  on_complete_email_subject = EXCLUDED.on_complete_email_subject,\n  on_complete_email_body = EXCLUDED.on_complete_email_body,\n  updated_at = now()\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.id, $json.name, $json.stageId, $json.onCompleteAdvanceStageId, $json.onCompleteEmailSubject, $json.onCompleteEmailBody, $json.requesterId ] }}"
        }
      },
      "id": "psr1f0011-1111-4a5a-9b1a-pstrem0000011",
      "name": "Upsert Rule",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
