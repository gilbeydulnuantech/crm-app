    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT r.id, r.name, r.stage_id, s.name AS stage_name, p.id AS pipeline_id, p.name AS pipeline_name, r.is_active, r.created_at,\n  r.on_complete_advance_stage_id, cs.name AS on_complete_advance_stage_name, r.on_complete_email_subject, r.on_complete_email_body,\n  (SELECT COUNT(*) FROM opportunities o WHERE o.stage_id = r.stage_id AND o.is_archived = false AND o.status = 'Open') AS deals_in_stage,\n  (SELECT COALESCE(json_agg(json_build_object('id', st.id, 'offset_hours', st.offset_hours, 'email_subject', st.email_subject, 'email_body', st.email_body) ORDER BY st.offset_hours DESC), '[]'::json)\n   FROM pipeline_stage_reminder_steps st WHERE st.rule_id = r.id) AS steps\nFROM pipeline_stage_reminders r\nJOIN stages s ON s.id = r.stage_id\nJOIN pipelines p ON p.id = s.pipeline_id\nLEFT JOIN stages cs ON cs.id = r.on_complete_advance_stage_id\nORDER BY r.created_at DESC;",
        "options": {}
      },
      "id": "psr1f0005-5555-4a5a-9b1a-pstrem0000005",
      "name": "Select Stage Reminders",
