    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO nurture_sequences (id, name, trigger_inactive_days, exit_on_reply, exit_lead_status, is_active, created_by, created_at, updated_at)\nVALUES (COALESCE($1, nextval(pg_get_serial_sequence('nurture_sequences', 'id'))), $2, $3, $4, $5, true, $6, now(), now())\nON CONFLICT (id) DO UPDATE SET\n  name = EXCLUDED.name,\n  trigger_inactive_days = EXCLUDED.trigger_inactive_days,\n  exit_on_reply = EXCLUDED.exit_on_reply,\n  exit_lead_status = EXCLUDED.exit_lead_status,\n  updated_at = now()\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.id, $json.name, $json.triggerInactiveDays, $json.exitOnReply, $json.exitLeadStatus, $json.requesterId ] }}"
        }
      },
