        }
      },
      "id": "ns1f0012-1212-4a5a-9b1a-nurseq00000012",
      "name": "Clear Old Steps",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2080,
        704
      ],
      "notes": "Full-replace edit pattern: every save clears and re-inserts all steps rather than diffing \u2014 simplest correct approach for a small, admin-edited step list.",
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const sequenceId = $('Upsert Sequence').first().json.id;\nconst steps = $('Validate Admin & Payload (Save)').first().json.steps;\nreturn steps.map((s) => ({ json: { sequenceId, ...s } }));"
      },
