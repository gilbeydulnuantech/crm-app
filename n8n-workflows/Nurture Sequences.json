    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ns.id, ns.name, ns.trigger_inactive_days, ns.exit_on_reply, ns.exit_lead_status, ns.is_active, ns.created_at,\n  (SELECT COUNT(*) FROM nurture_enrollments ne WHERE ne.sequence_id = ns.id AND ne.status = 'active') AS active_enrollments,\n  (SELECT COALESCE(json_agg(json_build_object('id', s.id, 'step_number', s.step_number, 'delay_days', s.delay_days, 'email_template_id', s.email_template_id, 'email_subject', et.subject, 'email_body', et.body) ORDER BY s.step_number), '[]'::json)\n   FROM nurture_sequence_steps s JOIN email_templates et ON et.id = s.email_template_id WHERE s.sequence_id = ns.id) AS steps\nFROM nurture_sequences ns\nORDER BY ns.created_at DESC;",
        "options": {}
      },
