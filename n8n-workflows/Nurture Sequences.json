    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nconst body = $('Webhook - Save Nurture Sequence').first().json.body || {};\n\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nif (requester.role !== 'admin') throw new Error('Admin access required.');\n\nconst id = body.id ? parseInt(body.id, 10) : null;\nconst name = (body.name || '').toString().trim();\nconst triggerInactiveDays = parseInt(body.trigger_inactive_days, 10);\nconst exitOnReply = body.exit_on_reply !== false;\nconst exitLeadStatus = (body.exit_lead_status || '').toString().trim() || null;\nconst steps = Array.isArray(body.steps) ? body.steps : [];\n\nif (!name) throw new Error('\"name\" is required.');\nif (!Number.isInteger(triggerInactiveDays) || triggerInactiveDays < 1) throw new Error('\"trigger_inactive_days\" must be a positive integer.');\nif (steps.length === 0) throw new Error('At least one email step is required.');\n\n// Email copy lives only in email_templates now — a step just points at one.\nconst cleanSteps = steps.map((s, i) => {\n  const delayDays = parseInt(s.delay_days, 10);\n  const emailTemplateId = parseInt(s.email_template_id, 10);\n  if (!Number.isInteger(delayDays) || delayDays < 0) throw new Error(`Step ${i + 1}: \"delay_days\" must be a non-negative integer.`);\n  if (!Number.isInteger(emailTemplateId)) throw new Error(`Step ${i + 1}: an email template is required.`);\n  return { stepNumber: i + 1, delayDays, emailTemplateId };\n});\n\nreturn [{ json: { id, name, triggerInactiveDays, exitOnReply, exitLeadStatus, steps: cleanSteps, requesterId: requester.id } }];"
      },
      "id": "ns1f0010-1010-4a5a-9b1a-nurseq00000010",
      "name": "Validate Admin & Payload (Save)",
