    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.created_by\nFROM (SELECT $1::int AS pid) dummy\nLEFT JOIN pages p ON p.id = dummy.pid;",
        "options": {
          "queryReplacement": "={{ [ $('Webhook - Save Page').first().json.body.id || null ] }}"
        }
      },
      "id": "page0010-1010-4a5a-9b1a-pagesid00010",
      "name": "Look Up Existing Page (Save)",
      "type": "n8n-nodes-base.postgres",
