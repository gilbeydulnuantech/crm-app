    {
      "parameters": {
        "jsCode": "const existing = $input.item.json;\nconst requester = $('Look Up Requester (Delete)').first().json;\nconst body = $('Webhook - Delete Page').first().json.body || {};\n\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\n\nconst id = parseInt(body.id, 10);\nif (!Number.isInteger(id)) throw new Error('\"id\" must be an integer.');\nif (existing.created_by != null && requester.role !== 'admin' && existing.created_by !== requester.id) {\n  throw new Error('Only an admin or the page\\'s creator can delete it.');\n}\n\nreturn [{ json: { id } }];"
