    {
      "parameters": {
        "jsCode": "const existing = $input.item.json;\nconst requester = $('Look Up Requester (Save)').first().json;\nconst body = $('Webhook - Save Page').first().json.body || {};\n\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\n\nconst id = body.id ? parseInt(body.id, 10) : null;\nif (id && existing.created_by != null && requester.role !== 'admin' && existing.created_by !== requester.id) {\n  throw new Error('Only an admin or the page\\'s creator can edit it.');\n}\n\nconst name = (body.name || '').toString().trim();\nconst contentHtml = (body.content_html || '').toString();\n\nif (!name) throw new Error('\"name\" is required.');\nif (!contentHtml.trim()) throw new Error('Page content is required.');\n\nreturn [{ json: { id, name, contentHtml, requesterId: requester.id } }];"
      },
      "id": "page0011-1111-4a5a-9b1a-pagesid00011",
      "name": "Validate & Payload (Save)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
