      ],
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nif (requester.role !== 'admin') throw new Error('Only an admin can set a branch location.');\nconst body = $('Webhook: update-user-location').first().json.body || {};\nconst userId = parseInt(body.user_id, 10);\nif (!Number.isInteger(userId)) throw new Error('\"user_id\" must be an integer.');\nconst location = (typeof body.location === 'string' ? body.location : '').replace(/[\\u0000-\\u001f\\u007f]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 60);\nreturn [{ json: { userId, location } }];"
      },
      "onError": "continueErrorOutput"
    },
