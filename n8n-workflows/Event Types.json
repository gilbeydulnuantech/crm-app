    {
      "id": "efc5ff2b-be75-4894-a676-af5d710e54d8",
      "name": "Check Payload (delete)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        400
      ],
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nif (requester.role !== 'admin') throw new Error('Only an admin can delete an event type.');\nconst body = $('Webhook: delete-event-type').first().json.body || {};\nconst id = parseInt(body.id, 10);\nif (!Number.isInteger(id)) throw new Error('\"id\" must be an integer.');\nconst reassign = body.reassign_to_id ? parseInt(body.reassign_to_id, 10) : null;\nif (body.reassign_to_id && !Number.isInteger(reassign)) throw new Error('\"reassign_to_id\" must be an integer.');\nif (reassign === id) throw new Error('Choose a different event type to move the events to.');\nreturn [{ json: { id, reassign } }];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "69220393-b04b-440a-936c-fb0f1cd01df5",
      "name": "Query (delete)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1440,
        400
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH tgt AS (SELECT id, key, is_system FROM event_types WHERE id = $1::int),\ndest AS (SELECT id, key FROM event_types WHERE id = $2::int),\nchk AS (\n  SELECT\n    (SELECT count(*) FROM tgt) AS found,\n    (SELECT is_system FROM tgt) AS is_system,\n    (SELECT count(*) FROM activities a, tgt WHERE a.type = tgt.key AND a.due_at IS NOT NULL) AS events,\n    (SELECT count(*) FROM dest) AS dest_found\n), ok AS (\n  SELECT * FROM chk WHERE found = 1 AND is_system IS NOT TRUE AND (events = 0 OR dest_found = 1)\n), mv AS (\n  UPDATE activities SET type = (SELECT key FROM dest) WHERE type = (SELECT key FROM tgt) AND EXISTS (SELECT 1 FROM ok) AND (SELECT dest_found FROM chk) = 1 RETURNING id\n), pm AS (\n  UPDATE products SET event_type_id = (SELECT id FROM dest) WHERE event_type_id = $1::int AND EXISTS (SELECT 1 FROM ok) RETURNING id\n), del AS (\n  DELETE FROM event_types WHERE id = $1::int AND EXISTS (SELECT 1 FROM ok) RETURNING id\n)\nSELECT (SELECT count(*) FROM del) AS deleted, (SELECT found FROM chk) AS found, (SELECT is_system FROM chk) AS is_system, (SELECT events FROM chk) AS events, (SELECT dest_found FROM chk) AS dest_found, (SELECT count(*) FROM mv) AS moved;",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [ $json.id, $json.reassign ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      },
      "onError": "continueErrorOutput",
      "alwaysOutputData": false
    },
    {
      "id": "0eb37ae4-65c8-4e84-a5d9-506f32674b96",
      "name": "Respond (delete)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1680,
        340
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ (() => { const r = $input.first().json; if (Number(r.deleted) === 1) return { success: true, moved: Number(r.moved) }; if (Number(r.found) === 0) return { success: false, error: 'That event type was not found.' }; if (r.is_system === true) return { success: false, error: 'This type is used by the booking page and reminders, so it can be renamed but not deleted.' }; if (Number(r.events) > 0 && Number(r.dest_found) !== 1) return { success: false, error: 'This type is used by ' + r.events + ' event(s). Choose another type to move them to.' }; return { success: false, error: 'Could not delete this event type.' }; })() }}",
        "options": {}
      }
    }
