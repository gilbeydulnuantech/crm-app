    {
      "id": "448f5a42-8471-4de7-8299-b11521bafee0",
      "name": "Validate Session (delete)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        400
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r.valid) throw new Error('Invalid session.');\n\nreturn [{ json: { id: r.userId, role: r.role, name: r.user?.name, active: r.active } }];"
      },
      "onError": "continueErrorOutput"
