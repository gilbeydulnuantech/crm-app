    {
      "id": "8d14ebf9-1d6c-46fd-8fa4-37586ff68731",
      "name": "Check Payload (save)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        200
      ],
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nconst body = $('Webhook: save-event-type').first().json.body || {};\nconst id = body.id ? parseInt(body.id, 10) : null;\nif (body.id && !Number.isInteger(id)) throw new Error('\"id\" must be an integer.');\nconst name = (typeof body.name === 'string' ? body.name : '').replace(/[\\u0000-\\u001f\\u007f]/g, ' ').replace(/\\s+/g, ' ').trim();\nif (!name) throw new Error('Give this event type a name.');\nif (name.length > 60) throw new Error('The name is too long (maximum 60 characters).');\nconst color = typeof body.color === 'string' && /^#[0-9a-fA-F]{6}$/.test(body.color.trim()) ? body.color.trim().toUpperCase() : null;\n// The key is what events store. It is made once from the first name and never changes, so renaming is safe.\nlet key = name.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '').slice(0, 40);\nif (!key) key = 'type';\nreturn [{ json: { id, name, color, key, requesterId: requester.id } }];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "7994d274-c6c2-44a5-a730-f32c9852c91c",
      "name": "Query (save)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1440,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH base AS (SELECT $4::text AS key),\nfree AS (\n  SELECT CASE WHEN EXISTS (SELECT 1 FROM event_types WHERE key = b.key)\n              THEN b.key || '_' || (SELECT COALESCE(max(id), 0) + 1 FROM event_types) ELSE b.key END AS key\n  FROM base b\n), upd AS (\n  UPDATE event_types SET name = $2, color = COALESCE($3, color) WHERE id = $1::int RETURNING id, key\n), ins AS (\n  INSERT INTO event_types (key, name, color, sort_order, created_by)\n  SELECT (SELECT key FROM free), $2, COALESCE($3, '#64748B'), COALESCE((SELECT max(sort_order) + 1 FROM event_types), 0), $5::int\n  WHERE $1::int IS NULL\n  RETURNING id, key\n)\nSELECT id, key FROM upd UNION ALL SELECT id, key FROM ins;",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [ $json.id, $json.name, $json.color, $json.key, $json.requesterId ] }}"
        }
      },
      "credentials": {
