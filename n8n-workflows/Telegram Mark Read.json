        "operation": "executeQuery",
        "query": "UPDATE entity_activity_log l\nSET detail = COALESCE(l.detail, '{}'::jsonb) || '{\"is_read\": true}'::jsonb\nFROM contacts c\nWHERE l.id = $1 AND l.category = 'telegram' AND l.entity_type = 'contact'\n  AND c.id = l.entity_id AND ($2 = 'admin' OR c.owner_id = $3)\nRETURNING l.id;",
