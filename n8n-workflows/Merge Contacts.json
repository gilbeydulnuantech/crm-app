    {
      "parameters": {
        "jsCode": "const headers = $input.first().json.headers || {};\nconst authHeader = headers['authorization'] || headers['Authorization'] || '';\nconst token = authHeader.replace('Bearer ', '').trim();\n\nconst match = token.match(/^token_(\\d+)_(\\d+)$/);\nif (!match) throw new Error('Invalid or missing session token.');\n\nconst requesterId = parseInt(match[1], 10);\nconst body = $input.first().json.body || {};\n// 'primary' is the contact that survives; 'duplicate' gets archived after\n// everything of value on it (deals, tasks, notes, activity, tags) is\n// reassigned onto primary.\nconst primaryId = parseInt(body.primary_id, 10);\nconst duplicateId = parseInt(body.duplicate_id, 10);\n\nif (!Number.isInteger(primaryId) || !Number.isInteger(duplicateId)) {\n  throw new Error('\"primary_id\" and \"duplicate_id\" must be integers.');\n}\nif (primaryId === duplicateId) {\n  throw new Error('\"primary_id\" and \"duplicate_id\" must be different contacts.');\n}\n\nreturn [{ json: { requesterId, primaryId, duplicateId } }];"
      },
      "id": "e929a629-8509-493e-a84e-dc2c1ca9102a",
