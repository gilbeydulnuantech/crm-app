    {
      "parameters": {
        "jsCode": "const requester = $('Look Up Requester').first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nif (requester.role !== 'admin') throw new Error('Only admins can merge contacts.');\n\nconst { primaryId, duplicateId } = $('Parse Token & Payload').first().json;\nconst rows = $input.all().map((i) => i.json);\nconst primary = rows.find((r) => r.id === primaryId);\nconst duplicate = rows.find((r) => r.id === duplicateId);\nif (!primary || !duplicate) {\n  throw new Error('One or both contacts were not found.');\n}\n\nconst duplicateName = `${duplicate.first_name || ''} ${duplicate.last_name || ''}`.trim() || 'Unknown Contact';\nconst primaryName = `${primary.first_name || ''} ${primary.last_name || ''}`.trim() || 'Unknown Contact';\n\n// email_logs is a jsonb array column on each row \u2014 concatenate rather\n// than picking one side, so replies/sends recorded against the\n// duplicate aren't silently lost.\nconst primaryLogs = Array.isArray(primary.email_logs) ? primary.email_logs : [];\nconst duplicateLogs = Array.isArray(duplicate.email_logs) ? duplicate.email_logs : [];\nconst mergedEmailLogsJson = JSON.stringify([...primaryLogs, ...duplicateLogs]);\n\nconst summary = `${requester.name || 'Someone'} merged \"${duplicateName}\" (contact #${duplicateId}) into this contact`;\nconst detail = JSON.stringify({ merged_contact_id: duplicateId, merged_contact_name: duplicateName });\n\nreturn [{\n  json: {\n    primaryId, duplicateId, mergedEmailLogsJson, summary, detail,\n    requesterId: requester.id, requesterName: requester.name || 'Someone',\n    duplicateName, primaryName,\n  }\n}];"
      },
