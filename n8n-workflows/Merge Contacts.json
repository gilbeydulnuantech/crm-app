    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, first_name, last_name, email_logs FROM contacts WHERE id = $1 OR id = $2;",
        "options": {
          "queryReplacement": "={{ [ $('Parse Token & Payload').first().json.primaryId, $('Parse Token & Payload').first().json.duplicateId ] }}"
        }
      },
      "id": "1236c0ca-b046-42b3-a2de-3b4029402c8c",
      "name": "Look Up Both Contacts",
      "type": "n8n-nodes-base.postgres",
