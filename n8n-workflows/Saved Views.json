        "query": "SELECT sv.id, sv.entity_type, sv.name, sv.filters, sv.created_at, sv.user_id, sv.is_shared, u.name AS owner_name\nFROM saved_views sv\nJOIN users u ON u.id = sv.user_id\nWHERE sv.entity_type = $2 AND (sv.user_id = $1 OR sv.is_shared = true)\nORDER BY sv.created_at ASC;",
