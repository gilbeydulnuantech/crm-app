        "path": "pipeline-create-new",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "c9e1a001-1111-4a5a-9b1a-pipecreatenew1",
      "name": "Webhook: pipeline-create-new",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        816,
        1808
      ],
      "webhookId": "c9e1a001-1111-4a5a-9b1a-webhookpcn001"
    },
    {
      "parameters": {
        "jsCode": "// No auth chain elsewhere in this workflow (add-opportunity, delete-\n// opportunities etc. are all unauthenticated too) \u2014 matching that existing\n// convention rather than introducing an inconsistent new pattern here.\nconst body = $json.body || {};\n\nconst name = (body.name || '').toString().trim();\nif (!name) {\n  throw new Error('\"name\" is required.');\n}\n\nconst isDefault = body.is_default === true || body.is_default === 'true';\n\nconst stagesInput = Array.isArray(body.stages) ? body.stages : [];\nconst stages = stagesInput\n  .map((s, i) => ({\n    name: (s.name || '').toString().trim(),\n    win_probability: Number(s.win_probability) || 0,\n    display_order: i + 1,\n  }))\n  .filter((s) => s.name);\n\nif (stages.length === 0) {\n  throw new Error('At least one stage is required.');\n}\n\nreturn [{ json: { name, isDefault, stages } }];"
      },
      "id": "c9e1a002-2222-4a5a-9b1a-pipecreatenew2",
      "name": "Validate & Build Stages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        1808
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE pipelines SET is_default = false WHERE $1::boolean = true;",
        "options": {
          "queryReplacement": "={{ [$json.isDefault] }}"
        }
      },
      "id": "c9e1a003-3333-4a5a-9b1a-pipecreatenew3",
      "name": "Postgres: Unset Other Defaults",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1264,
        1808
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO pipelines (name, is_default) VALUES ($1, $2) RETURNING id, name, is_default;",
        "options": {
          "queryReplacement": "={{ [$('Validate & Build Stages').item.json.name, $('Validate & Build Stages').item.json.isDefault] }}"
        }
      },
      "id": "c9e1a004-4444-4a5a-9b1a-pipecreatenew4",
      "name": "Postgres: Insert Pipeline",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1488,
        1808
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// pipelines only has (id, name, is_default) as far as any query in this\n// app has ever selected \u2014 no confirmed created_by/created_at columns, so\n// those aren't written here (add them if your schema actually has them).\nconst pipelineId = $json.id;\nconst validated = $('Validate & Build Stages').item.json;\nconst stages = validated.stages;\n\nconst valuesSql = [];\nconst queryParams = [];\nlet idx = 1;\nfor (const s of stages) {\n  valuesSql.push(`($${idx}, $${idx + 1}, $${idx + 2}, $${idx + 3})`);\n  queryParams.push(pipelineId, s.name, s.win_probability, s.display_order);\n  idx += 4;\n}\n\nconst sqlQuery = `INSERT INTO stages (pipeline_id, name, win_probability, display_order) VALUES ${valuesSql.join(', ')} RETURNING id, pipeline_id, name, win_probability, display_order;`;\n\nreturn [{\n  json: {\n    sqlQuery,\n    queryParams,\n    pipeline_id: pipelineId,\n    pipeline_name: validated.name,\n    is_default: validated.isDefault,\n  },\n}];"
      },
      "id": "c9e1a005-5555-4a5a-9b1a-pipecreatenew5",
      "name": "Build Stage Insert Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1712,
        1808
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.sqlQuery }}",
        "options": {
          "queryReplacement": "={{ $json.queryParams }}"
        }
      },
      "id": "c9e1a006-6666-4a5a-9b1a-pipecreatenew6",
      "name": "Postgres: Insert Stages",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1936,
        1808
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const stageRows = $input.all().map((item) => item.json);\nconst meta = $('Build Stage Insert Query').first().json;\n\nreturn [{\n  json: {\n    id: meta.pipeline_id,\n    name: meta.pipeline_name,\n    is_default: meta.is_default,\n    stages: stageRows,\n  },\n}];"
      },
      "id": "c9e1a007-7777-4a5a-9b1a-pipecreatenew7",
      "name": "Format Pipeline Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        1808
      ]
    },
    {
      "parameters": {
