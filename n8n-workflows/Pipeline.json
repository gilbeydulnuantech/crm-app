    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT o.id, o.name, o.contact_id, TRIM(CONCAT(c.first_name, ' ', c.last_name)) AS contact_name, o.account_id, co.name AS company_name, o.pipeline_id, o.stage_id, o.assigned_user, u.name AS assigned_user_name, u.color AS assigned_user_color, o.created_by, o.deal_value, o.probability, o.status, o.expected_close, o.closed_at, o.created_at, o.updated_at,\n  (SELECT COALESCE(json_agg(json_build_object('id', t.id, 'name', t.name) ORDER BY t.id), '[]'::json)\n   FROM taggables tg JOIN tags t ON t.id = tg.tag_id\n   WHERE tg.entity_type = 'opportunity' AND tg.entity_id = o.id) AS tags\nFROM opportunities o LEFT JOIN contacts c ON c.id = o.contact_id LEFT JOIN companies co ON co.id = o.account_id LEFT JOIN users u ON u.id = o.assigned_user WHERE o.pipeline_id = $1 ORDER BY o.created_at DESC, o.id DESC;",
        "options": {
