        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 201
        }
      },
      "id": "c9e1a008-8888-4a5a-9b1a-pipecreatenew8",
      "name": "Respond: pipeline-create-new",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        2384,
        1808
      ]
    },
    {
      "parameters": {
        "jsCode": "const headers = $input.first().json.headers || {};\nconst authHeader = headers['authorization'] || headers['Authorization'] || '';\nconst token = authHeader.replace('Bearer ', '').trim();\n\nconst match = token.match(/^token_(\\d+)_(\\d+)$/);\nif (!match) throw new Error('Invalid or missing session token.');\n\nreturn [{ json: { requesterId: parseInt(match[1], 10) } }];"
      },
      "id": "08e61a56-3cda-48ad-af9b-cadd71a74962",
      "name": "Parse Token: update-opportunity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        916,
        1132
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, role, active FROM users WHERE id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $json.requesterId ] }}"
        }
      },
      "id": "9cc10f19-1712-49c3-a179-30824c0ee110",
      "name": "Look Up Requester: update-opportunity",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1116,
        1132
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first();\nif (!result || !result.json || !result.json.id) {\n  throw new Error(\"Deal not found or you do not have permission to edit it.\");\n}\nreturn [{ json: { success: true, ...result.json } }];"
      },
      "id": "290375c6-2df2-430b-8eb0-a6e180f297b3",
      "name": "Check Result: update-opportunity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1516,
        1132
      ]
    },
    {
      "parameters": {
