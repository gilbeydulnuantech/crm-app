        "operation": "executeQuery",
        "query": "SELECT c.id, c.name, c.website, c.industry, c.city, c.state, c.country, c.street_address, c.zip_code, c.phone, c.owner_id, u.name AS owner_name, u.color AS owner_color, c.parent_company_id, pc.name AS parent_company_name, c.tier, c.account_status, c.account_health, c.annual_revenue, c.employee_count, c.territory, c.se_user_id, se.name AS se_user_name, c.csm_user_id, csm.name AS csm_user_name, c.created_by, c.is_archived, c.created_at, c.updated_at, COALESCE(cc.contact_count, 0) AS contact_count, COALESCE(oc.opportunity_count, 0) AS opportunity_count FROM companies c LEFT JOIN users u ON u.id = c.owner_id LEFT JOIN companies pc ON pc.id = c.parent_company_id LEFT JOIN users se ON se.id = c.se_user_id LEFT JOIN users csm ON csm.id = c.csm_user_id LEFT JOIN (SELECT account_id, COUNT(*) AS contact_count FROM contacts WHERE is_archived = false GROUP BY account_id) cc ON cc.account_id = c.id LEFT JOIN (SELECT account_id, COUNT(*) AS opportunity_count FROM opportunities GROUP BY account_id) oc ON oc.account_id = c.id WHERE c.is_archived = false ORDER BY c.name ASC;",
