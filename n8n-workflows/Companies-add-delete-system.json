    {
      "parameters": {
        "jsCode": "const requesterId = $('Parse Token: update-companies').first().json.requesterId;\nconst before = $('Postgres: Capture Before Owner: update-companies').first().json;\nconst after = $('Postgres: Update Company').first().json;\nconst oldOwnerId = before ? before.owner_id : null;\nconst newOwnerId = after.owner_id;\n// Only notify on an actual reassignment to someone else \u2014 not a\n// no-op resave of the same owner, and not an admin assigning themselves.\nconst notify = !!newOwnerId && newOwnerId !== oldOwnerId && newOwnerId !== requesterId;\nconst dmKey = notify ? [requesterId, newOwnerId].sort((a, b) => a - b).join('-') : null;\nreturn [{ json: { notify, dmKey, requesterId, ownerId: newOwnerId, companyId: after.id, companyName: after.name || 'a company' } }];"
      },
