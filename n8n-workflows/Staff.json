      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT sm.id, sm.owner_user_id, u.name AS owner_name, sm.name, sm.phone, sm.email, sm.color, sm.is_active, sm.bookable_online, sm.commission_percent::float AS commission_percent,\n  (SELECT count(*)::int FROM activities a WHERE a.staff_id = sm.id AND a.due_at IS NOT NULL) AS event_count\nFROM staff_members sm LEFT JOIN users u ON u.id = sm.owner_user_id\nWHERE $2::boolean OR sm.owner_user_id = $1::int\nORDER BY lower(u.name), lower(sm.name);",
        "options": {
