    {
      "id": "468be72b-0613-4cd4-9ee4-f6d9ca619c93",
      "name": "Check Payload (save)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        200
      ],
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nconst body = $('Webhook: save-staff').first().json.body || {};\nconst clean = (v, max) => (typeof v === 'string' || typeof v === 'number' ? String(v) : '').replace(/[\\u0000-\\u001f\\u007f]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, max);\nconst id = body.id ? parseInt(body.id, 10) : null;\nif (body.id && !Number.isInteger(id)) throw new Error('\"id\" must be an integer.');\nconst name = clean(body.name, 100);\nif (!name) throw new Error('Give this staff member a name.');\nconst email = clean(body.email, 255).toLowerCase();\nif (email && !/^[^\\s@<>]+@[^\\s@<>]+\\.[^\\s@<>]{2,}$/.test(email)) throw new Error('That email address does not look valid.');\nconst phone = clean(body.phone, 50);\nconst color = typeof body.color === 'string' && /^#[0-9a-fA-F]{6}$/.test(body.color.trim()) ? body.color.trim().toUpperCase() : null;\nconst isActive = body.is_active === false || body.is_active === 'false' ? false : true;\nconst bookable = body.bookable_online === true || body.bookable_online === 'true' ? true : body.bookable_online === false || body.bookable_online === 'false' ? false : null;\nlet commission = null;\nif (body.commission_percent !== undefined && body.commission_percent !== null && body.commission_percent !== '') {\n  commission = Number(body.commission_percent);\n  if (!Number.isFinite(commission) || commission < 0 || commission > 100) throw new Error('Commission must be between 0 and 100 percent.');\n  commission = Math.round(commission * 100) / 100;\n}\nconst isAdmin = requester.role === 'admin';\n// Only an admin can create staff for someone else; everyone else's staff belong to themselves.\nconst ownerId = isAdmin && parseInt(body.owner_user_id, 10) > 0 ? parseInt(body.owner_user_id, 10) : requester.id;\nreturn [{ json: { id, name, email, phone, color, isActive, bookable, commission, ownerId, requesterId: requester.id, isAdmin } }];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "42aad7b1-e681-457b-8dfe-a85a529a6674",
      "name": "Query (save)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1440,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH upd AS (\n  UPDATE staff_members SET name = $2, email = NULLIF($3, ''), phone = NULLIF($4, ''), color = COALESCE($5, color), is_active = $6::boolean, bookable_online = COALESCE($10::boolean, bookable_online), commission_percent = COALESCE($11::numeric, commission_percent)\n  WHERE id = $1::int AND ($8::boolean OR owner_user_id = $7::int) RETURNING id\n), ins AS (\n  INSERT INTO staff_members (owner_user_id, name, email, phone, color, is_active, bookable_online, commission_percent)\n  SELECT $9::int, $2, NULLIF($3, ''), NULLIF($4, ''), $5, $6::boolean, COALESCE($10::boolean, false), COALESCE($11::numeric, 30) WHERE $1::int IS NULL RETURNING id\n)\nSELECT id FROM upd UNION ALL SELECT id FROM ins;",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [ $json.id, $json.name, $json.email, $json.phone, $json.color, $json.isActive, $json.requesterId, $json.isAdmin, $json.ownerId, $json.bookable, $json.commission ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      },
