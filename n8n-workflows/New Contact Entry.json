    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook: add-contact-public').first().json.body || {};\n\n// Honeypot \u2014 a real visitor never fills this (hidden via CSS on the\n// public form); a bot filling every field will. Silently pretend\n// success without touching the database.\nif ((body.website_hp || '').toString().trim()) {\n  return [{ json: { spam: true } }];\n}\n\nconst firstName = (body.first_name || '').toString().trim();\nconst lastName = (body.last_name || '').toString().trim();\nconst email = (body.email || '').toString().trim().toLowerCase();\nconst phone = (body.phone || '').toString().trim();\nconst jobTitle = (body.job_title || '').toString().trim();\nconst leadSource = (body.lead_source || 'Website Form').toString().trim();\n\nif (!firstName) throw new Error('\"first_name\" is required.');\nif (!email && !phone) throw new Error('Either \"email\" or \"phone\" is required.');\nif (email && !email.includes('@')) throw new Error('\"email\" is not valid.');\n\nreturn [{\n  json: {\n    spam: false, source: 'public',\n    first_name: firstName, last_name: lastName, email, secondary_email: '', phone, secondary_phone: '',\n    job_title: jobTitle, account_id: null, linkedin_url: '', city: '', state: '', zip_code: '', country: '',\n    lead_status: 'New', lead_source: leadSource, timezone: '',\n    do_not_contact: false, dnc_email: false, dnc_call: false, dnc_sms: false,\n    ownerId: null, createdBy: null,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
