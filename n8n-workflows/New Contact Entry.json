      "parameters": {
        "jsCode": "// A resubmission / repeat manual-add of the same email updates the\n// existing lead instead of creating a duplicate or rejecting outright \u2014\n// consistent dedup-by-email across both entry points now.\nconst payload = $('Normalize Payload').item.json;\nconst existing = $input.first().json;\nreturn [{ json: { ...payload, existingContactId: existing?.id || null } }];"
      },
