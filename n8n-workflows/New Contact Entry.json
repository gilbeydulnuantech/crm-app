    },
    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nconst body = $('Webhook: add-contact').first().json.body || {};\n\nconst firstName = (body.first_name || '').toString().trim();\nif (!firstName) throw new Error('\"first_name\" is required.');\nconst rawOwnerId = (body.owner_id === undefined || body.owner_id === null || body.owner_id === '') ? null : parseInt(body.owner_id, 10);\n// Only an admin may hand a brand-new contact to someone else at creation time.\nconst ownerId = (requester.role === 'admin' && Number.isInteger(rawOwnerId)) ? rawOwnerId : requester.id;\n\nreturn [{\n  json: {\n    spam: false, source: 'manual', requesterId: requester.id,\n    first_name: firstName, last_name: (body.last_name || '').toString().trim(),\n    email: (body.email || '').toString().trim().toLowerCase(), secondary_email: (body.secondary_email || '').toString().trim(),\n    phone: (body.phone || '').toString().trim(), secondary_phone: (body.secondary_phone || '').toString().trim(),\n    job_title: (body.job_title || '').toString().trim(), account_id: body.account_id ? parseInt(body.account_id, 10) : null,\n    linkedin_url: (body.linkedin_url || '').toString().trim(), city: (body.city || '').toString().trim(),\n    state: (body.state || '').toString().trim(), zip_code: (body.zip_code || '').toString().trim(), country: (body.country || '').toString().trim(),\n    lead_status: (body.lead_status || 'New').toString().trim(), lead_source: (body.lead_source || '').toString().trim(),\n    timezone: (body.timezone || '').toString().trim(),\n    do_not_contact: body.do_not_contact === true || body.do_not_contact === 'true',\n    dnc_email: body.dnc_email === true || body.dnc_email === 'true',\n    dnc_call: body.dnc_call === true || body.dnc_call === 'true',\n    dnc_sms: body.dnc_sms === true || body.dnc_sms === 'true',\n    ownerId, createdBy: requester.id,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
