    },
    {
      "parameters": {
        "jsCode": "const headers = $input.first().json.headers || {};\nconst authHeader = headers['authorization'] || headers['Authorization'] || '';\nconst token = authHeader.replace('Bearer ', '').trim();\n\nconst match = token.match(/^token_(\\d+)_(\\d+)$/);\nif (!match) {\n  throw new Error('Invalid or missing session token.');\n}\n\nconst requesterId = parseInt(match[1], 10);\n\nreturn [{ json: { requesterId } }];"
      },
      "id": "ce9a2811-4253-400a-9a93-b141a3f90ec8",
      "name": "Parse Requester Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        1088
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, role, active FROM users WHERE id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $json.requesterId ] }}"
        }
      },
      "id": "85b30d63-f8e5-45ca-a8ba-9657bdaecf4d",
      "name": "Look Up Requester Role",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1408,
        1088
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nconst body = $('Webhook - Assign Contact Owner').first().json.body || {};\n\nif (!requester.id || !requester.active) {\n  throw new Error('Invalid session.');\n}\n\nif (requester.role !== 'admin') {\n  throw new Error('Only admins can assign contact owners.');\n}\n\nconst contactId = parseInt(body.contact_id, 10);\nconst ownerIdRaw = body.owner_id;\nconst ownerId = (ownerIdRaw === null || ownerIdRaw === undefined || ownerIdRaw === '')\n  ? null\n  : parseInt(ownerIdRaw, 10);\n\nif (!Number.isInteger(contactId)) {\n  throw new Error('\"contact_id\" must be an integer.');\n}\nif (ownerId !== null && !Number.isInteger(ownerId)) {\n  throw new Error('\"owner_id\" must be an integer or null.');\n}\n\nreturn [{ json: { contactId, ownerId } }];"
      },
      "id": "b797039c-8668-460b-9e16-894146608f81",
      "name": "Validate Admin & Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1632,
        1088
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE contacts\nSET owner_id = $1\nWHERE id = $2\nRETURNING id, owner_id;",
        "options": {
          "queryReplacement": "={{ [ $json.ownerId, $json.contactId ] }}"
        }
      },
      "id": "f6d22997-26b6-43f2-8083-df31ed86d870",
