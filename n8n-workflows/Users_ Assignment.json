    {
      "parameters": {
        "jsCode": "const payload = $('Validate Admin & Payload').first().json;\nconst requesterId = $('Parse Requester Token').first().json.requesterId;\nconst contact = $('Update Contact Owner').first().json;\nconst ownerId = payload.ownerId;\n// Only notify when the deal is actually handed to someone else \u2014 not on\n// unassign (ownerId null) or an admin assigning themselves.\nconst notify = !!ownerId && ownerId !== requesterId;\nconst dmKey = notify ? [requesterId, ownerId].sort((a, b) => a - b).join('-') : null;\nconst contactName = `${contact.first_name || ''} ${contact.last_name || ''}`.trim() || 'a contact';\nreturn [{ json: { notify, dmKey, requesterId, ownerId, contactId: payload.contactId, contactName } }];"
      },
