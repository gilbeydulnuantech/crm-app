    {
      "parameters": {
        "jsCode": "const requesterName = $('Look Up Requester Role').first().json.name || 'Someone';\nconst requesterId = $('Parse Requester Token').first().json.requesterId;\nconst payload = $('Validate Admin & Payload').first().json;\nconst contact = $('Update Contact Owner').first().json;\nconst oldOwnerName = $('Look Up Old Owner').first().json.old_owner_name || 'Unassigned';\nconst newOwnerName = $input.first().json.new_owner_name || 'Unassigned';\nconst contactName = `${contact.first_name || ''} ${contact.last_name || ''}`.trim() || 'Unknown Contact';\n\nif (oldOwnerName === newOwnerName) {\n  // A no-op query that always returns exactly one row — a downstream\n  // Postgres node that yields zero output items would silently stop the\n  // rest of this chain (owner notification DM etc.), so \"SELECT 1;\" is\n  // used instead of an insert with a WHERE-false-style skip.\n  return [{ json: { sqlQuery: 'SELECT 1;', queryParams: [] } }];\n}\n\nconst summary = `${requesterName} transferred ownership of \"${contactName}\" from ${oldOwnerName} to ${newOwnerName}`;\nconst detail = JSON.stringify({ from: oldOwnerName, to: newOwnerName });\n\nconst sqlQuery = 'INSERT INTO entity_activity_log (entity_type, entity_id, category, subtype, summary, detail, actor_id, actor_name) VALUES ($1,$2,$3,$4,$5,$6::jsonb,$7,$8) RETURNING id;';\nconst queryParams = ['contact', payload.contactId, 'system_audit', 'ownership_change', summary, detail, requesterId, requesterName];\n\nreturn [{ json: { sqlQuery, queryParams } }];"
      },
