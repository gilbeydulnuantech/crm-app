        "query": "SELECT (SELECT u.name FROM contacts c JOIN users u ON u.id = c.owner_id WHERE c.id = $1) AS old_owner_name;",
        "options": {
          "queryReplacement": "={{ [ $('Validate Admin & Payload').first().json.contactId ] }}"
