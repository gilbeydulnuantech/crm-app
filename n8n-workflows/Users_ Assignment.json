    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nconst body = $('Webhook - Update User Color').first().json.body || {};\n\nif (!requester.id || !requester.active) {\n  throw new Error('Invalid session.');\n}\n\nconst targetUserId = parseInt(body.user_id, 10);\nif (!Number.isInteger(targetUserId)) {\n  throw new Error('\"user_id\" must be an integer.');\n}\n\n// Admins can recolor anyone; everyone else can only recolor themselves.\nif (requester.role !== 'admin' && requester.id !== targetUserId) {\n  throw new Error('You can only change your own color.');\n}\n\nconst color = (body.color || '').toString().trim();\nif (!/^#[0-9A-Fa-f]{6}$/.test(color)) {\n  throw new Error('\"color\" must be a hex code like #3B82F6.');\n}\n\nreturn [{ json: { targetUserId, color } }];"
      },
