      "name": "Webhook: get-stages",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 180]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, pipeline_id, name, display_order, win_probability FROM stages WHERE pipeline_id = $1 ORDER BY display_order ASC;",
