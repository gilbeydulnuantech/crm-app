    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT i.id AS invoice_id, ct.public_token AS contract_token, c.id AS contact_id, c.email, c.first_name, c.last_name, c.phone, c.dnc_sms, c.unsubscribe_token, o.name AS deal_name FROM invoices i JOIN contracts ct ON ct.opportunity_id = i.opportunity_id JOIN opportunities o ON o.id = i.opportunity_id AND o.is_archived = false AND o.status = 'Open' JOIN contacts c ON c.id = i.contact_id AND c.email IS NOT NULL AND c.email <> '' WHERE i.invoice_type = 'down_payment' AND i.reminder_sent_at IS NULL AND i.created_at <= now() - interval '48 hours' AND NOT EXISTS (SELECT 1 FROM payments p WHERE p.invoice_id = i.id AND p.status = 'succeeded');",
        "options": {}
      },
      "id": "dp-select",
      "name": "Select Unpaid Down Payments Due",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        432,
        1216
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT subject, body FROM email_templates WHERE id = 24;",
        "options": {}
      },
      "id": "dp-lookup-tmpl",
      "name": "Look Up Template: DP Reminder",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        656,
        1216
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const row = $('Select Unpaid Down Payments Due').item.json;\nlet base = '';\ntry { base = $env.FRONTEND_BASE_URL || ''; } catch (e) { base = ''; }\nconst link = `${base}/documents/contract/${row.contract_token}`;\nfunction fill(t) {\n  return (t || '')\n    .replace(/{{\\s*first_name\\s*}}/gi, row.first_name || 'there')\n    .replace(/{{\\s*deal_name\\s*}}/gi, row.deal_name || '')\n    .replace(/{{\\s*contract_link\\s*}}/gi, link);\n}\nconst tmpl = $input.item.json;\nconst unsubUrl = base + '/unsubscribe/' + (row.unsubscribe_token || '');\nconst htmlBody = fill(tmpl.body).replace(/\\n/g, '<br>') + `<br><br><span style=\"font-size:11px;color:#94a3b8\">Don't want these emails? <a href=\"${unsubUrl}\">Unsubscribe</a></span>`;\nreturn [{ json: { to: row.email, subject: fill(tmpl.subject), htmlBody } }];"
      },
      "id": "dp-fill",
      "name": "Fill Email: DP Reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        1216
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Fill Email: DP Reminder').item.json.to }}",
        "subject": "={{ ($('Fill Email: DP Reminder').item.json.subject).replace(/\\{\\{\\s*company_name\\s*\\}\\}/gi, $('Get Company Name: Email: DP Reminder').item.json.company_name) }}",
        "message": "={{ (($('Fill Email: DP Reminder').item.json.htmlBody).replace(/The Team/g, $('Get Company Name: Email: DP Reminder').item.json.company_name + ' Team')).replace(/\\{\\{\\s*company_name\\s*\\}\\}/gi, $('Get Company Name: Email: DP Reminder').item.json.company_name) }}",
        "options": {
          "appendAttribution": false,
          "senderName": "={{ $('Get Company Name: Email: DP Reminder').item.json.company_name }}"
        }
      },
      "id": "dp-send",
      "name": "Send Email: DP Reminder",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1328,
        1216
      ],
      "webhookId": "3c7fafb7-9d6d-461d-8d65-dd59127e3ca4",
      "credentials": {
        "gmailOAuth2": {
          "id": "YE9RFYruaRVVZ6H4",
          "name": "CRMapp"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE contacts SET email_logs = COALESCE(email_logs, '[]'::jsonb) || jsonb_build_object('id', gen_random_uuid()::text, 'type', 'sent', 'subject', $1::text, 'message', $2::text, 'sent_at', NOW(), 'is_read', true) WHERE email = $3;",
        "options": {
          "queryReplacement": "={{ [ ($('Fill Email: DP Reminder').item.json.subject).replace(/\\{\\{\\s*company[._]name\\s*\\}\\}/gi, $('Get Company Name: Email: DP Reminder').item.json.company_name), $('Fill Email: DP Reminder').item.json.htmlBody.replace(/<br\\s*\\/?\\s*>/gi, '\\n').replace(/<[^>]+>/g, '').replace(/The Team/g, $('Get Company Name: Email: DP Reminder').item.json.company_name + ' Team').replace(/\\{\\{\\s*company[._]name\\s*\\}\\}/gi, $('Get Company Name: Email: DP Reminder').item.json.company_name), $('Select Unpaid Down Payments Due').item.json.email ] }}"
        }
      },
      "id": "dp-log",
      "name": "Log Sent Email: DP Reminder",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
