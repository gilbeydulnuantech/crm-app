      "parameters": {
        "jsCode": "const requester = $input.first().json;\nconst { stageName } = $('Validate Session Query').first().json;\n\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\n\nconst sqlQuery = `\n  SELECT DISTINCT c.id\n  FROM contacts c\n  JOIN opportunities o ON o.contact_id = c.id\n  JOIN stages s ON s.id = o.stage_id\n  WHERE s.name = $1\n    AND ($2 = 'admin' OR c.owner_id = $3)\n    AND c.is_archived = false;\n`;\nconst queryParams = [stageName, requester.role, requester.id];\n\nreturn [{ json: { sqlQuery, queryParams } }];"
