    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO messages (conversation_id, sender_id, body) VALUES ($1, $2, $3);",
        "options": {
          "queryReplacement": "={{ [ $json.id, $('Prepare Deal Alert Message').first().json.ownerId, $('Prepare Deal Alert Message').first().json.body ] }}"
        }
