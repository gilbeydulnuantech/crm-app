  "nodes": [
    {
      "id": "tr-webhook",
      "name": "Webhook: run-automation-test",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "91c4f940-cb2d-42aa-8b79-c06e50b8ce83",
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "run-automation-test",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "tr-parse",
      "name": "Parse Token & Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "jsCode": "const headers = $input.first().json.headers || {};\nconst authHeader = headers['authorization'] || headers['Authorization'] || '';\nconst token = authHeader.replace('Bearer ', '').trim();\nif (!token) throw new Error('Invalid or missing session token.');\nconst body = $input.first().json.body || {};\nconst workflowId = (typeof body.workflow_id === 'string' || typeof body.workflow_id === 'number') ? String(body.workflow_id).trim() : '';\nif (!workflowId) throw new Error('\"workflow_id\" is required.');\nif (workflowId.length > 64) throw new Error('\"workflow_id\" is not valid.');\n// The token is only a lookup key; who the caller is comes from the sessions table (Verify Session).\nreturn [{ json: { token, workflowId } }];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "tr-lookup",
      "name": "Look Up Requester",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        640,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name, role, active FROM users WHERE id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $json.userId ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "id": "tr-check-admin",
      "name": "Check Admin",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        860,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "tr-admin-cond",
              "leftValue": "={{ $json.role }}",
              "rightValue": "admin",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "tr-active-cond",
              "leftValue": "={{ $json.active }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
