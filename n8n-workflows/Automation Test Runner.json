    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r.valid || !r.active) throw new Error('Invalid session.');\nreturn [{ json: { userId: r.userId, workflowId: $('Parse Token & Payload').first().json.workflowId } }];"
      },
      "id": "22537095-31c7-4e3e-a0e6-450615573f25",
