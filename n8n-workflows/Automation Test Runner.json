    {
      "id": "tr-parse-results",
      "name": "Parse Node Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        220
      ],
      "parameters": {
        "jsCode": "const exec = $json;\nconst runData = (exec.data && exec.data.resultData && exec.data.resultData.runData) || {};\nconst nodes = Object.entries(runData).map(([name, runs]) => {\n  const run = runs[runs.length - 1];\n  const failed = !!run.error;\n  return {\n    name,\n    status: failed ? 'error' : 'success',\n    error: failed ? (run.error.message || run.error.description || JSON.stringify(run.error).slice(0, 500)) : null,\n    itemCount: !failed && run.data && run.data.main && run.data.main[0] ? run.data.main[0].length : null,\n  };\n});\nconst overallStatus = exec.status || (nodes.some(n => n.status === 'error') ? 'error' : 'success');\nreturn [{ json: { success: true, executionId: exec.id, overallStatus, startedAt: exec.startedAt, stoppedAt: exec.stoppedAt, nodes } }];"
      }
    },
    {
      "id": "tr-respond-ok",
      "name": "Respond: Test Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
