      "position": [
        0,
        0
      ],
      "onError": "continueErrorOutput",
      "notes": "Internal, system-to-system endpoint (no session-token auth), called from the frontend (Pipeline.tsx on stage move, ContactDetailModal.tsx on open, PublicUnsubscribePage.tsx after unsubscribing). Deliberately never reads or writes do_not_contact/dnc_email/dnc_call/dnc_sms \u2014 those fields are only ever touched by a rep directly checking a DNC checkbox (AddContactModal, ContactDetailModal's DND dropdown), never by this rules engine."
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst contactId = parseInt(body.contact_id, 10);\nif (!Number.isInteger(contactId)) throw new Error('\"contact_id\" is required and must be an integer.');\n\nreturn [{ json: {\n  contactId,\n  lastActivity: body.last_activity || null,\n  dealStage: (body.deal_stage || '').toString(),\n} }];"
      },
      "id": "css-0002-parse",
      "name": "Parse & Validate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id\nFROM (SELECT $1::int AS cid) dummy\nLEFT JOIN contacts c ON c.id = dummy.cid;",
        "options": {
          "queryReplacement": "={{ [ $json.contactId ] }}"
        }
      },
      "id": "css-0003-lookup",
      "name": "Look Up Contact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        448,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      },
      "onError": "continueErrorOutput",
      "notes": "Always returns exactly one row (dummy-row LEFT JOIN) even when the contact doesn't exist, so the error branch downstream actually fires instead of the whole chain silently going quiet on zero matched rows."
    },
    {
      "parameters": {
        "jsCode": "const parsed = $('Parse & Validate Payload').first().json;\nconst row = $input.first().json;\nif (!row || !row.id) throw new Error('Contact not found.');\n\n// Only 3 rules \u2014 none of them read or write any DNC field. Evaluated in\n// order, each overwriting the last, so whichever is true furthest down\n// wins when more than one applies. null = no match, leave lead_status as\n// it is.\nlet status = null;\n\n// 1. Deal reached \"inspection done\"\nif (parsed.dealStage.trim().toLowerCase() === 'inspection done') {\n  status = 'Active';\n}\n\n// 2. Deal closed won \u2014 matches both pipelines' naming (\"Closed Won\" /\n// \"closed: won\").\nif (/closed.*won/i.test(parsed.dealStage)) {\n  status = 'Customer';\n}\n\n// 3. No activity in over 6 days\nif (parsed.lastActivity) {\n  const last = new Date(parsed.lastActivity);\n  if (!isNaN(last.getTime())) {\n    const daysSince = (Date.now() - last.getTime()) / 86400000;\n    if (daysSince > 6) status = 'Inactive';\n  }\n}\n\nreturn [{ json: { contactId: row.id, status } }];"
      },
      "id": "css-0004-compute",
      "name": "Compute Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE contacts SET lead_status = COALESCE($1, lead_status), updated_at = now() WHERE id = $2 RETURNING id, lead_status;",
        "options": {
          "queryReplacement": "={{ [ $json.status, $json.contactId ] }}"
        }
      },
      "id": "css-0005-update",
      "name": "Update Contact Status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        896,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      },
      "onError": "continueErrorOutput",
      "notes": "Only ever touches lead_status and updated_at \u2014 never do_not_contact/dnc_email/dnc_call/dnc_sms."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, contact_id: $json.id, lead_status: $json.lead_status } }}",
        "options": {}
      },
