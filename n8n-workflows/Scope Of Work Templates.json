    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO scope_of_work_templates (id, name, content_html, created_by, created_at, updated_at)\nVALUES (COALESCE($1, nextval(pg_get_serial_sequence('scope_of_work_templates', 'id'))), $2, $3, $4, now(), now())\nON CONFLICT (id) DO UPDATE SET\n  name = EXCLUDED.name,\n  content_html = EXCLUDED.content_html,\n  updated_at = now()\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.id, $json.name, $json.contentHtml, $json.requesterId ] }}"
        }
      },
