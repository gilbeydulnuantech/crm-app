        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nconst { ids } = $('Validate Token & IDs').first().json;\n\nif (!requester.id || !requester.active) {\n  throw new Error('Invalid session.');\n}\nif (requester.role !== 'admin') {\n  throw new Error('Only admins can permanently delete contacts. Use archive instead.');\n}\n\nreturn [{ json: { ids } }];"
      },
      "id": "d746c162-0e93-4c3a-b26f-9ff7db35ba3a",
