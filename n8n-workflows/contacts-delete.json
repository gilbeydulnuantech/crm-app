        "jsCode": "const r = $input.first().json;\nif (!r.valid) throw new Error('Invalid session.');\n\nconst body = $('Webhook').first().json.body ?? {};\nconst rawIds = body.ids;\nif (!Array.isArray(rawIds) || rawIds.length === 0) throw new Error('Request must include a non-empty \"ids\" array.');\nconst ids = rawIds.map((v) => parseInt(v, 10)).filter((v) => Number.isInteger(v));\nif (ids.length === 0) throw new Error('No valid numeric ids were provided.');\n\nreturn [{ json: { id: r.userId, role: r.role, name: r.user?.name, active: r.active, ids } }];"
