    },
    {
      "parameters": {
        "jsCode": "const deletedIds = $input.all().map((item) => item.json.id);\nreturn [{\n  json: {\n    success: true,\n    deleted_count: deletedIds.length,\n    deleted_ids: deletedIds\n  }\n}];"
      },
