    {
      "parameters": {
        "jsCode": "// Validate the incoming payload from the frontend: { ids: [1, 2, 3] }\nconst headers = $input.first().json.headers || {};\nconst authHeader = headers['authorization'] || headers['Authorization'] || '';\nconst token = authHeader.replace('Bearer ', '').trim();\n\nconst match = token.match(/^token_(\\d+)_(\\d+)$/);\nif (!match) {\n  throw new Error('Invalid or missing session token.');\n}\n\nconst requesterId = parseInt(match[1], 10);\n\nconst body = $input.first().json.body ?? {};\nconst rawIds = body.ids;\n\nif (!Array.isArray(rawIds) || rawIds.length === 0) {\n  throw new Error('Request must include a non-empty \"ids\" array.');\n}\n\nconst ids = rawIds\n  .map((v) => parseInt(v, 10))\n  .filter((v) => Number.isInteger(v));\n\nif (ids.length === 0) {\n  throw new Error('No valid numeric ids were provided.');\n}\n\nreturn [{ json: { requesterId, ids } }];"
      },
      "id": "1f776cce-2cfe-4b0b-b579-968fc39b1003",
      "name": "Validate Token & IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        112
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, role, active FROM users WHERE id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $json.requesterId ] }}"
        }
      },
      "id": "a938b317-f295-4dfb-bf35-54fb837341ff",
      "name": "Look Up Requester",
      "type": "n8n-nodes-base.postgres",
