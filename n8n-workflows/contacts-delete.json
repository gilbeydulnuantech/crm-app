        "jsCode": "const requester = $input.first().json;\nconst { ids } = $('Validate Session').first().json;\n\nif (!requester.id || !requester.active) {\n  throw new Error('Invalid session.');\n}\nif (requester.role !== 'admin') {\n  throw new Error('Only admins can permanently delete contacts. Use archive instead.');\n}\n\nreturn [{ json: { ids } }];"
