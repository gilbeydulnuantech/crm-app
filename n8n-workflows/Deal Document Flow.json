    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nconst body = $('Webhook - Save Document Flow').first().json.body || {};\n\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nif (requester.role !== 'admin') throw new Error('Admin access required.');\n\nconst id = body.id ? parseInt(body.id, 10) : null;\nconst name = (body.name || '').toString().trim();\nconst triggerStageId = parseInt(body.trigger_stage_id, 10);\nconst delayHours = parseInt(body.delay_hours, 10);\nconst proposalEmailSubject = (body.proposal_email_subject || '').toString().trim();\nconst proposalEmailBody = (body.proposal_email_body || '').toString();\nconst proposalViewedStageId = body.proposal_viewed_stage_id ? parseInt(body.proposal_viewed_stage_id, 10) : null;\nconst proposalApprovedStageId = body.proposal_approved_stage_id ? parseInt(body.proposal_approved_stage_id, 10) : null;\nconst contractEmailSubject = (body.contract_email_subject || '').toString().trim();\nconst contractEmailBody = (body.contract_email_body || '').toString();\nconst contractSignedStageId = body.contract_signed_stage_id ? parseInt(body.contract_signed_stage_id, 10) : null;\nconst contractTemplateId = body.contract_template_id ? parseInt(body.contract_template_id, 10) : null;\nconst proposalReminderDelayHours = body.proposal_reminder_delay_hours !== undefined && body.proposal_reminder_delay_hours !== null && body.proposal_reminder_delay_hours !== '' ? parseInt(body.proposal_reminder_delay_hours, 10) : null;\nconst proposalReminderEmailSubject = (body.proposal_reminder_email_subject || '').toString().trim() || null;\nconst proposalReminderEmailBody = (body.proposal_reminder_email_body || '').toString().trim() || null;\n\nif (!name) throw new Error('\"name\" is required.');\nif (!Number.isInteger(triggerStageId)) throw new Error('\"trigger_stage_id\" is required.');\nif (!Number.isInteger(delayHours) || delayHours < 0) throw new Error('\"delay_hours\" must be 0 or more.');\nif (!proposalEmailSubject || !proposalEmailBody.trim()) throw new Error('Proposal email subject and body are required.');\nif (!contractEmailSubject || !contractEmailBody.trim()) throw new Error('Contract email subject and body are required.');\n\nreturn [{\n  json: {\n    id, name, triggerStageId, delayHours, proposalEmailSubject, proposalEmailBody,\n    proposalViewedStageId, proposalApprovedStageId, contractEmailSubject, contractEmailBody,\n    contractSignedStageId, contractTemplateId, proposalReminderDelayHours, proposalReminderEmailSubject, proposalReminderEmailBody, requesterId: requester.id,\n  },\n}];"
      },
      "id": "ddf1f0010-1010-4a5a-9b1a-docflow0000010",
      "name": "Validate Admin & Payload (Save)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1632,
        704
      ],
