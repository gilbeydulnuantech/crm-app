    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT f.id, f.name, f.trigger_stage_id, ts.name AS trigger_stage_name, p.id AS pipeline_id, p.name AS pipeline_name, f.delay_hours,\n  f.proposal_email_subject, f.proposal_email_body,\n  f.proposal_viewed_stage_id, vs.name AS proposal_viewed_stage_name,\n  f.proposal_approved_stage_id, aps.name AS proposal_approved_stage_name,\n  f.contract_email_subject, f.contract_email_body,\n  f.contract_signed_stage_id, css.name AS contract_signed_stage_name,\n  f.contract_template_id, ct.title AS contract_template_title,\n  f.proposal_reminder_delay_hours, f.proposal_reminder_email_subject, f.proposal_reminder_email_body,\n  f.is_active, f.created_at,\n  (SELECT COUNT(*) FROM opportunities o WHERE o.stage_id = f.trigger_stage_id AND o.is_archived = false AND o.status = 'Open') AS deals_in_stage\nFROM deal_document_flows f\nJOIN stages ts ON ts.id = f.trigger_stage_id\nJOIN pipelines p ON p.id = ts.pipeline_id\nLEFT JOIN stages vs ON vs.id = f.proposal_viewed_stage_id\nLEFT JOIN stages aps ON aps.id = f.proposal_approved_stage_id\nLEFT JOIN stages css ON css.id = f.contract_signed_stage_id\nLEFT JOIN contract_templates ct ON ct.id = f.contract_template_id\nORDER BY f.created_at DESC;",
        "options": {}
      },
