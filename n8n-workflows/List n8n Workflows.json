    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst list = Array.isArray(body.data) ? body.data : [];\nconst rows = list\n  .map((w) => ({\n    id: w.id,\n    name: w.name,\n    active: w.active,\n    updated_at: w.updatedAt,\n    node_count: Array.isArray(w.nodes) ? w.nodes.length : 0,\n  }))\n  .sort((a, b) => a.name.localeCompare(b.name));\nreturn [{ json: { rows } }];"
