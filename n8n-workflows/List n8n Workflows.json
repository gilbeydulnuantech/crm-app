        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nconst workflowId = ($('Webhook: get-automation-email-steps').first().json.query || {}).workflow_id;\nif (!workflowId) throw new Error('\"workflow_id\" query param is required.');\nreturn [{ json: { workflowId } }];"
