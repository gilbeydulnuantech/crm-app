      "parameters": {
        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nconst body = $('Webhook: update-automation-email-step').first().json.body || {};\nconst workflowId = (body.n8n_workflow_id || '').toString().trim();\nconst stepKey = (body.step_key || '').toString().trim();\nconst templateId = parseInt(body.email_template_id, 10);\nif (!workflowId) throw new Error('\"n8n_workflow_id\" is required.');\nif (!stepKey) throw new Error('\"step_key\" is required.');\nif (!Number.isInteger(templateId)) throw new Error('\"email_template_id\" is required.');\nreturn [{ json: { workflowId, stepKey, templateId } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        600
      ],
