        "operation": "executeQuery",
        "query": "UPDATE automation_email_steps SET email_template_id = $1 WHERE n8n_workflow_id = $2 AND step_key = $3 RETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.templateId, $json.workflowId, $json.stepKey ] }}"
