    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT aes.step_key, aes.label, aes.sort_order, aes.email_template_id, et.subject, et.body\nFROM automation_email_steps aes\nJOIN email_templates et ON et.id = aes.email_template_id\nWHERE aes.n8n_workflow_id = $1\nORDER BY aes.sort_order;",
        "options": {
          "queryReplacement": "={{ [ $json.workflowId ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        400
