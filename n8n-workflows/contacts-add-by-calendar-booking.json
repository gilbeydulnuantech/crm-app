    {
      "parameters": {
        "jsCode": "for (const item of items) {\n  const summary = item.json.summary || \"\";\n  const attendees = item.json.attendees || [];\n  \n  // 1. EXTRACT AND CLEAN NAME\n  // This looks for text inside (parentheses). If not found, it uses the whole summary.\n  let extractedName = summary;\n  const nameMatch = summary.match(/\\(([^)]+)\\)/);\n  \n  if (nameMatch) {\n    extractedName = nameMatch[1];\n  }\n\n  // Clean up: Remove extra spaces and convert to Title Case (e.g. \"babushka bey\" -> \"Babushka Bey\")\n  extractedName = extractedName.trim().split(' ')\n    .map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())\n    .join(' ');\n\n  // 2. EXTRACT EMAIL\n  // This filters out 'null' items and finds the first valid email address\n  const guest = attendees.find(a => a && a.email);\n  const extractedEmail = guest ? guest.email : \"No email found\";\n\n  // 3. ADD TO OUTPUT\n  item.json.Name = extractedName;\n  item.json.Email = extractedEmail;\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
