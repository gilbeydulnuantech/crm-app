    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mark-log-read",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-mark-log-read",
      "name": "Webhook: mark-log-read",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        560
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Rebuilds email_logs, flipping is_read=true on the entry whose id\n-- matches $1. Entries written before this id field existed can't be\n-- targeted this way (elem->>'id' is null for them) - harmless no-op.\nUPDATE contacts\nSET email_logs = (\n  SELECT COALESCE(jsonb_agg(\n    CASE WHEN elem->>'id' = $1\n      THEN elem || jsonb_build_object('is_read', true)\n      ELSE elem\n    END\n  ), '[]'::jsonb)\n  FROM jsonb_array_elements(COALESCE(email_logs, '[]'::jsonb)) AS elem\n)\nWHERE id = $2\nRETURNING id, email_logs;",
        "options": {
          "queryReplacement": "={{ [$('Webhook: mark-log-read').item.json.body.log_id, $('Webhook: mark-log-read').item.json.body.contact_id] }}"
        }
      },
      "id": "pg-mark-log-read",
      "name": "Postgres: Mark Email Read",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        330,
        560
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres CRM DB"
