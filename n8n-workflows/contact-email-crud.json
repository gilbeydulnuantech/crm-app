{
  "name": "Contact Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-send-email",
      "name": "Webhook: send-email",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- ASSUMPTION: email_logs is a jsonb column, and gen_random_uuid() is available\n-- (built into Postgres core since v13 - no extension needed). If your Postgres\n-- is older, install pgcrypto and use gen_random_uuid() from there instead, or\n-- swap for: md5(random()::text || clock_timestamp()::text)\n-- Note: this only appends a log entry, it does NOT send an email. Add a\n-- Send Email / Gmail node (your own SMTP or OAuth credential) before this\n-- Postgres node for real delivery - it can read the recipient/sender straight\n-- off $('Webhook: send-email').item.json.body.to / .from below.\nUPDATE contacts\nSET email_logs = COALESCE(email_logs, '[]'::jsonb) || jsonb_build_object(\n  'id', gen_random_uuid()::text,\n  'type', 'sent',\n  'subject', $1::text,\n  'message', $2::text,\n  'to', $3::text,\n  'from', $4::text,\n  'sent_at', now(),\n  'is_read', true\n)\nWHERE id = $5\nRETURNING id, email_logs;",
        "options": {
          "queryReplacement": "={{ [$('Webhook: send-email').item.json.body.subject, $('Webhook: send-email').item.json.body.message, $('Webhook: send-email').item.json.body.to, $('Webhook: send-email').item.json.body.from, $('Webhook: send-email').item.json.body.contact_id] }}"
        }
      },
      "id": "pg-send-email",
      "name": "Postgres: Append Email Log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        330,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres CRM DB"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"id\": $json.id } }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
                "name": "Access-Control-Allow-Methods",
                "value": "GET, POST, OPTIONS"
              },
              {
                "name": "Access-Control-Allow-Headers",
                "value": "Content-Type, Authorization, ngrok-skip-browser-warning"
              }
            ]
          }
        }
      },
      "id": "resp-send-email",
      "name": "Respond: send-email",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        550,
        200
      ]
    },
