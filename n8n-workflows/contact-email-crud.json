    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- ASSUMPTION: email_logs is a jsonb column. If it's text/varchar instead,\n-- change this to: SET email_logs = (COALESCE(email_logs::jsonb, '[]'::jsonb) || $1::jsonb)::text\n-- Note: this only appends a log entry, it does NOT send an email. Add a\n-- Send Email / Gmail node (your own SMTP or OAuth credential) before this\n-- Postgres node for real delivery.\nUPDATE contacts\nSET email_logs = COALESCE(email_logs, '[]'::jsonb) || jsonb_build_object(\n  'type', 'sent',\n  'subject', $1::text,\n  'message', $2::text,\n  'sent_at', now(),\n  'is_read', true\n)\nWHERE id = $3\nRETURNING id, email_logs;",
        "options": {
          "queryReplacement": "={{ [$json.body.subject, $json.body.message, $json.body.contact_id] }}"
        }
      },
      "id": "pg-send-contact-email",
      "name": "Postgres: Append Email Log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres CRM DB"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"id\": $json.id } }}",
