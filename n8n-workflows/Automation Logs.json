    {
      "parameters": {
        "jsCode": "const N8N_BASE = 'https://sequence-crumpet-available.ngrok-free.dev';\nconst rows = $input.all().map((i) => i.json).filter((r) => r.id != null);\nconst totalCount = rows.length > 0 ? Number(rows[0].total_count) : 0;\nconst runs = rows.map((r) => {\n  const { total_count, ...rest } = r;\n  return { ...rest, workflow_url: `${N8N_BASE}/workflow/${rest.workflow_id}` };\n});\nreturn [{ json: { success: true, runs, total_count: totalCount } }];"
