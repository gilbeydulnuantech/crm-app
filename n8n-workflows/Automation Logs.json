      "id": "autolog-webhook-runs",
      "name": "Webhook - Get Automation Runs",
      "webhookId": "autolog-runs-webhook"
    },
    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\n\nconst q = $('Webhook - Get Automation Runs').first().json.query || {};\nconst automationId = q.automation_id ? parseInt(q.automation_id, 10) : null;\nconst status = ['success', 'error', 'unsupported'].includes(q.status) ? q.status : null;\nconst limit = Math.min(Math.max(parseInt(q.limit, 10) || 50, 1), 200);\nconst offset = Math.max(parseInt(q.offset, 10) || 0, 0);\n\nreturn [{ json: { automationId, status, limit, offset } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "id": "autolog-parse-params-runs",
      "name": "Parse Filters: get-automation-runs"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ar.id, ar.automation_id, ar.action_id, ar.entity_type, ar.entity_id, ar.branch, ar.status, ar.detail, ar.ran_at,\n  a.name AS automation_name, aa.action_type,\n  CASE ar.entity_type\n    WHEN 'contact' THEN (SELECT NULLIF(TRIM(CONCAT(c.first_name, ' ', c.last_name)), '') FROM contacts c WHERE c.id = ar.entity_id)\n    WHEN 'company' THEN (SELECT co.name FROM companies co WHERE co.id = ar.entity_id)\n    WHEN 'pipeline' THEN (SELECT o.name FROM opportunities o WHERE o.id = ar.entity_id)\n    WHEN 'task' THEN (SELECT act.subject FROM activities act WHERE act.id = ar.entity_id)\n    WHEN 'calendar' THEN (SELECT act.subject FROM activities act WHERE act.id = ar.entity_id)\n    WHEN 'ticket' THEN (SELECT t.subject FROM tickets t WHERE t.id = ar.entity_id)\n    ELSE NULL\n  END AS entity_label,\n  COUNT(*) OVER() AS total_count\nFROM automation_runs ar\nJOIN automations a ON a.id = ar.automation_id\nLEFT JOIN automation_actions aa ON aa.id = ar.action_id\nWHERE ($1::int IS NULL OR ar.automation_id = $1)\n  AND ($2::text IS NULL OR ar.status = $2)\nORDER BY ar.ran_at DESC\nLIMIT $3 OFFSET $4;",
        "options": {
          "queryReplacement": "={{ [ $json.automationId, $json.status, $json.limit, $json.offset ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        0
      ],
      "id": "autolog-select-runs",
      "name": "Postgres: Select Automation Runs",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// alwaysOutputData means a genuinely empty page (offset past the end,\n// or a filter matching nothing) still reaches here as zero items \u2014 total\n// count would be lost with them, so re-derive it from a first-page item\n// when there are results, and treat a truly empty result as count 0.\nconst rows = $input.all().map((i) => i.json).filter((r) => r.id != null);\nconst totalCount = rows.length > 0 ? Number(rows[0].total_count) : 0;\nconst runs = rows.map((r) => {\n  const { total_count, ...rest } = r;\n  return rest;\n});\nreturn [{ json: { success: true, runs, total_count: totalCount } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
