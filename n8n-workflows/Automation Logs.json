    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, workflow_name, workflow_id, entity_type, run_at,\n  COUNT(*) OVER() AS total_count\nFROM workflow_run_log\nWHERE ($1::text IS NULL OR entity_type ILIKE '%' || $1 || '%')\n  AND ($2::text IS NULL OR workflow_id = $2)\nORDER BY run_at DESC\nLIMIT $3 OFFSET $4;",
        "options": {
          "queryReplacement": "={{ [ $json.entityType, $json.workflowId, $json.limit, $json.offset ] }}"
        }
