    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\n\nconst q = $('Webhook - Get Workflow Run Logs').first().json.query || {};\nconst entityType = (q.entity_type || '').trim() || null;\nconst workflowId = (q.workflow_id || '').trim() || null;\nconst limit = Math.min(Math.max(parseInt(q.limit, 10) || 100, 1), 500);\nconst offset = Math.max(parseInt(q.offset, 10) || 0, 0);\n\nreturn [{ json: { entityType, workflowId, limit, offset } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
