    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nconst q = $('Webhook - Get Automation Run Stats').first().json.query || {};\nreturn [{ json: { automationId: q.automation_id ? parseInt(q.automation_id, 10) : null } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        220
      ],
      "id": "autolog-parse-params-stats",
      "name": "Parse Filters: get-automation-run-stats"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id AS automation_id, a.name AS automation_name,\n  COUNT(*) FILTER (WHERE ar.status = 'success') AS success_count,\n  COUNT(*) FILTER (WHERE ar.status = 'error') AS error_count,\n  COUNT(*) FILTER (WHERE ar.status = 'unsupported') AS unsupported_count,\n  MAX(ar.ran_at) AS last_ran_at\nFROM automation_runs ar\nJOIN automations a ON a.id = ar.automation_id\nWHERE ($1::int IS NULL OR ar.automation_id = $1)\nGROUP BY a.id, a.name\nORDER BY last_ran_at DESC;",
        "options": {
          "queryReplacement": "={{ [ $json.automationId ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        220
