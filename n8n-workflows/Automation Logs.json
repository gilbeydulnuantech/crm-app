      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map((i) => i.json).filter((r) => r.automation_id != null);\nreturn [{ json: { success: true, stats: rows } }];"
      },
      "type": "n8n-nodes-base.code",
