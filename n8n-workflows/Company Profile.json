    {
      "parameters": {
        "jsCode": "const headers = $input.first().json.headers || {};\nconst authHeader = headers['authorization'] || headers['Authorization'] || '';\nconst token = authHeader.replace('Bearer ', '').trim();\nconst match = token.match(/^token_(\\d+)_(\\d+)$/);\nif (!match) throw new Error('Invalid or missing session token.');\nconst requesterId = parseInt(match[1], 10);\n\nconst body = $input.first().json.body || {};\nconst photo = body.photo || {};\nconst dataUrl = photo.url || '';\n\nconst m = /^data:([^;,]+)?(?:;[^,]*)?,(.*)$/s.exec(dataUrl);\nif (!m) throw new Error('\"photo.url\" must be a base64 data URL.');\nconst [, mimeType, base64] = m;\n\nif (!mimeType || !mimeType.startsWith('image/')) {\n  throw new Error('Logo must be an image file.');\n}\nif (base64.length > 7000000) {\n  throw new Error('Logo is too large (max ~5MB).');\n}\n\nreturn [{\n  json: { requesterId },\n  binary: {\n    data: {\n      data: base64,\n      mimeType,\n      fileName: photo.name || 'logo.png'\n    }\n  }\n}];"
      },
