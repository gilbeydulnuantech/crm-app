    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nconst body = $('Webhook - Save Company Profile').first().json.body || {};\n\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nif (requester.role !== 'admin') throw new Error('Admin access required.');\n\nconst companyName = (body.company_name || '').toString().trim();\nconst email = (body.email || '').toString().trim();\nconst phone = (body.phone || '').toString().trim();\nconst address = (body.address || '').toString().trim();\nconst website = (body.website || '').toString().trim();\nlet brandColor = (body.brand_color || '#2563EB').toString().trim();\nif (!/^#[0-9a-fA-F]{6}$/.test(brandColor)) brandColor = '#2563EB';\n\nreturn [{ json: { companyName, email, phone, address, website, brandColor, requesterId: requester.id } }];"
      },
