    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ct.id, ct.title, ct.content_html, ct.total_amount, ct.email_subject, ct.email_body, ct.thank_you_page_id, p.name AS thank_you_page_name, ct.created_by, u.name AS created_by_name, ct.created_at, ct.updated_at\nFROM contract_templates ct\nLEFT JOIN users u ON u.id = ct.created_by\nLEFT JOIN pages p ON p.id = ct.thank_you_page_id\nORDER BY ct.title ASC;",
