    {
      "parameters": {
        "jsCode": "const existing = $input.item.json;\nconst requester = $('Validate Session (Save)').first().json;\nconst body = $('Webhook - Save Contract Template').first().json.body || {};\n\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\n\nconst id = body.id ? parseInt(body.id, 10) : null;\nif (id && existing.created_by != null && requester.role !== 'admin' && existing.created_by !== requester.id) {\n  throw new Error('Only an admin or the template\\'s creator can edit it.');\n}\n\nconst title = (body.title || '').toString().trim();\nconst contentHtml = (body.content_html || '').toString();\nconst totalAmount = body.total_amount !== undefined && body.total_amount !== null && body.total_amount !== '' ? Number(body.total_amount) : 0;\nconst emailSubject = (body.email_subject || '').toString().trim() || 'Your contract is ready to sign';\nconst emailBody = (body.email_body || '').toString().trim() || 'Hi {{contact.first_name}}, please review and sign your contract here: {{contract_link}}';\n\nconst thankYouPageId = body.thank_you_page_id ? parseInt(body.thank_you_page_id, 10) : null;\n\nif (!title) throw new Error('\"title\" is required.');\nif (!contentHtml.trim()) throw new Error('Contract content is required.');\nif (!Number.isFinite(totalAmount) || totalAmount < 0) throw new Error('\"total_amount\" must be 0 or more.');\n\nreturn [{ json: { id, title, contentHtml, totalAmount, emailSubject, emailBody, thankYouPageId, requesterId: requester.id } }];"
      },
      "id": "ctpl0011-1111-4a5a-9b1a-conttemp0011",
      "name": "Validate & Payload (Save)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1856,
        624
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO contract_templates (id, title, content_html, total_amount, email_subject, email_body, thank_you_page_id, created_by, created_at, updated_at)\nVALUES (COALESCE($1, nextval(pg_get_serial_sequence('contract_templates', 'id'))), $2, $3, $4, $5, $6, $7, $8, now(), now())\nON CONFLICT (id) DO UPDATE SET\n  title = EXCLUDED.title,\n  content_html = EXCLUDED.content_html,\n  total_amount = EXCLUDED.total_amount,\n  email_subject = EXCLUDED.email_subject,\n  email_body = EXCLUDED.email_body,\n  thank_you_page_id = EXCLUDED.thank_you_page_id,\n  updated_at = now()\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.id, $json.title, $json.contentHtml, $json.totalAmount, $json.emailSubject, $json.emailBody, $json.thankYouPageId, $json.requesterId ] }}"
        }
      },
