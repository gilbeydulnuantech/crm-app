    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ct.created_by\nFROM (SELECT $1::int AS tid) dummy\nLEFT JOIN contract_templates ct ON ct.id = dummy.tid;",
        "options": {
          "queryReplacement": "={{ [ $('Webhook - Save Contract Template').first().json.body.id || null ] }}"
        }
      },
      "id": "ctpl0010-1010-4a5a-9b1a-conttemp0010",
      "name": "Look Up Existing Template (Save)",
      "type": "n8n-nodes-base.postgres",
