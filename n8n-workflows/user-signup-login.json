      "parameters": {
        "jsCode": "const bcrypt = require('bcryptjs');\nconst dbResult = $input.first().json;\nconst rawPassword = $('Format Login Query').first().json.rawPassword;\n\nif (!dbResult.id || !dbResult.active) {\n  return [{\n    json: {\n      success: false,\n      message: 'Invalid credentials or account inactive.'\n    }\n  }];\n}\n\nconst isPasswordValid = bcrypt.compareSync(rawPassword, dbResult.password_hash);\n\nif (!isPasswordValid) {\n  return [{\n    json: {\n      success: false,\n      message: 'Invalid credentials.'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    message: 'Login successful.',\n    token: `token_${dbResult.id}_${Date.now()}`,\n    user: {\n      id: dbResult.id,\n      name: dbResult.name,\n      email: dbResult.email,\n      role: dbResult.role\n    }\n  }\n}];"
