    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// When onError = continueRegularOutput, a failed query (e.g. duplicate email\n// hitting the users_email_key unique constraint) lands here with an `error`\n// field instead of throwing, so we can return a friendly message.\nif (item.error || !item.id) {\n  return [{\n    json: {\n      success: false,\n      message: 'Email already registered or database error occurred.'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    message: 'Account created successfully!',\n    user: {\n      id: item.id,\n      name: item.name,\n      email: item.email,\n      role: item.role\n    }\n  }\n}];"
