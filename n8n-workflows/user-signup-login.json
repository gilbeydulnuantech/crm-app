    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst token = (body.token || '').trim();\n\nconst match = token.match(/^token_(\\d+)_(\\d+)$/);\nif (!match) {\n  return [{ json: { valid: false } }];\n}\n\nconst userId = parseInt(match[1], 10);\nconst issuedAt = parseInt(match[2], 10);\nconst TTL_MS = 24 * 60 * 60 * 1000;\n\nif (Date.now() - issuedAt > TTL_MS) {\n  return [{ json: { valid: false } }];\n}\n\nconst sqlQuery = `SELECT id, name, email, role, active FROM users WHERE id = $1 LIMIT 1;`;\n\nreturn [{ json: { sqlQuery, queryParams: [userId] } }];"
      },
