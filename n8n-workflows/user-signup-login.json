    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst email = (body.email || '').trim().toLowerCase();\nconst password = body.password || '';\n\nconst sqlQuery = `\n  SELECT id, name, email, password_hash, role, active\n  FROM users\n  WHERE email = $1\n  LIMIT 1;\n`;\n\nreturn [{\n  json: {\n    rawPassword: password,\n    sqlQuery,\n    queryParams: [email]\n  }\n}];"
