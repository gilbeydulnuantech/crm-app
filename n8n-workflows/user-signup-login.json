    {
      "parameters": {
        "jsCode": "const bcrypt = require('bcryptjs');\nconst dbResult = $input.first().json;\nconst rawPassword = $('Format Login Query').first().json.rawPassword;\n\nif (!dbResult.id || !dbResult.active) {\n  return [{ json: { success: false, message: 'Invalid credentials or account inactive.' } }];\n}\n\nconst isPasswordValid = bcrypt.compareSync(rawPassword, dbResult.password_hash);\nif (!isPasswordValid) {\n  return [{ json: { success: false, message: 'Invalid credentials.' } }];\n}\n\n// Real, cryptographically random session token (replaces the old\n// token_<id>_<timestamp> string, which had no signature/secret and could\n// be forged by anyone to impersonate any user, including admins).\n// require('crypto') can be blocked by this n8n instance's\n// NODE_FUNCTION_ALLOW_BUILTIN config -- fall back to a Math.random-based\n// token rather than letting this node throw and silently kill the whole\n// login response.\nfunction randomToken() {\n  try {\n    return require('crypto').randomBytes(32).toString('hex');\n  } catch (e) {\n    let out = '';\n    for (let i = 0; i < 8; i++) out += Math.random().toString(36).slice(2, 10);\n    return out;\n  }\n}\nconst token = randomToken();\nconst TTL_MS = 24 * 60 * 60 * 1000;\nconst expiresAt = new Date(Date.now() + TTL_MS).toISOString();\n\nreturn [{\n  json: {\n    success: true,\n    message: 'Login successful.',\n    token,\n    expiresAt,\n    user: {\n      id: dbResult.id,\n      name: dbResult.name,\n      email: dbResult.email,\n      role: dbResult.role,\n      theme_header_color: dbResult.theme_header_color,\n      theme_main_color: dbResult.theme_main_color,\n      theme_accent_color: dbResult.theme_accent_color\n    }\n  }\n}];"
      },
