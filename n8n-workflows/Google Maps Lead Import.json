    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\n\nconst body = $('Webhook: import-maps-leads').first().json.body || {};\nconst searchQuery = (body.search_query || '').trim();\nconst location = (body.location || '').trim();\nif (!searchQuery) throw new Error('search_query is required (e.g. \"roofing contractors\").');\nif (!location) throw new Error('location is required (e.g. \"Austin, TX\").');\n\nlet maxResults = parseInt(body.max_results, 10);\nif (!Number.isInteger(maxResults) || maxResults <= 0) maxResults = 30;\nmaxResults = Math.min(maxResults, 100);\n\nreturn [{ json: { requesterId: requester.id, searchQuery, location, maxResults } }];"
      },
