    {
      "parameters": {
        "jsCode": "const items = $input.all().map((i) => i.json).filter((p) => p && p.title && p.placeId);\nconst ctx = $('Validate Payload').first().json;\n\nreturn [{\n  json: {\n    requesterId: ctx.requesterId,\n    scraped: items.length,\n    names: items.map((p) => p.title),\n    websites: items.map((p) => p.website || ''),\n    phones: items.map((p) => p.phoneUnformatted || p.phone || ''),\n    streets: items.map((p) => p.street || p.address || ''),\n    cities: items.map((p) => p.city || ''),\n    states: items.map((p) => p.state || ''),\n    countries: items.map((p) => p.countryCode || ''),\n    placeIds: items.map((p) => p.placeId),\n    mapsUrls: items.map((p) => p.url || ''),\n    ratings: items.map((p) => (p.totalScore != null ? Number(p.totalScore) : null)),\n    reviewCounts: items.map((p) => (p.reviewsCount != null ? Number(p.reviewsCount) : null)),\n    categories: items.map((p) => p.categoryName || ''),\n  },\n}];"
      },
