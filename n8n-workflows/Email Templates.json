    {
      "parameters": {
        "jsCode": "// Allow-list HTML sanitizer for formatted emails: only the tags/attributes below survive, links must be\n// http(s)/mailto/tel, images http(s) or inline png/jpeg/gif/webp, and style attributes keep only simple\n// presentation properties. Everything else (scripts, event handlers, iframes, forms...) is dropped.\nfunction sanitizeEmailHtmlCore(html) {\n  const ALLOWED = new Set(['p','br','strong','b','em','i','u','s','strike','ul','ol','li','a','h1','h2','h3','h4','blockquote','hr','span','div','img','table','thead','tbody','tr','td','th','code','pre']);\n  const VOID = new Set(['br','hr','img']);\n  const STYLE_OK = new Set(['color','background-color','font-size','font-weight','font-style','font-family','text-align','text-decoration','line-height','margin','margin-top','margin-bottom','margin-left','margin-right','padding','padding-top','padding-bottom','padding-left','padding-right','border','border-radius','width','max-width','height','display']);\n  const esc = (v) => String(v).replace(/&(?!(?:amp|lt|gt|quot|#\\d+|#x[0-9a-f]+);)/gi, '&amp;').replace(/\"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n  let s = String(html || '').replace(/<!--[\\s\\S]*?-->/g, '');\n  s = s.replace(/<(script|style|iframe|object|embed|form|meta|link|svg|math|base|textarea|button|input|select)\\b[\\s\\S]*?<\\/\\1\\s*>/gi, '');\n  return s.replace(/<\\/?([a-zA-Z][a-zA-Z0-9]*)\\b([^>]*)>/g, (m, tag, attrs) => {\n    const t = tag.toLowerCase();\n    if (!ALLOWED.has(t)) return '';\n    if (m.charAt(1) === '/') return VOID.has(t) ? '' : '</' + t + '>';\n    const out = [];\n    const re = /([a-zA-Z_:][-a-zA-Z0-9_:.]*)\\s*(?:=\\s*(?:\"([^\"]*)\"|'([^']*)'|([^\\s\"'>]+)))?/g;\n    let a;\n    while ((a = re.exec(attrs))) {\n      const name = a[1].toLowerCase();\n      const val = a[2] !== undefined ? a[2] : a[3] !== undefined ? a[3] : a[4] !== undefined ? a[4] : '';\n      const probe = val.replace(/[\\u0000- ]/g, '').toLowerCase();\n      if (name === 'href' && t === 'a') { if (/^(https?:|mailto:|tel:|#|\\/(?!\\/))/.test(probe)) out.push('href=\"' + esc(val) + '\"'); }\n      else if (name === 'src' && t === 'img') { if (/^(https?:|\\/(?!\\/))/.test(probe) || /^data:image\\/(png|jpe?g|gif|webp);base64,/.test(probe)) out.push('src=\"' + esc(val) + '\"'); }\n      else if (name === 'alt' || name === 'title') out.push(name + '=\"' + esc(val) + '\"');\n      else if ((name === 'width' || name === 'height') && /^\\d{1,4}(px|%)?$/.test(val.trim())) out.push(name + '=\"' + esc(val.trim()) + '\"');\n      else if ((name === 'colspan' || name === 'rowspan') && /^\\d{1,2}$/.test(val.trim())) out.push(name + '=\"' + val.trim() + '\"');\n      else if (name === 'align' && /^(left|center|right)$/i.test(val.trim())) out.push('align=\"' + val.trim().toLowerCase() + '\"');\n      else if (name === 'target' && t === 'a') out.push('target=\"_blank\"');\n      else if (name === 'style') {\n        const kept = val.split(';').map((d) => d.trim()).filter(Boolean).filter((d) => {\n          const i = d.indexOf(':'); if (i < 1) return false;\n          const prop = d.slice(0, i).trim().toLowerCase(), v = d.slice(i + 1).toLowerCase();\n          return STYLE_OK.has(prop) && !/url\\s*\\(|expression|javascript|@import|[<>\\\\]/.test(v);\n        });\n        if (kept.length) out.push('style=\"' + esc(kept.join('; ')) + '\"');\n      }\n    }\n    if (t === 'img' && !out.some((x) => x.indexOf('src=') === 0)) return '';\n    if (t === 'a' && out.some((x) => x.indexOf('target=') === 0)) out.push('rel=\"noopener noreferrer\"');\n    return '<' + t + (out.length ? ' ' + out.join(' ') : '') + '>';\n  });\n}\n// Empty paragraphs are the blank lines typed in the editor; mail clients collapse a bare <p></p>, so give them a line break to keep the spacing.\nfunction sanitizeEmailHtml(html) { return sanitizeEmailHtmlCore(html).replace(/<p>\\s*<\\/p>/gi, '<p><br></p>'); }\nfunction emailHtmlToText(html) {\n  return String(html || '')\n    .replace(/<\\s*br\\s*\\/?>/gi, '\\n').replace(/<\\/(p|div|li|h[1-6]|tr|blockquote)>/gi, '\\n')\n    .replace(/<a\\b[^>]*href=\"([^\"]+)\"[^>]*>(.*?)<\\/a>/gi, (m, h, t) => (t.replace(/<[^>]*>/g, '').trim() || h) + ' (' + h + ')')\n    .replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').replace(/&mdash;/g, '\\u2014').replace(/&ndash;/g, '\\u2013').replace(/&hellip;/g, '\\u2026').replace(/&[lr]squo;/g, \"'\").replace(/&[lr]dquo;/g, '\"').replace(/&#(\\d+);/g, (m, n) => String.fromCharCode(Number(n))).replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\").replace(/&amp;/g, '&')\n    .replace(/\\n{3,}/g, '\\n\\n').trim();\n}\n\nconst existing = $input.item.json;\nconst requester = $('Validate Session (Save)').first().json;\nconst body = $('Webhook - Save Email Template').first().json.body || {};\n\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\n\nconst id = body.id ? parseInt(body.id, 10) : null;\nif (id && existing.created_by != null && requester.role !== 'admin' && existing.created_by !== requester.id) {\n  throw new Error('Only an admin or the template\\'s creator can edit it.');\n}\n\nconst name = (body.name || '').toString().trim();\nconst subject = (body.subject || '').toString().trim();\nconst isHtml = body.is_html === true;\nconst rawBody = (body.body || '').toString().slice(0, 200000);\nconst emailBody = isHtml ? sanitizeEmailHtml(rawBody) : rawBody;\nconst triggerEvent = (body.trigger_event || '').toString().trim() || null;\n\nif (!name) throw new Error('\"name\" is required.');\nif (!subject) throw new Error('\"subject\" is required.');\nif (!(isHtml ? emailBody.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ') : emailBody).trim() && !/<img\\b/i.test(emailBody)) throw new Error('\"body\" is required.');\n\nreturn [{ json: { id, name, subject, emailBody, isHtml, triggerEvent, requesterId: requester.id } }];"
      },
