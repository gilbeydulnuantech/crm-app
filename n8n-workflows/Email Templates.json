    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO email_templates (id, name, trigger_event, subject, body, is_active, created_by, created_at, updated_at)\nVALUES (COALESCE($1, nextval(pg_get_serial_sequence('email_templates', 'id'))), $2, $3, $4, $5, true, $6, now(), now())\nON CONFLICT (id) DO UPDATE SET\n  name = EXCLUDED.name,\n  trigger_event = EXCLUDED.trigger_event,\n  subject = EXCLUDED.subject,\n  body = EXCLUDED.body,\n  updated_at = now()\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.id, $json.name, $json.triggerEvent, $json.subject, $json.emailBody, $json.requesterId ] }}"
        }
      },
