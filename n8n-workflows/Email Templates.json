      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT et.created_by\nFROM (SELECT $1::int AS tid) dummy\nLEFT JOIN email_templates et ON et.id = dummy.tid;",
        "options": {
          "queryReplacement": "={{ [ $('Webhook - Save Email Template').first().json.body.id || null ] }}"
        }
