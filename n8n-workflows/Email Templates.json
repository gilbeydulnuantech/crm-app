        "query": "SELECT et.id, et.name, et.trigger_event, et.subject, et.body, et.is_active, et.created_by, u.name AS created_by_name, et.created_at, et.updated_at\nFROM email_templates et\nLEFT JOIN users u ON u.id = et.created_by\nORDER BY et.name ASC;",
