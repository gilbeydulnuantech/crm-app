    {
      "parameters": {
        "jsCode": "const existing = $input.item.json;\nconst requester = $('Look Up Requester (Save)').first().json;\nconst body = $('Webhook - Save Email Template').first().json.body || {};\n\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\n\nconst id = body.id ? parseInt(body.id, 10) : null;\nif (id && existing.created_by != null && requester.role !== 'admin' && existing.created_by !== requester.id) {\n  throw new Error('Only an admin or the template\\'s creator can edit it.');\n}\n\nconst name = (body.name || '').toString().trim();\nconst subject = (body.subject || '').toString().trim();\nconst emailBody = (body.body || '').toString();\nconst triggerEvent = (body.trigger_event || '').toString().trim() || null;\n\nif (!name) throw new Error('\"name\" is required.');\nif (!subject) throw new Error('\"subject\" is required.');\nif (!emailBody.trim()) throw new Error('\"body\" is required.');\n\nreturn [{ json: { id, name, subject, emailBody, triggerEvent, requesterId: requester.id } }];"
      },
      "id": "etpl0011-1111-4a5a-9b1a-emailtemp0011",
      "name": "Validate & Payload (Save)",
      "type": "n8n-nodes-base.code",
