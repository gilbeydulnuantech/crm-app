    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r.valid || !r.active) throw new Error('Invalid session.');\nconst body = $('Webhook: send-telegram').first().json.body || {};\nconst contactId = parseInt(body.contact_id, 10);\nconst text = (body.message || '').toString().trim();\nconst base = { userId: r.userId, role: r.role, userName: (r.user && r.user.name) || 'Unknown' };\n// Payload problems come back as a normal { error } item (not a thrown error) so\n// the rep sees the real reason; only a bad session throws, which signs them out.\nif (!Number.isInteger(contactId)) return [{ json: { ...base, error: '\"contact_id\" is required.' } }];\nif (!text) return [{ json: { ...base, contactId, error: 'Write a message first.' } }];\nif (text.length > 4096) return [{ json: { ...base, contactId, error: 'Telegram messages are limited to 4096 characters.' } }];\nreturn [{ json: { ...base, contactId, text } }];"
      },
      "id": "72c78801-8168-49b5-81db-43ee96546fb9",
      "name": "Validate Session & Payload: send-telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id, c.first_name, c.telegram_chat_id, c.dnc_telegram, c.do_not_contact\nFROM contacts c\nWHERE c.id = $1 AND c.is_archived = false AND ($2 = 'admin' OR c.owner_id = $3);",
        "options": {
          "queryReplacement": "={{ [ $json.contactId ?? null, $json.role, $json.userId ] }}"
        }
      },
      "id": "2c9d2375-a0de-4f43-a093-da1d67b343f1",
      "name": "Look Up Contact: send-telegram",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        880,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const v = $('Validate Session & Payload: send-telegram').first().json;\nconst c = $input.first().json;\nconst no = (error) => [{ json: { ok: false, error } }];\nif (v.error) return no(v.error);\nif (!c || !c.id) return no('Contact not found, or you do not have access to it.');\nif (!c.telegram_chat_id) return no('This contact has not connected Telegram yet. Send them their invite link first.');\n// A STOP reply is a real opt-out: reps can't override it. The contact has to\n// press Start on their invite link again.\nif (c.dnc_telegram) return no('This contact opted out of Telegram (they replied STOP). They need to press Start on their invite link again before you can message them.');\nif (c.do_not_contact) return no('This contact is marked Do Not Contact.');\nreturn [{ json: { ok: true, chatId: String(c.telegram_chat_id), text: v.text, contactId: c.id, userId: v.userId, userName: v.userName } }];"
      },
