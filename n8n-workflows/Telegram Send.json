        "operation": "executeQuery",
        "query": "INSERT INTO entity_activity_log (entity_type, entity_id, category, subtype, summary, detail, actor_id, actor_name)\nVALUES ('contact', $1, 'telegram', 'outbound', 'Telegram message sent', jsonb_build_object('text', $2::text, 'message_id', $3::text), $4, $5)\nRETURNING id;",
        "options": {
