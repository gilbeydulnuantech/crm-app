    },
    {
      "parameters": {
        "jsCode": "const meta = $('Check Can Send').first().json;\nconst r = $input.first().json || {};\n// The Telegram node runs with \"continue on error\", so a failure arrives as a\n// normal item carrying `error`.\nconst failed = !!r.error || r.ok === false;\nif (failed) {\n  const m = String((r.error && (r.error.message || r.error.description)) || r.error || r.description || 'Telegram send failed');\n  return [{ json: { sent: false, error: /blocked/i.test(m) ? 'This contact has blocked the bot on Telegram, so the message could not be delivered.' : 'Telegram could not deliver the message: ' + m } }];\n}\nreturn [{ json: { sent: true, contactId: meta.contactId, text: meta.text, userId: meta.userId, userName: meta.userName, messageId: r.result && r.result.message_id ? String(r.result.message_id) : null } }];"
      },
