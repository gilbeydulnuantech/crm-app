    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT es.id AS send_id, es.contact_id, es.workflow_step, es.sent_at, c.first_name, c.last_name, c.email, c.phone, c.unsubscribe_token FROM email_sends es JOIN contacts c ON c.id = es.contact_id WHERE es.workflow_id = 'new_lead' AND es.workflow_step IN ('book_inspection','book_reminder_1','book_reminder_2') AND es.reply_status = 'waiting' AND es.sent_at <= now() - interval '48 hours' AND c.is_archived = false;",
        "options": {}
      },
      "id": "br-find-due",
      "name": "Find Due Bookings",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
