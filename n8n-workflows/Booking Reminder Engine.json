        304
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const NEXT = { book_inspection: { step: 'book_reminder_1', templateId: 18 }, book_reminder_1: { step: 'book_reminder_2', templateId: 19 } };\nconst row = $input.item.json;\nconst next = NEXT[row.workflow_step] || null;\nreturn [{ json: { ...row, nextStep: next ? next.step : null, nextTemplateId: next ? next.templateId : null } }];"
      },
      "id": "br-next-step",
      "name": "Determine Next Reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "br-next-cond",
              "leftValue": "={{ !!$json.nextStep }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "br-has-next",
      "name": "Has Next Reminder?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        864,
        304
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE email_sends SET reply_status = 'exhausted' WHERE id = $1;",
        "options": {
          "queryReplacement": "={{ [ $json.send_id ] }}"
        }
      },
