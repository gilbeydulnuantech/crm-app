    {
      "parameters": {
        "jsCode": "\nfunction toTitleCase(s) { return (s || '').toString().toLowerCase().split(' ').map((w) => (w ? w[0].toUpperCase() + w.slice(1) : w)).join(' '); }\nfunction fill(template, row) {\n  let base = '';\n  try { base = $env.FRONTEND_BASE_URL || ''; } catch (e) { base = ''; }\n  return (template || '')\n    .replace(/{{\\s*first_name\\s*}}/gi, toTitleCase(row.first_name) || 'there')\n    .replace(/{{\\s*email\\s*}}/gi, row.email || '')\n    .replace(/{{\\s*unsubscribe_link\\s*}}/gi, base + '/unsubscribe/' + row.unsubscribe_token)\n    .replace(/{{(?!\\s*company_name\\s*}})[^{}]*}}/gi, '');\n}\n\nconst tmpl = $input.item.json;\nconst row = $('Determine Next Reminder').item.json;\nreturn [{ json: { to: row.email, subject: fill(tmpl.subject, row), htmlBody: fill(tmpl.body, row).replace(/\\n/g, '<br>') } }];"
      },
      "id": "br-fill",
      "name": "Fill Reminder Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1296,
        160
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Fill Reminder Email').item.json.to }}",
        "subject": "={{ ($('Fill Reminder Email').item.json.subject).replace(/\\{\\{\\s*company_name\\s*\\}\\}/gi, $('Get Company Name: Reminder Email').item.json.company_name) }}",
        "message": "={{ (($('Fill Reminder Email').item.json.htmlBody).replace(/The Team/g, $('Get Company Name: Reminder Email').item.json.company_name + ' Team')).replace(/\\{\\{\\s*company_name\\s*\\}\\}/gi, $('Get Company Name: Reminder Email').item.json.company_name) }}",
        "options": {
          "senderName": "={{ $('Get Company Name: Reminder Email').item.json.company_name }}"
        }
      },
      "id": "br-send",
      "name": "Send Reminder Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1520,
        304
      ],
      "webhookId": "53b2824b-ace1-4578-84d4-380867db1221",
      "credentials": {
        "gmailOAuth2": {
          "id": "YE9RFYruaRVVZ6H4",
          "name": "CRMapp"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE contacts SET email_logs = COALESCE(email_logs, '[]'::jsonb) || jsonb_build_object('id', gen_random_uuid()::text, 'type', 'sent', 'subject', $1::text, 'message', $2::text, 'sent_at', NOW(), 'is_read', true) WHERE id = $3;",
        "options": {
          "queryReplacement": "={{ [ ($('Fill Reminder Email').item.json.subject).replace(/\\{\\{\\s*company[._]name\\s*\\}\\}/gi, $('Get Company Name: Reminder Email').item.json.company_name), $('Fill Reminder Email').item.json.htmlBody.replace(/<br\\s*\\/?\\s*>/gi, '\\n').replace(/<[^>]+>/g, '').replace(/The Team/g, $('Get Company Name: Reminder Email').item.json.company_name + ' Team').replace(/\\{\\{\\s*company[._]name\\s*\\}\\}/gi, $('Get Company Name: Reminder Email').item.json.company_name), $('Determine Next Reminder').item.json.contact_id ] }}"
        }
      },
