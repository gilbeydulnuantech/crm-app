        "query": "SELECT subject, body FROM email_templates WHERE id = $1;",
        "options": {
          "queryReplacement": "={{ [ $json.nextTemplateId ] }}"
        }
      },
      "id": "br-lookup-tmpl",
      "name": "Look Up Reminder Template",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1088,
        304
      ],
