    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT u.id AS user_id, u.name, COALESCE(od.cnt,0) AS open_deals, COALESCE(wd.cnt,0) AS won_deals, COALESCE(wd.revenue,0) AS revenue, COALESCE(tc.cnt,0) AS tasks_completed, COALESCE(co.cnt,0) AS contacts_owned FROM users u LEFT JOIN (SELECT assigned_user, COUNT(*) AS cnt FROM opportunities WHERE status='Open' GROUP BY assigned_user) od ON od.assigned_user = u.id LEFT JOIN (SELECT assigned_user, COUNT(*) AS cnt, SUM(deal_value) AS revenue FROM opportunities WHERE status='Won' AND closed_at >= now() - ($1||' days')::interval GROUP BY assigned_user) wd ON wd.assigned_user = u.id LEFT JOIN (SELECT user_id, COUNT(*) AS cnt FROM activities WHERE type='task' AND is_completed=true AND completed_at >= now() - ($1||' days')::interval GROUP BY user_id) tc ON tc.user_id = u.id LEFT JOIN (SELECT owner_id, COUNT(*) AS cnt FROM contacts WHERE is_archived=false GROUP BY owner_id) co ON co.owner_id = u.id WHERE u.active = true ORDER BY u.name;",
        "options": {
          "queryReplacement": "={{ [$json.query.days || '30'] }}"
        }
      },
