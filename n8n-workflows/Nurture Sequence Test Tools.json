            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "tt1h0017-1111-4a5a-9b1a-nurtest0000017",
              "leftValue": "={{ $json.action }}",
              "rightValue": "exit_reply",
              "operator": {
                "type": "string",
