    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH exit_update AS (\n  UPDATE nurture_enrollments SET status = 'exited_reply', exited_at = now(), exit_reason = 'Contact replied'\n  WHERE id = $1\n  RETURNING contact_id\n),\nstatus_update AS (\n  UPDATE contacts SET lead_status = $2, updated_at = now()\n  WHERE id = (SELECT contact_id FROM exit_update) AND $2::text IS NOT NULL\n  RETURNING id\n)\nINSERT INTO entity_activity_log (entity_type, entity_id, category, subtype, summary, detail, actor_id, actor_name)\nSELECT 'contact', contact_id, 'system_audit', 'created',\n  'Nurture sequence stopped \u2014 contact replied' || CASE WHEN $2::text IS NOT NULL THEN '; status set to ' || $2 ELSE '' END,\n  NULL::jsonb, NULL, 'Automation'\nFROM exit_update\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.enrollment_id, $json.exit_lead_status ] }}"
        }
      },
