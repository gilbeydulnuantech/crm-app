      "parameters": {
        "jsCode": "const requester = $input.first().json;\nconst body = $('Webhook - Test Nurture Step').first().json.body || {};\n\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nif (requester.role !== 'admin') throw new Error('Admin access required.');\n\nconst testEmail = (body.test_email || '').toString().trim();\nconst subject = (body.email_subject || '').toString().trim();\nconst emailBody = (body.email_body || '').toString();\n\nif (!testEmail) throw new Error('\"test_email\" is required.');\nif (!subject) throw new Error('\"email_subject\" is required.');\nif (!emailBody.trim()) throw new Error('\"email_body\" is required.');\n\nfunction fill(template) {\n  return template\n    .replace(/{{\\s*first_name\\s*}}/gi, 'Test')\n    .replace(/{{\\s*last_name\\s*}}/gi, 'Contact');\n}\n\nreturn [{ json: { testEmail, subject: '[TEST] ' + fill(subject), body: fill(emailBody) } }];"
      },
