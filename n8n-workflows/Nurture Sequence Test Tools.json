    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO nurture_enrollments (sequence_id, contact_id, current_step, status, enrolled_at)\nSELECT $1, c.id, 0, 'active', now()\nFROM contacts c\nWHERE c.is_archived = false\n  AND c.email IS NOT NULL AND c.email <> ''\n  AND GREATEST(c.updated_at, COALESCE((SELECT MAX(created_at) FROM entity_activity_log WHERE entity_type = 'contact' AND entity_id = c.id), c.created_at)) <= now() - ($2 || ' days')::interval\n  AND NOT EXISTS (SELECT 1 FROM nurture_enrollments ne WHERE ne.sequence_id = $1 AND ne.contact_id = c.id)\nON CONFLICT (sequence_id, contact_id) DO NOTHING;",
        "options": {
          "queryReplacement": "={{ [ $json.id, $json.trigger_inactive_days ] }}"
        }
      },
      "id": "tt1h0012-1212-4a5a-9b1a-nurtest0000012",
      "name": "Auto-Enroll Eligible Contacts (Force)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2080,
        704
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      },
      "notes": "Same eligibility rule as the hourly engine \u2014 this only pulls in contacts already inactive long enough. It does not lower or skip the inactivity trigger itself, only the per-step day delays between emails."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ne.id AS enrollment_id, ne.sequence_id, ne.contact_id, ne.current_step, ne.enrolled_at, ne.last_step_sent_at,\n  ns.exit_on_reply, ns.exit_lead_status,\n  c.email, c.first_name, c.last_name, c.email_logs,\n  (SELECT COUNT(*) FROM nurture_sequence_steps WHERE sequence_id = ns.id) AS total_steps\nFROM nurture_enrollments ne\nJOIN nurture_sequences ns ON ns.id = ne.sequence_id\nJOIN contacts c ON c.id = ne.contact_id AND c.is_archived = false\nWHERE ne.status = 'active' AND ne.sequence_id = $1;",
        "options": {
          "queryReplacement": "={{ [ $('Validate Admin (Force)').item.json.sequenceId ] }}"
        }
      },
      "id": "tt1h0013-1313-4a5a-9b1a-nurtest0000013",
      "name": "Select Active Enrollments (Force)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
