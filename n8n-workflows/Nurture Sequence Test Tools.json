    {
      "parameters": {
        "jsCode": "// Same reply-check as the hourly engine \u2014 a force run still respects\n// \"stop on reply,\" it only skips the day-delay wait between sends.\nconst row = $input.item.json;\nconst emailLogs = row.email_logs || [];\nconst referenceTime = new Date(row.last_step_sent_at || row.enrolled_at).getTime();\n\nconst replied = emailLogs.some(\n  (log) => log && log.type === 'received' && new Date(log.sent_at).getTime() > referenceTime\n);\n\nif (replied && row.exit_on_reply) {\n  return [{ json: { ...row, action: 'exit_reply' } }];\n}\n\nconst nextStep = row.current_step + 1;\nif (nextStep > row.total_steps) {\n  return [{ json: { ...row, action: 'complete' } }];\n}\n\nreturn [{ json: { ...row, action: 'send', nextStep } }];"
      },
      "id": "tt1h0016-1616-4a5a-9b1a-nurtest0000016",
      "name": "Check Reply & Determine Action (Force)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2528,
        800
      ]
    },
    {
      "parameters": {
