        "jsCode": "const headers = $input.first().json.headers || {};\nconst authHeader = headers['authorization'] || headers['Authorization'] || '';\nconst token = authHeader.replace('Bearer ', '').trim();\nconst match = token.match(/^token_(\\d+)_(\\d+)$/);\nif (!match) throw new Error('Invalid or missing session token.');\n\nconst body = $input.first().json.body || {};\nconst sequenceId = parseInt(body.sequence_id, 10);\nif (!Number.isInteger(sequenceId)) throw new Error('\"sequence_id\" must be an integer.');\n\nreturn [{ json: { requesterId: parseInt(match[1], 10), sequenceId } }];"
