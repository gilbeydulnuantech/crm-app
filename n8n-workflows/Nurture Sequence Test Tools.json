    {
      "parameters": {
        "jsCode": "// No due-date check here on purpose \u2014 this is the whole point of \"force\n// run,\" skip the day-delay wait and send whatever step is next right now.\nconst step = $input.item.json;\nconst enrollment = $('Check Reply & Determine Action (Force)').item.json;\n\nfunction fill(template) {\n  return (template || '')\n    .replace(/{{\\s*first_name\\s*}}/gi, enrollment.first_name || 'there')\n    .replace(/{{\\s*last_name\\s*}}/gi, enrollment.last_name || '');\n}\n\nreturn [{\n  json: {\n    enrollmentId: enrollment.enrollment_id,\n    nextStep: enrollment.nextStep,\n    to: enrollment.email,\n    subject: fill(step.email_subject),\n    body: fill(step.email_body),\n  },\n}];"
      },
