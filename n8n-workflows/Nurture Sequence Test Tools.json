        "query": "SELECT nss.delay_days, et.subject AS email_subject, et.body AS email_body\nFROM nurture_sequence_steps nss\nJOIN email_templates et ON et.id = nss.email_template_id\nWHERE nss.sequence_id = $1 AND nss.step_number = $2;",
        "options": {
