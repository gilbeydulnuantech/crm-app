    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH due AS (\n  SELECT o.id AS opportunity_id, o.name AS deal_name, c.id AS contact_id, c.first_name, c.email, c.unsubscribe_token\n  FROM opportunities o\n  JOIN contacts c ON c.id = o.contact_id\n  WHERE o.status = 'Won' AND o.is_archived = false\n    AND o.maintenance_interval_months IS NOT NULL\n    AND c.is_archived = false AND c.do_not_contact = false AND c.dnc_email = false\n    AND c.email IS NOT NULL AND c.email <> ''\n    AND COALESCE(o.last_maintenance_followup_at, o.closed_at) <= now() - (o.maintenance_interval_months || ' months')::interval\n)\nSELECT d.* FROM (SELECT 1) AS dummy(x) LEFT JOIN due d ON true;",
        "options": {}
      },
      "id": "pme-select-due",
      "name": "Select Deals Due For Maintenance Followup",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        100
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT company_name FROM company_profile LIMIT 1;",
        "options": {}
      },
      "id": "pme-get-company-name",
      "name": "Get Company Name",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        100
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "function toTitleCase(s) { return (s || '').toString().toLowerCase().split(' ').map((w) => (w ? w[0].toUpperCase() + w.slice(1) : w)).join(' '); }\nfunction safeEnv(key) { try { return $env[key] || ''; } catch (e) { return ''; } }\n\nconst row = $('Select Deals Due For Maintenance Followup').item.json;\nconst companyName = $input.item.json.company_name || 'Us';\nconst firstName = toTitleCase(row.first_name) || 'there';\nconst dealName = row.deal_name || 'your recent job';\nconst unsubUrl = safeEnv('FRONTEND_BASE_URL') + '/unsubscribe/' + row.unsubscribe_token;\n\nconst subject = `Time for a check-up on your ${dealName}?`;\nconst body = `Hi ${firstName},<br><br>` +\n  `It's been a while since we completed \"${dealName}\" for you \u2014 we recommend a quick maintenance check to keep everything in great shape.<br><br>` +\n  `Reply to this email or give us a call to schedule a visit.<br><br>` +\n  `Thanks,<br>${companyName} Team` +\n  `<br><br><span style=\"font-size:11px;color:#94a3b8\">Don't want these emails? <a href=\"${unsubUrl}\">Unsubscribe</a></span>`;\n\nreturn [{ json: { to: row.email, subject, htmlBody: body, opportunityId: row.opportunity_id, contactId: row.contact_id } }];"
      },
      "id": "pme-fill-email",
      "name": "Fill Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "onError": "continueRegularOutput"
    },
