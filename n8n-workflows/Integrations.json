    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nconst body = $('Webhook - Save Integration').first().json.body || {};\n\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nif (requester.role !== 'admin') throw new Error('Admin access required.');\n\nconst provider = (body.provider || '').toString().trim().toLowerCase();\nif (!['vapi', 'retell'].includes(provider)) throw new Error('\"provider\" must be \"vapi\" or \"retell\".');\n\nconst label = (body.label || '').toString().trim() || null;\nconst apiKey = (body.api_key || '').toString().trim() || null;\nconst config = body.config && typeof body.config === 'object' ? JSON.stringify(body.config) : '{}';\nconst requesterId = requester.id;\n\nreturn [{ json: { provider, label, apiKey, config, requesterId } }];"
      },
      "id": "ia1b0010-1010-4a5a-9b1a-intgrt0000010",
      "name": "Validate Admin & Payload (Save)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1632,
        704
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO integrations (provider, label, api_key_encrypted, config, is_active, created_by, created_at, updated_at)\nVALUES ($1, $2, CASE WHEN $3::text IS NOT NULL THEN pgp_sym_encrypt($3, $5) ELSE NULL END, $4::jsonb, true, $6, now(), now())\nON CONFLICT (provider) DO UPDATE SET\n  label = EXCLUDED.label,\n  api_key_encrypted = COALESCE(EXCLUDED.api_key_encrypted, integrations.api_key_encrypted),\n  config = EXCLUDED.config,\n  is_active = true,\n  updated_at = now()\nRETURNING id, provider, label, is_active;",
        "options": {
          "queryReplacement": "={{ [ $json.provider, $json.label, $json.apiKey, $json.config, $env.INTEGRATIONS_ENCRYPTION_KEY, $json.requesterId ] }}"
        }
      },
      "id": "ia1b0011-1111-4a5a-9b1a-intgrt0000011",
      "name": "Upsert Integration",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1856,
        704
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      },
      "notes": "Requires the INTEGRATIONS_ENCRYPTION_KEY environment variable to be set on this n8n instance, and the pgcrypto extension enabled on the database. Leaving api_key blank on an edit keeps the existing stored key (only label/config change)."
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first();\nif (!result || !result.json || !result.json.id) throw new Error('Failed to save integration.');\nreturn [{ json: { success: true, integration: result.json } }];"
      },
