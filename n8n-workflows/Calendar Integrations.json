    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, role, active FROM users WHERE id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $json.requesterId ] }}"
        }
      },
      "id": "cb1a0009-9999-4a5a-9b1a-calint0000009",
      "name": "Look Up Requester Role (Add)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1408,
        704
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nconst body = $('Webhook - Add Calendar Integration').first().json.body || {};\n\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\nif (requester.role !== 'admin') throw new Error('Admin access required.');\n\nconst rawLink = (body.calendar_link || '').toString().trim();\nif (!rawLink) throw new Error('\"calendar_link\" is required.');\n\n// calendar.app.google/xxx links are Appointment Schedule *booking pages* \u2014\n// opaque short links Google resolves server-side, not calendar IDs. The\n// Calendar API can't read events off them directly. Bookings made through\n// one of these land on the rep's own regular calendar instead, so that's\n// what we actually need here.\nif (/calendar\\.app\\.google/i.test(rawLink)) {\n  throw new Error(\n    'That looks like a booking-page link (calendar.app.google/...), not a calendar ID. ' +\n    'Paste the rep\\'s calendar ID instead \u2014 usually their Gmail address, or \"primary\" for their default calendar. ' +\n    'Find it in Google Calendar under Settings > [calendar name] > \"Integrate calendar\" > Calendar ID. ' +\n    'That calendar must also be shared with the Google account this integration is authorized as.'\n  );\n}\n\n// Accepts either a raw calendar ID/email (xxx@group.calendar.google.com),\n// or a full \"Share this calendar\" / embed URL like\n// https://calendar.google.com/calendar/embed?src=xxx%40group.calendar.google.com&ctz=...\n// \u2014 extracts the src= param when present, otherwise uses the pasted value\n// as-is so a plain calendar ID (or \"primary\") also works.\nlet calendarId = rawLink;\ntry {\n  const url = new URL(rawLink);\n  const src = url.searchParams.get('src');\n  if (src) calendarId = src;\n} catch {\n  // Not a URL \u2014 treat the whole pasted value as the calendar ID.\n}\n\nconst ownerUserId = parseInt(body.owner_user_id, 10);\nif (!Number.isInteger(ownerUserId)) throw new Error('\"owner_user_id\" must be an integer.');\n\nconst label = (body.label || '').toString().trim() || null;\n\nreturn [{ json: { label, calendarLink: rawLink, calendarId, ownerUserId, requesterId: requester.id } }];"
      },
      "id": "cb1a0010-1010-4a5a-9b1a-calint0000010",
      "name": "Validate Admin & Parse Link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1632,
        704
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO calendar_integrations (label, calendar_link, calendar_id, owner_user_id, is_active, created_by, created_at, updated_at) VALUES ($1, $2, $3, $4, true, $5, now(), now()) RETURNING id, label, calendar_link, calendar_id, owner_user_id, is_active, created_at;",
        "options": {
          "queryReplacement": "={{ [ $json.label, $json.calendarLink, $json.calendarId, $json.ownerUserId, $json.requesterId ] }}"
        }
      },
      "id": "cb1a0011-1111-4a5a-9b1a-calint0000011",
