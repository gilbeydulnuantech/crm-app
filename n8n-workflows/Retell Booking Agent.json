    {
      "parameters": {
        "jsCode": "// Returns every open business-hour slot for the requested date,\n// split into morning (<12:00) and afternoon (>=12:00) \u2014 this is what\n// the voice-agent prompt's check_availability(date) step actually\n// needs: a same-day list it can reason about before asking the\n// caller 'morning or afternoon', not just a single-slot check.\nconst cfg = $('Workflow Configuration').first().json;\nconst duration = Number(cfg.durationMinutes) || 60;\n\n// Safety net: the agent should resolve relative dates itself (see the\n// prompt), but voice LLMs sometimes pass the literal word through \u2014\n// handle the common cases server-side rather than erroring on a caller\n// who just said \"tomorrow\".\nconst rawDate = (cfg.date || '').trim().toLowerCase();\nlet day;\nif (rawDate === 'today') {\n  day = DateTime.now().setZone('Asia/Almaty');\n} else if (rawDate === 'tomorrow') {\n  day = DateTime.now().setZone('Asia/Almaty').plus({ days: 1 });\n} else {\n  day = DateTime.fromISO(cfg.date, { zone: 'Asia/Almaty' });\n}\nif (!day.isValid) {\n  throw new Error(`Invalid date: \"${cfg.date}\" \u2014 expected YYYY-MM-DD, \"today\", or \"tomorrow\".`);\n}\n\nconst busy = $input.all().map((i) => ({\n  start: DateTime.fromISO(i.json.start?.dateTime || i.json.start?.date),\n  end: DateTime.fromISO(i.json.end?.dateTime || i.json.end?.date),\n}));\n\nfunction overlaps(start, end) {\n  return busy.some((b) => start < b.end && end > b.start);\n}\n\nconst slots = [];\nlet cursor = day.set({ hour: 9, minute: 0, second: 0 });\nconst dayEnd = day.set({ hour: 17, minute: 0, second: 0 });\nconst isWeekday = day.weekday <= 5;\n\nif (isWeekday) {\n  while (cursor.plus({ minutes: duration }) <= dayEnd) {\n    const slotEnd = cursor.plus({ minutes: duration });\n    if (!overlaps(cursor, slotEnd)) {\n      slots.push({ start: cursor.toISO(), end: slotEnd.toISO(), period: cursor.hour < 12 ? 'morning' : 'afternoon' });\n    }\n    cursor = cursor.plus({ hours: 1 });\n  }\n}\n\nconst morning = slots.filter((s) => s.period === 'morning');\nconst afternoon = slots.filter((s) => s.period === 'afternoon');\n\nreturn [{ json: {\n  date: cfg.date,\n  is_weekday: isWeekday,\n  has_morning: morning.length > 0,\n  has_afternoon: afternoon.length > 0,\n  morning_slots: morning.slice(0, 3),\n  afternoon_slots: afternoon.slice(0, 3),\n} }];"
      },
      "id": "list-open-slots-for-day",
      "name": "List Open Slots For Day",
