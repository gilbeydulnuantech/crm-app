    {
      "parameters": {
        "jsCode": "// Google Calendar's timeMin/timeMax on getAll is not a reliable\n// server-side filter in practice \u2014 it can return events outside\n// the requested window (confirmed: a query for Oct 2 1-2pm\n// returned an Oct 1 event and a 2:30pm event, neither of which\n// overlaps). Compute real overlap here instead of trusting\n// $input.all().length.\nconst cfg = $('Workflow Configuration').first().json;\nconst start = DateTime.fromISO(cfg.requestedStart);\nconst end = DateTime.fromISO(cfg.requestedEnd);\nconst conflicts = $input.all().filter((i) => {\n  const bStart = DateTime.fromISO(i.json.start?.dateTime || i.json.start?.date);\n  const bEnd = DateTime.fromISO(i.json.end?.dateTime || i.json.end?.date);\n  return start < bEnd && end > bStart;\n});\nreturn [{ json: { conflictCount: conflicts.length } }];"
      },
