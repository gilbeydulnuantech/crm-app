      "id": "get-day-availability",
      "name": "Get Day Availability",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        896,
        352
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "GHh5WnpZKV3DPZJd",
          "name": "n8n072826"
        }
