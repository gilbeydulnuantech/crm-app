      "parameters": {
        "jsCode": "// Same slot-finding logic as Find 3 Closest Available Times, reused\n// here for the reschedule flow's alternative-times branch.\nconst cfg = $('Workflow Configuration1').first().json;\nconst _requestedStart = DateTime.fromISO(cfg.requestedStart);\nif (!_requestedStart.isValid) {\n  throw new Error(`Invalid requestedStart: \"${cfg.requestedStart}\" \u2014 check that start_time was sent in the request.`);\n}\nconst duration = Number(cfg.durationMinutes) || 60;\nconst busy = $input.all().map((i) => ({\n  start: DateTime.fromISO(i.json.start?.dateTime || i.json.start?.date),\n  end: DateTime.fromISO(i.json.end?.dateTime || i.json.end?.date),\n}));\n\nfunction overlaps(start, end) {\n  return busy.some((b) => start < b.end && end > b.start);\n}\n\nconst found = [];\nlet cursor = DateTime.fromISO(cfg.requestedStart).plus({ hours: 1 }).set({ minute: 0, second: 0 });\nlet guard = 0;\nwhile (found.length < 3 && guard < 500) {\n  guard++;\n  const hour = cursor.hour;\n  const isWeekday = cursor.weekday <= 5;\n  if (isWeekday && hour >= 9 && hour < 17) {\n    const slotEnd = cursor.plus({ minutes: duration });\n    if (!overlaps(cursor, slotEnd)) {\n      found.push({ start: cursor.toISO(), end: slotEnd.toISO() });\n      cursor = cursor.plus({ hours: 1 });\n      continue;\n    }\n  }\n  cursor = hour >= 17 || !isWeekday\n    ? cursor.plus({ days: 1 }).set({ hour: 9, minute: 0 })\n    : cursor.plus({ hours: 1 });\n}\n\nreturn [{ json: { alternatives: found } }];"
      },
