    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst grouped = { contacts: [], deals: [], companies: [], totalMatches: 0 };\n\nfor (const item of items) {\n  const row = item.json;\n  if (!row || !row.id) continue; // Skip empty results from alwaysOutputData\n\n  const resultItem = {\n    id: row.id,\n    title: row.title || 'No Name',\n    subtitle: row.subtitle || '',\n    tag: row.tag || '',\n    company: row.company || ''\n  };\n\n  const entityType = row.entity_type || 'contact';\n  if (entityType === 'contact') grouped.contacts.push(resultItem);\n  grouped.totalMatches++;\n}\n\nreturn [{ json: grouped }];"
      },
