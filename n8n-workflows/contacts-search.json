    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nconst { rawSearch } = $('Validate Session Query').first().json;\n\nif (!requester.id || !requester.active) throw new Error('Invalid session or user not found.');\n\nconst searchPattern = `%${rawSearch}%`;\n\nconst sqlQuery = `\n  -- 1. SEARCH CONTACTS (Added lead_status and lead_source to WHERE)\n  SELECT DISTINCT\n    'contact' AS entity_type,\n    c.id,\n    TRIM(CONCAT(c.first_name, ' ', c.last_name)) AS title,\n    c.email AS subtitle,\n    c.lead_status AS tag,\n    co.name AS company\n  FROM contacts c\n  LEFT JOIN companies co ON co.id = c.account_id\n  LEFT JOIN taggables tg ON (tg.entity_id = c.id AND tg.entity_type = 'contact')\n  LEFT JOIN tags t ON t.id = tg.tag_id\n  WHERE ($2 = 'admin' OR c.owner_id = $1)\n    AND c.is_archived = false\n    AND (\n      c.first_name ILIKE $3 OR c.last_name ILIKE $3 OR c.email ILIKE $3 \n      OR c.phone ILIKE $3 OR c.job_title ILIKE $3 OR c.city ILIKE $3 \n      OR c.state ILIKE $3 OR c.country ILIKE $3 OR t.name ILIKE $3\n      OR c.lead_status ILIKE $3   -- Added this\n      OR c.lead_source ILIKE $3   -- Added this\n    )\n\n  UNION ALL\n\n  -- 2. SEARCH COMPANIES\n  SELECT DISTINCT\n    'company' AS entity_type,\n    cp.id,\n    cp.name AS title,\n    cp.industry AS subtitle,\n    cp.city AS tag,\n    cp.website AS company\n  FROM companies cp\n  LEFT JOIN taggables tg ON (tg.entity_id = cp.id AND tg.entity_type = 'company')\n  LEFT JOIN tags t ON t.id = tg.tag_id\n  WHERE ($2 = 'admin' OR cp.owner_id = $1)\n    AND cp.is_archived = false\n    AND (\n      cp.name ILIKE $3 OR cp.industry ILIKE $3 OR cp.website ILIKE $3 \n      OR cp.phone ILIKE $3 OR cp.city ILIKE $3 OR cp.state ILIKE $3 \n      OR cp.country ILIKE $3 OR t.name ILIKE $3\n    )\n\n  UNION ALL\n\n  -- 3. SEARCH OPPORTUNITIES (DEALS)\n  SELECT DISTINCT\n    'deal' AS entity_type,\n    o.id,\n    o.name AS title,\n    CAST(o.deal_value AS TEXT) AS subtitle,\n    o.status AS tag,\n    '' AS company\n  FROM opportunities o\n  WHERE ($2 = 'admin' OR o.assigned_user = $1)\n    AND (o.name ILIKE $3 OR o.status ILIKE $3)\n\n  LIMIT 40;\n`;\n\nconst queryParams = [requester.id, requester.role, searchPattern];\n\nreturn [{ json: { sqlQuery, queryParams } }];"
      },
