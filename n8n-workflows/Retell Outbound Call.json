      "notes": "Requires INTEGRATIONS_ENCRYPTION_KEY set as an n8n environment variable \u2014 same value used by Integrations.json when the key was saved."
    },
    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\n\nconst contact = $('Look Up Contact').first().json;\nif (!contact || !contact.phone) throw new Error('This contact has no phone number on file.');\n\nconst integration = $input.first().json;\nif (!integration.api_key) throw new Error('Retell is not connected \u2014 add an API key in Settings \\u2192 Integrations.');\n\nconst config = integration.config || {};\nif (!config.from_number) {\n  throw new Error('Retell is connected but missing the From Number \\u2014 fill it in under Settings \\u2192 Integrations.');\n}\n\nconst body = { from_number: config.from_number, to_number: contact.phone };\nif (config.agent_id) body.override_agent_id = config.agent_id;\n\nreturn [{ json: { apiKey: integration.api_key, bodyJson: JSON.stringify(body) } }];"
      },
      "id": "rt1b0006-6666-4a5a-9b1a-retellcall00006",
