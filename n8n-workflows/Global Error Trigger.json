    {
      "parameters": {
        "jsCode": "// Keeps expected noise out of Slack/email; every other failure still alerts.\n// 1) \"Invalid session\": a browser tab with an old login hitting a protected endpoint (the CRM rejected it correctly).\n// 2) Brief internet drops on scheduled/polling triggers (Google Calendar, email reply, crypto signal...): the next poll recovers by itself.\nconst j = $input.first().json;\nconst msg = String((j.execution && j.execution.error && j.execution.error.message) || '').trim();\nconst mode = (j.execution && j.execution.mode) || '';\nconst net = /connection cannot be established|connection was aborted|server is offline|ECONNABORTED|ECONNREFUSED|ECONNRESET|ENOTFOUND|ETIMEDOUT|EAI_AGAIN|socket hang up|getaddrinfo|network/i.test(msg);\nconst invalidSession = /^Invalid session/i.test(msg);\nconst triggerBlip = mode === 'trigger' && (net || msg === '');\nif (invalidSession || triggerBlip) return [];\nreturn $input.all();\n"
      },
