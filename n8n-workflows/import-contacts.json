    {
      "parameters": {
        "jsCode": "const headers = $input.first().json.headers || {};\nconst authHeader = headers['authorization'] || headers['Authorization'] || '';\nconst token = authHeader.replace('Bearer ', '').trim();\n\nconst match = token.match(/^token_(\\d+)_(\\d+)$/);\nif (!match) {\n  throw new Error('Invalid or missing session token.');\n}\n\nconst requesterId = parseInt(match[1], 10);\nconst body = $input.first().json.body || {};\nconst contacts = Array.isArray(body.contacts) ? body.contacts : [];\n\nif (contacts.length === 0) {\n  throw new Error('No contacts provided to import.');\n}\nif (contacts.length > 500) {\n  throw new Error('Cannot import more than 500 contacts at once.');\n}\n\nconst cleaned = contacts.map((c) => {\n  const firstName = (c.first_name || '').toString().trim();\n  if (!firstName) return null;\n  return {\n    first_name: firstName,\n    last_name: (c.last_name || '').toString().trim(),\n    email: (c.email || '').toString().trim(),\n    phone: (c.phone || '').toString().trim(),\n    city: (c.city || '').toString().trim(),\n    country: (c.country || '').toString().trim(),\n    lead_status: (c.lead_status || 'New').toString().trim()\n  };\n}).filter(Boolean);\n\nif (cleaned.length === 0) {\n  throw new Error('No valid rows (missing first_name) found.');\n}\n\nreturn [{ json: { requesterId, contacts: cleaned } }];"
      },
