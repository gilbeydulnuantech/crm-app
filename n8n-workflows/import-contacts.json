    {
      "parameters": {
        "jsCode": "const requester = $input.first().json;\nconst { contacts } = $('Validate Token & Rows').first().json;\n\nif (!requester.id || !requester.active) {\n  throw new Error('Invalid session.');\n}\n\nconst valuesSql = [];\nconst queryParams = [];\nlet paramIndex = 1;\n\nfor (const c of contacts) {\n  valuesSql.push(`($${paramIndex}, $${paramIndex+1}, $${paramIndex+2}, $${paramIndex+3}, $${paramIndex+4}, $${paramIndex+5}, $${paramIndex+6}, $${paramIndex+7}, NOW(), NOW())`);\n  queryParams.push(\n    c.first_name, c.last_name, c.email,\n    c.phone, c.city, c.country, c.lead_status, requester.id\n  );\n  paramIndex += 8;\n}\n\nconst sqlQuery = `\n  INSERT INTO contacts (first_name, last_name, email, phone, city, country, lead_status, owner_id, created_at, updated_at)\n  VALUES ${valuesSql.join(', ')}\n  RETURNING id;\n`;\n\nreturn [{ json: { sqlQuery, queryParams } }];"
      },
