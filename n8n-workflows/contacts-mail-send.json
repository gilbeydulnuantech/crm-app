    {
      "parameters": {
        "jsCode": "// Fetch the aggregated items list\nconst items = $input.all();\nconst attachmentList = [];\n\nitems.forEach(item => {\n    // Access item JSON data aggregated from the Google Drive node\n    const data = item.json;\n\n    // Handle whether Aggregate outputted an array or individual item objects\n    const fileArray = Array.isArray(data) ? data : (data.data || [data]);\n\n    fileArray.forEach(file => {\n        // Skip execution metadata or items without a webViewLink\n        if (!file || !file.webViewLink) return;\n\n        const fileName = file.name || file.fileName || 'Attachment';\n        const fileUrl = file.webViewLink;\n\n        attachmentList.push({\n            name: fileName,\n            url: fileUrl\n        });\n    });\n});\n\n// Return as a formatted JSON string for Postgres $3 parameter\nreturn [{\n    json: {\n        attachments_json: JSON.stringify(attachmentList)\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3104,
        1216
      ],
      "id": "b90c3f89-e596-460c-8115-81678f60df11",
      "name": "build attachment json"
    },
    {
      "parameters": {
        "jsCode": "// Access the binary data generated in the 'format base64' node\nconst base64NodeItem = $('format base64').first();\nconst binaryObject = base64NodeItem.binary || {};\nconst binaryKeys = Object.keys(binaryObject);\n\n// If no attachments were passed, forward a single clean JSON item\nif (binaryKeys.length === 0) {\n    return [{\n        json: { ...$input.first().json, has_attachments: false }\n    }];\n}\n\n// Split each binary key into its own n8n item for Google Drive upload\nconst outputItems = binaryKeys.map(key => {\n    return {\n        json: {\n            ...$input.first().json,\n            target_binary_key: key,\n            has_attachments: true\n        },\n        binary: {\n            // Standardize the binary key to 'data' for the Google Drive node\n            data: binaryObject[key]\n        }\n    };\n});\n\nreturn outputItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2672,
        1264
      ],
      "id": "5b8bd27a-c5bb-4bf9-895d-dbe499e556d1",
      "name": "separate binary items"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst attachments = body.attachments || [];\n\nconst binaryData = {};\n\nif (Array.isArray(attachments) && attachments.length > 0) {\n    attachments.forEach((att, index) => {\n        // Frontend sends { name, url } where url is a data: URL\n        // (e.g. 'data:application/pdf;base64,JVBERi0...') from FileReader.\n        const match = /^data:([^;,]+)?(?:;[^,]*)?,(.*)$/s.exec(att.url || '');\n        if (!match) return;\n        const [, mimeType, base64] = match;\n\n        // Use 'data' for the first item if there's only 1, or attachment_0, attachment_1\n        const key = attachments.length === 1 ? 'data' : `attachment_${index}`;\n\n        binaryData[key] = {\n            data: base64,\n            mimeType: mimeType || 'application/octet-stream',\n            fileName: att.name || `attachment_${index}`\n        };\n    });\n}\n\nreturn [\n    {\n        json: body,\n        binary: binaryData\n    }\n];"
      },
