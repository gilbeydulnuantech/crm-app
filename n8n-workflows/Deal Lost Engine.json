        460
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id FROM conversations WHERE type = 'dm' AND dm_key = $1;",
        "options": {
          "queryReplacement": "={{ [ $('Build DM Key').item.json.dmKey ] }}"
