    {
      "id": "dl-dmtext",
      "name": "Prepare DM Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        460
      ],
      "parameters": {
        "jsCode": "const row = $('Select Newly Lost Deals').item.json;\nconst name = row.deal_name || [row.first_name, row.last_name].filter(Boolean).join(' ') || 'A deal';\nreturn [{ json: { text: '\u274c Deal LOST: ' + name + ' - reason: ' + (row.lost_reason || 'not specified') } }];"
      }
    },
    {
      "id": "dl-dmmsg",
      "name": "Insert DM Message",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1740,
        460
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO messages (conversation_id, sender_id, body) SELECT $1, $2, $3 WHERE EXISTS (SELECT 1 FROM users WHERE id = $4 AND COALESCE((notification_preferences->>'automation_dms')::boolean, true) = true);",
        "options": {
          "queryReplacement": "={{ [ $('Get DM Id').item.json.id, $('Build DM Key').item.json.notifierUserId, $json.text, $('Build DM Key').item.json.ownerId ] }}"
        }
      },
      "credentials": {
