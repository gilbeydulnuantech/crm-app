    {
      "id": "dl-select",
      "name": "Select Newly Lost Deals",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        420,
        220
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT o.id AS opportunity_id, o.name AS deal_name, o.assigned_user, o.lost_reason, c.id AS contact_id, c.first_name, c.last_name, c.email FROM opportunities o JOIN contacts c ON c.id = o.contact_id LEFT JOIN deal_lost_actions dla ON dla.opportunity_id = o.id WHERE o.stage_id = 33 AND o.is_archived = false AND dla.id IS NULL;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "id": "dl-set-status",
      "name": "Set Lead Status: Unqualified",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        640,
        140
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE contacts SET lead_status = 'Unqualified', updated_at = now() WHERE id = $1;",
        "options": {
          "queryReplacement": "={{ [ $json.contact_id ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "id": "dl-dmkey",
      "name": "Build DM Key",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        460
      ],
      "parameters": {
        "jsCode": "const NOTIFIER_USER_ID = 1;\nconst ownerId = $input.item.json.assigned_user;\nconst dmKey = [NOTIFIER_USER_ID, ownerId].sort((a, b) => a - b).join('-');\nreturn [{ json: { notifierUserId: NOTIFIER_USER_ID, ownerId, dmKey } }];"
      }
    },
    {
      "id": "dl-dmcreate",
      "name": "Create DM If Missing",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        860,
        460
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO conversations (type, dm_key, created_by) VALUES ('dm', $1, $2) ON CONFLICT (dm_key) WHERE type = 'dm' DO NOTHING;",
        "options": {
          "queryReplacement": "={{ [ $json.dmKey, $json.notifierUserId ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "id": "dl-dmgetid",
