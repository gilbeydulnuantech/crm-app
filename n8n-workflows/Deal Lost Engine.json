    {
      "id": "dl-select-winback",
      "name": "Select Due Win-Backs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        420,
        700
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT dla.id AS lost_action_id, c.id AS contact_id, c.first_name, c.last_name, c.email, c.phone, c.dnc_sms, c.unsubscribe_token FROM deal_lost_actions dla JOIN contacts c ON c.id = dla.contact_id WHERE dla.processed_at <= now() - interval '6 months' AND dla.winback_sent_at IS NULL AND c.is_archived = false AND c.email IS NOT NULL AND c.email <> '' AND NOT EXISTS (SELECT 1 FROM taggables tg JOIN tags t ON t.id = tg.tag_id WHERE tg.entity_type = 'contact' AND tg.entity_id = c.id AND t.name = 'Customer');",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      }
    },
    {
      "id": "dl-lookup-tmpl",
      "name": "Look Up Template: Win-Back",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        640,
        700
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT subject, body FROM email_templates WHERE id = 21;",
        "options": {}
