    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.id, p.name, p.slug, p.description_html, p.sku, p.category, p.unit, p.unit_price::float AS unit_price, p.tax_rate::float AS tax_rate, p.is_active, p.created_by, u.name AS created_by_name, p.created_at, p.updated_at,\n  p.bookable_online, p.durations, p.event_type_id, et.key AS event_type_key, et.name AS event_type_name, et.color AS event_type_color\nFROM products p\nLEFT JOIN users u ON u.id = p.created_by\nLEFT JOIN event_types et ON et.id = p.event_type_id\nORDER BY p.name ASC;",
        "options": {}
      },
