    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.created_by\nFROM (SELECT $1::int AS pid) dummy\nLEFT JOIN products p ON p.id = dummy.pid;",
        "options": {
          "queryReplacement": "={{ [ $('Webhook - Save Product').first().json.body.id || null ] }}"
        }
      },
      "id": "e712b667-1673-4994-9483-f4cce24e835d",
      "name": "Look Up Existing Product (Save)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1632,
        624
      ],
      "credentials": {
        "postgres": {
          "id": "OJlr1rmibAS2w3rj",
          "name": "myRag"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const existing = $input.item.json;\nconst requester = $('Validate Session (Save)').first().json;\nconst body = $('Webhook - Save Product').first().json.body || {};\n\nif (!requester.id || !requester.active) throw new Error('Invalid session.');\n\nconst id = body.id ? parseInt(body.id, 10) : null;\nif (body.id && !Number.isInteger(id)) throw new Error('\"id\" must be an integer.');\nif (id && existing.created_by != null && requester.role !== 'admin' && existing.created_by !== requester.id) {\n  throw new Error('Only an admin or the product\\'s creator can edit it.');\n}\n\nconst clean = (v, max) => (v == null ? '' : String(v)).trim().slice(0, max);\nconst name = clean(body.name, 200);\nif (!name) throw new Error('Give this product a name.');\nconst descriptionHtml = body.description_html == null ? '' : String(body.description_html).slice(0, 20000);\nconst sku = clean(body.sku, 80) || null;\nconst category = clean(body.category, 80) || null;\nconst unit = clean(body.unit, 30) || 'each';\n\nconst unitPrice = body.unit_price === '' || body.unit_price == null ? 0 : Number(body.unit_price);\nif (!Number.isFinite(unitPrice) || unitPrice < 0 || unitPrice > 100000000) throw new Error('Price must be a number between 0 and 100,000,000.');\nconst taxRate = body.tax_rate === '' || body.tax_rate == null ? 0 : Number(body.tax_rate);\nif (!Number.isFinite(taxRate) || taxRate < 0 || taxRate > 100) throw new Error('Tax rate must be between 0 and 100.');\nconst isActive = body.is_active === false || body.is_active === 'false' ? false : true;\n\n// Event type (calendar): absent = leave the product's type as it is; null/'' = clear it.\nconst hasEventType = Object.prototype.hasOwnProperty.call(body, 'event_type_id');\nlet eventTypeId = null;\nif (hasEventType && body.event_type_id !== null && body.event_type_id !== '') {\n  eventTypeId = parseInt(body.event_type_id, 10);\n  if (!Number.isInteger(eventTypeId) || eventTypeId < 1) throw new Error('\"event_type_id\" must be an integer.');\n}\n\n// Lengths a client can choose online, each with its own price: absent = leave as is; [] = single-length service.\nlet durations = null;\nif (Array.isArray(body.durations)) {\n  const seen = new Set();\n  durations = body.durations.map((d) => {\n    const minutes = parseInt(d && d.minutes, 10);\n    const price = Number(d && d.price);\n    if (!Number.isInteger(minutes) || minutes < 10 || minutes > 480) throw new Error('A length must be between 10 and 480 minutes.');\n    if (!Number.isFinite(price) || price < 0 || price > 100000000) throw new Error('Each length needs a price of 0 or more.');\n    if (seen.has(minutes)) throw new Error('Each length can only be listed once.');\n    seen.add(minutes);\n    return { minutes, price: Math.round(price * 100) / 100 };\n  }).sort((a, b) => a.minutes - b.minutes);\n  if (durations.length > 8) throw new Error('Add at most 8 lengths.');\n}\n\nconst hasBookable = typeof body.bookable_online === 'boolean';\nconst bookableOnline = hasBookable ? body.bookable_online : null;\nreturn [{ json: { id, name, descriptionHtml, sku, category, unit, unitPrice: Math.round(unitPrice * 100) / 100, taxRate: Math.round(taxRate * 100) / 100, isActive, eventTypeId, hasEventType, bookableOnline, durations: durations === null ? null : JSON.stringify(durations), requesterId: requester.id } }];"
      },
      "id": "26f4dc0c-1216-43d2-ac37-df3816155ef5",
      "name": "Validate & Payload (Save)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1856,
        624
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH nid AS (SELECT COALESCE($1::int, nextval(pg_get_serial_sequence('products', 'id')))::int AS id)\nINSERT INTO products (id, name, description_html, slug, sku, category, unit, unit_price, tax_rate, is_active, created_by, created_at, updated_at, event_type_id, bookable_online, durations)\nSELECT nid.id, $2, $3,\n  -- the token slug is fixed at creation so renaming a product never breaks documents that already use it\n  product_slug($2) || CASE WHEN EXISTS (SELECT 1 FROM products x WHERE x.slug = product_slug($2)) THEN '_' || nid.id ELSE '' END,\n  $4, $5, $6, $7, $8, $9, $10, now(), now(), $11::int, COALESCE($13::boolean, true), COALESCE($14::jsonb, '[]'::jsonb)\nFROM nid\nON CONFLICT (id) DO UPDATE SET\n  name = EXCLUDED.name,\n  description_html = EXCLUDED.description_html,\n  sku = EXCLUDED.sku,\n  category = EXCLUDED.category,\n  unit = EXCLUDED.unit,\n  unit_price = EXCLUDED.unit_price,\n  tax_rate = EXCLUDED.tax_rate,\n  is_active = EXCLUDED.is_active,\n  event_type_id = CASE WHEN $12::boolean THEN EXCLUDED.event_type_id ELSE products.event_type_id END,\n  bookable_online = COALESCE($13::boolean, products.bookable_online),\n  durations = COALESCE($14::jsonb, products.durations),\n  updated_at = now()\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.id, $json.name, $json.descriptionHtml, $json.sku, $json.category, $json.unit, $json.unitPrice, $json.taxRate, $json.isActive, $json.requesterId, $json.eventTypeId, $json.hasEventType, $json.bookableOnline, $json.durations ] }}"
        }
      },
